<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>LogicFlow.VoiceAgent</RootNamespace>
    <AssemblyName>LogicFlow.VoiceAgent</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Description>LogicFlow Voice Agent — Real-time AI voice interface powered by Gemini Live API</Description>
    <Company>Delgado Creative Enterprises LLC d/b/a DelgadoLogic</Company>
    <Product>LogicFlow Voice Agent</Product>
    <Version>1.0.0-preview</Version>
    <Copyright>Copyright (c) 2026 Delgado Creative Enterprises LLC d/b/a DelgadoLogic. All rights reserved.</Copyright>
    <!--
      NOTE: This project contains NO API keys.
      All Gemini Live API access is proxied through api.delgadologic.tech
      which holds the real key in GCP Secret Manager.
    -->
  </PropertyGroup>

  <ItemGroup>
    <!-- Audio capture and playback -->
    <PackageReference Include="NAudio" Version="2.2.1" />
    <!-- HTTP client for sovereign server session gateway -->
    <PackageReference Include="Microsoft.Extensions.Http" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OmniCore.Engine\OmniCore.Engine.csproj" />
    <ProjectReference Include="..\LogicFlow.Guardian\LogicFlow.Guardian.csproj" />
    <ProjectReference Include="..\LogicFlow.Sentinel\LogicFlow.Sentinel.csproj" />
    <ProjectReference Include="..\DelgadoLogic.Core\DelgadoLogic.Core.csproj" />
  </ItemGroup>
</Project>
