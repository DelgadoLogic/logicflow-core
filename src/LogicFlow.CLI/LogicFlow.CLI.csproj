<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <AssemblyName>lf</AssemblyName>
    <RootNamespace>LogicFlow.CLI</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\LogicFlow.Dashboard\Assets\Icons\LogicFlow.ico</ApplicationIcon>
    <Description>LogicFlow Enterprise Command Line Interface</Description>
    <Company>Delgado Creative Enterprises LLC d/b/a DelgadoLogic</Company>
    <Product>LogicFlow</Product>
    <Version>1.0.0</Version>
    <Copyright>Copyright (c) 2026 Delgado Creative Enterprises LLC d/b/a DelgadoLogic. All rights reserved.</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.5" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DelgadoLogic.Core\DelgadoLogic.Core.csproj" />
    <ProjectReference Include="..\OmniCore.Engine\OmniCore.Engine.csproj" />
    <ProjectReference Include="..\OmniLicense\OmniLicense.csproj" />
    <ProjectReference Include="..\OmniPulse\OmniPulse.csproj" />
    <ProjectReference Include="..\LogicFlow.Registry\LogicFlow.Registry.csproj" />
    <ProjectReference Include="..\LogicFlow.Guardian\LogicFlow.Guardian.csproj" />
    <ProjectReference Include="..\LogicFlow.Native\LogicFlow.Native.csproj" />
    <ProjectReference Include="..\LogicFlow.Sentinel\LogicFlow.Sentinel.csproj" />
    <ProjectReference Include="..\LogicFlow.Lazarus\LogicFlow.Lazarus.csproj" />
    <ProjectReference Include="..\LogicFlow.Storage.Engine\LogicFlow.Storage.Engine.csproj" />
  </ItemGroup>
</Project>
