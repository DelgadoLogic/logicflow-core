                                <Button Content="🎨 Appearance" Tag="Appearance" Style="{StaticResource HeaderOutlineButton}" Height="28" Padding="12,0" Margin="0,2,6,2" Click="OnSettingsCategoryFilterClick"/>
                                <Button Content="⚙ General &amp; Tray" Tag="General" Style="{StaticResource HeaderOutlineButton}" Height="28" Padding="12,0" Margin="0,2,6,2" Click="OnSettingsCategoryFilterClick"/>
                                <Button Content="🛡 Scans &amp; Exclusions" Tag="Exclusions" Style="{StaticResource HeaderOutlineButton}" Height="28" Padding="12,0" Margin="0,2,6,2" Click="OnSettingsCategoryFilterClick"/>
                                <Button Content="✨ AI &amp; Voice" Tag="AI" Style="{StaticResource HeaderOutlineButton}" Height="28" Padding="12,0" Margin="0,2,6,2" Click="OnSettingsCategoryFilterClick"/>
                                <Button Content="🔒 Privacy &amp; Edition" Tag="Privacy" Style="{StaticResource HeaderOutlineButton}" Height="28" Padding="12,0" Margin="0,2,6,2" Click="OnSettingsCategoryFilterClick"/>
                                <Button Content="💾 Data &amp; Backup" Tag="Data" Style="{StaticResource HeaderOutlineButton}" Height="28" Padding="12,0" Margin="0,2,0,2" Click="OnSettingsCategoryFilterClick"/>
                            </WrapPanel>
                        </Border>

                        <!-- 0. Appearance, Theme & Accessibility Card -->
                        <Border x:Name="SettingsCardAppearance" Style="{StaticResource GlassPanel}" Margin="0,0,0,20">
                            <StackPanel>
                                <TextBlock Text="APPEARANCE, THEME &amp; ACCESSIBILITY" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6"/>
