                                </Border>
                                <ItemsControl x:Name="MemOptList" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Storage Armor & Deduplication Upgrade Banner -->
                        <Border Style="{StaticResource GlassPanel}" Margin="0,0,0,20">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <WrapPanel Margin="0,0,0,4">
                                        <TextBlock Text="🛡️ DEDUPLICATION &amp; STORAGE ARMOR" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="0,2,8,2"/>
                                        <Border Background="{DynamicResource BrandDarkCardBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="4" Padding="6,1" Margin="0,2,0,2" VerticalAlignment="Center">
                                            <TextBlock Text="UPGRADED" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrandCyanBrush}"/>
                                        </Border>
                                    </WrapPanel>
                                    <TextBlock Text="Duplicate file detection, drive space analysis, and transparent compression have moved to Storage Armor featuring FastCDC chunking, 256-bit BLAKE3 SIMD hashing, and Game Vault CompactOS." FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="🛡️ Launch Storage Armor" Style="{StaticResource ActionButton}" Click="OnNavHyperStore" VerticalAlignment="Center" Margin="16,0,0,0" ToolTip="Open HyperStore Storage Armor for advanced FastCDC deduplication, drive analysis, and .lfc compression"/>
                            </Grid>
                        </Border>

