                                                Visibility="Collapsed" Margin="0,2,6,4" Height="32" Padding="10,0" ToolTip="Select all detected junk categories"/>
                                        <Button x:Name="BtnJunkSelectSafe" Content="🛡 Safe" Style="{StaticResource HeaderOutlineButton}" Click="OnJunkSelectSafe"
                                                Visibility="Collapsed" Margin="0,2,6,4" Height="32" Padding="10,0" ToolTip="Select only standard low-risk junk categories"/>
                                        <Button x:Name="BtnJunkDeselectAll" Content="☐ None" Style="{StaticResource HeaderOutlineButton}" Click="OnJunkDeselectAll"
                                                Visibility="Collapsed" Margin="0,2,8,4" Height="32" Padding="10,0" ToolTip="Deselect all junk categories"/>
                                        <Button x:Name="BtnCleanJunk" Content="🧹 Clean Selected" Style="{StaticResource HeaderActionButton}" local:Gate.Requires="Core" Click="OnJunkClean"
