                                            <ComboBoxItem Content="Dark (Glassmorphic)" Tag="Dark" IsSelected="True"/>
                                            <ComboBoxItem Content="Light (Daylight)" Tag="Light"/>
                                            <ComboBoxItem Content="Follow Windows" Tag="System"/>
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,20,8" VerticalAlignment="Center">
                                        <TextBlock Text="Accent:" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <ComboBox x:Name="CmbAccentColor" Style="{StaticResource DarkComboBoxStyle}" Width="145" Height="30" SelectionChanged="OnAppearanceSettingChanged">
                                            <ComboBoxItem Content="Cyan (Default)" Tag="Cyan" IsSelected="True"/>
                                            <ComboBoxItem Content="Purple" Tag="Purple"/>
                                            <ComboBoxItem Content="Emerald" Tag="Emerald"/>
                                            <ComboBoxItem Content="Amber" Tag="Amber"/>
                                            <ComboBoxItem Content="Blue" Tag="Blue"/>
                                            <ComboBoxItem Content="Rose" Tag="Rose"/>
                                            <ComboBoxItem Content="Teal" Tag="Teal"/>
