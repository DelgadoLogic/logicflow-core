                                        <Border Background="{DynamicResource BrandDarkCardBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="4" Padding="6,1" Margin="0,2,0,2" VerticalAlignment="Center">
                                            <TextBlock Text="SQLITE VACUUM" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrandCyanBrush}"/>
                                        </Border>
                                    </WrapPanel>
                                    <WrapPanel VerticalAlignment="Center">
                                        <Button x:Name="BtnScanBrowserPrivacy" Content="🔍 Scan Browser Profiles" Style="{StaticResource HeaderOutlineButton}" Click="OnScanBrowserPrivacy" Margin="0,2,8,4"
                                                ToolTip="Discover Chrome, Edge, Brave, Opera, Vivaldi, and Firefox profiles and inspect tracking vs. whitelisted cookies"/>
                                        <Button x:Name="BtnCleanBrowserPrivacy" Content="🧹 Clean Tracking Cookies &amp; Vacuum SQLite" Style="{StaticResource HeaderActionButton}" local:Gate.Requires="Core" Click="OnCleanBrowserPrivacy" Background="#00897B" Margin="0,2,0,4"
                                                ToolTip="Prune non-whitelisted tracking cookies and run SQLite VACUUM on closed browser databases"/>
