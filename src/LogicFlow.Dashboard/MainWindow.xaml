                                    <TextBlock x:Name="ShredderSummaryText" Text="" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SuccessGreenBrush}" TextWrapping="Wrap"/>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ──── Settings Page ──── -->
                <ScrollViewer x:Name="PageSettings" VerticalScrollBarVisibility="Auto" Padding="24" Visibility="Collapsed">
                    <StackPanel x:Name="SettingsContent" Opacity="0">
                        <StackPanel.RenderTransform>
                            <TranslateTransform X="0" Y="0"/>
                        </StackPanel.RenderTransform>

                        <!-- Settings Category Filter Bar -->
                        <Border Style="{StaticResource GlassPanel}" Padding="12,10" Margin="0,0,0,18">
                            <WrapPanel x:Name="SettingsCategoryPillBar" VerticalAlignment="Center">
                                <TextBlock Text="FILTER:" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="4,0,10,0"/>
