                                <Border x:Name="WinGetSummaryBar" Background="{DynamicResource BrandDarkCardBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,12,0,0" Visibility="Collapsed">
