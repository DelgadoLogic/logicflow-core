                                    <WrapPanel VerticalAlignment="Center">
                                        <Button Content="🧹 Flush Standby Cache" Style="{StaticResource HeaderOutlineButton}" local:Gate.Requires="Core" Click="OnFlushStandbyCache" Margin="0,2,8,4" ToolTip="Purges cached memory from closed applications and releases Standby pages immediately"/>
                                        <Button Content="💿 Virtual Memory" Style="{StaticResource HeaderActionButton}" local:Gate.Requires="Core" Click="OnVirtualMemoryOptimize" Background="#00897B" Margin="0,2,8,4" ToolTip="Analyze physical and virtual memory topology, pagefile health, and drive allocation"/>
                                        <Button Content="🧠 Optimize RAM" Style="{StaticResource HeaderActionButton}" local:Gate.Requires="Core" Click="OnMemoryOptimize" Background="#7C4DFF" Margin="0,2,0,4" ToolTip="Trim working sets, flush file cache, and release unused memory without killing processes"/>
