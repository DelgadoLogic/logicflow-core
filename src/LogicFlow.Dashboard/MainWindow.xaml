                                    <TextBlock x:Name="BrowserPrivacySummaryText" Text="" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SuccessGreenBrush}" TextWrapping="Wrap"/>
                                </Border>

                                <ItemsControl x:Name="BrowserPrivacyList" Margin="0,8,0,0" PreviewMouseWheel="OnNestedListPreviewMouseWheel"/>
                            </StackPanel>
                        </Border>

                        <!-- Memory Optimizer -->
                        <Border Style="{StaticResource GlassPanel}" Margin="0,0,0,20">
