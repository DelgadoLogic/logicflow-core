                                          ToolTip="Keep LogicFlow running quietly in the system tray when closing the window"/>
                                <CheckBox x:Name="SettingStopAgentOnExit" Content="Stop LogicFlowAgent background service when exiting LogicFlow" Style="{StaticResource ToggleSwitchStyle}" Checked="OnSettingToggled" Unchecked="OnSettingToggled"
                                          ToolTip="Guarantees zero residual background processes or services remain running when you Quit LogicFlow"/>
                                <CheckBox x:Name="SettingShowNotifications" Content="Show system tray notifications" Style="{StaticResource ToggleSwitchStyle}" Checked="OnSettingToggled" Unchecked="OnSettingToggled"
                                          ToolTip="Display desktop toast notifications for system health, scans, and optimization events"/>
                                <CheckBox x:Name="SettingCheckForUpdates" Content="Check for updates automatically" Style="{StaticResource ToggleSwitchStyle}" Checked="OnSettingToggled" Unchecked="OnSettingToggled"
                                          ToolTip="Periodically check for updated LogicFlow software and driver definitions"/>
                                <WrapPanel Margin="0,8,0,0">
                                    <Button Content="🚀 Create /boost Desktop Shortcut" Style="{StaticResource OutlineButton}" Margin="0,0,10,6" Padding="14,6" Click="OnCreateBoostShortcutClick"
                                            ToolTip="Create a Desktop shortcut to toggle Boost Mode silently without opening the Dashboard window"/>
                                    <Button Content="🧹 Create 1-Click Clean Desktop Shortcut" Style="{StaticResource OutlineButton}" Margin="0,0,10,6" Padding="14,6" Click="OnCreateCleanShortcutClick"
                                            ToolTip="Create a Desktop shortcut to run headless junk &amp; RAM cleanup (LogicFlow.exe --auto-maintenance)"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <!-- 2. Scan Preferences & Global Exclusions Card -->
                        <Border x:Name="SettingsCardExclusions" Style="{StaticResource GlassPanel}" Margin="0,0,0,20">
                            <StackPanel>
                                <TextBlock Text="SCAN, SCHEDULED MAINTENANCE &amp; EXCLUSIONS" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,16"/>
                                <CheckBox x:Name="SettingAutoScanOnStartup" Content="Perform automatic scan on application launch" Style="{StaticResource ToggleSwitchStyle}" Checked="OnSettingToggled" Unchecked="OnSettingToggled"
                                          ToolTip="Automatically run diagnostic scans when LogicFlow launches"/>
                                <CheckBox x:Name="SettingScanDriversOnStartup" Content="Include driver health checks during startup scans" Style="{StaticResource ToggleSwitchStyle}" Checked="OnSettingToggled" Unchecked="OnSettingToggled"
                                          ToolTip="Check hardware driver health, versions, and digital signatures on startup"/>
                                <CheckBox x:Name="SettingScanRegistryOnStartup" Content="Include deep registry scan during startup scans" Style="{StaticResource ToggleSwitchStyle}" Checked="OnSettingToggled" Unchecked="OnSettingToggled"
                                          ToolTip="Perform registry hive integrity checks on startup"/>
                                <CheckBox x:Name="SettingScanSmartOnStartup" Content="Check drive SMART diagnostics automatically on load" Style="{StaticResource ToggleSwitchStyle}" Checked="OnSettingToggled" Unchecked="OnSettingToggled"
                                          ToolTip="Read physical drive health indicators and S.M.A.R.T. telemetry on startup"/>
                                <CheckBox x:Name="SettingScheduleWeeklyClean" local:Gate.Requires="Core" Content="Schedule automatic weekly 1-Click Maintenance (Sundays at 03:00 AM)" Style="{StaticResource ToggleSwitchStyle}" Checked="OnSettingToggled" Unchecked="OnSettingToggled"
                                          ToolTip="Registers a Windows Scheduled Task under your user account for weekly headless cleanup"/>

                                <!-- Global Scan & Cleanup Exclusions -->
                                <Border Background="{DynamicResource BrandDarkPanelBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,10,0,0">
                                    <StackPanel>
                                        <DockPanel LastChildFill="False" Margin="0,0,0,6">
                                            <StackPanel DockPanel.Dock="Left">
                                                <TextBlock Text="PROTECTED FOLDER EXCLUSIONS (JUNK CLEANER, QUICK CLEAN &amp; DEDUPLICATION)" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                <TextBlock Text="Directories listed below are skipped by Junk Cleaner, Tray Quick Clean, Headless Maintenance, and HyperStore scans." FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </DockPanel>
                                        <ListBox x:Name="SettingsExclusionsList" MinHeight="64" MaxHeight="140" Margin="0,6,0,8"
                                                 Background="{DynamicResource BrandDarkCardBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                                                 BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" FontFamily="{StaticResource FontMono}" FontSize="11"/>
                                        <WrapPanel>
                                            <Button Content="➕ Add Excluded Folder…" Style="{StaticResource OutlineButton}" Margin="0,0,8,4" Padding="12,5" Click="OnAddScanExclusionFolderClick"
                                                    ToolTip="Pick a folder to exclude from all cleanup and deduplication scans"/>
                                            <Button Content="➖ Remove Selected" Style="{StaticResource OutlineButton}" Margin="0,0,8,4" Padding="12,5" Click="OnRemoveScanExclusionClick"
                                                    ToolTip="Remove the selected folder from the exclusion list"/>
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- 2.5 Gemma 4 E2B Hybrid AI Engine Card -->
                        <Border x:Name="SettingsCardAi" Style="{StaticResource GlassPanel}" Margin="0,0,0,20">
                            <StackPanel>
                                <TextBlock Text="GEMMA 4 E2B AI ENGINE &amp; ASSISTANT PRIVACY" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                                <CheckBox x:Name="SettingHideAiAssistant" Content="Hide AI &amp; Voice Assistant cards across the Dashboard" Style="{StaticResource ToggleSwitchStyle}" Checked="OnSettingToggled" Unchecked="OnSettingToggled"
                                          ToolTip="Completely hide the Pulse AI assistant panel if you prefer a classic non-AI system utility interface"/>
                                <CheckBox x:Name="SettingAllowCloudAi" Content="Allow Cloud AI fallback when local Gemma 4 sidecar is offline (sends prompt to api.delgadologic.tech)" Style="{StaticResource ToggleSwitchStyle}" Checked="OnSettingToggled" Unchecked="OnSettingToggled"
                                          ToolTip="Off by default. When unchecked, Hybrid Auto stays 100% local on this PC and never transmits prompts over the network."/>
                                <TextBlock x:Name="TxtGemmaStatus" Text="Mode: Hybrid Auto · Checking local Gemma 4 E2B sidecar status..." FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,8" TextWrapping="Wrap"/>
                                <ProgressBar x:Name="PbGemmaDownload" Minimum="0" Maximum="100" Value="0" Height="6" Margin="0,0,0,12" Visibility="Collapsed" Foreground="{DynamicResource BrandCyanBrush}"/>
                                <WrapPanel Margin="0,0,0,12" VerticalAlignment="Center">
                                    <TextBlock Text="Execution Mode:" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="0,4,12,4"/>
                                    <ComboBox x:Name="CmbAiExecutionMode" Style="{StaticResource DarkComboBoxStyle}" MinWidth="240" MaxWidth="320" Height="30" Margin="0,2,0,2" SelectionChanged="OnAiExecutionModeChanged">
                                        <ComboBoxItem Content="Hybrid Auto (Local Sidecar + Opt-In Cloud)" Tag="HybridAuto" IsSelected="True"/>
                                        <ComboBoxItem Content="Local Offline Sidecar Only (Gemma 4 E2B)" Tag="LocalSidecar"/>
                                        <ComboBoxItem Content="Cloud Endpoint Only" Tag="CloudEndpoint"/>
                                        <ComboBoxItem Content="Disabled (Rule-Based Diagnostics Only)" Tag="Disabled"/>
                                    </ComboBox>
                                </WrapPanel>
                                <WrapPanel>
                                    <Button x:Name="BtnDownloadGemmaSidecar" Content="⬇ Download Gemma 4 E2B Sidecar" Style="{StaticResource ActionButton}" Margin="0,0,10,6" Padding="14,6" Click="OnDownloadGemmaSidecarClick"
                                            ToolTip="Download llama-server.exe and gemma-4-E2B-it-Q4_K_M.gguf into %LOCALAPPDATA%\LogicFlow\AI\ with SHA-256 verification"/>
                                    <Button x:Name="BtnCancelGemmaDownload" Content="✕ Cancel Download" Style="{StaticResource DangerButtonStyle}" Visibility="Collapsed" Margin="0,0,10,6" Padding="14,6" Click="OnCancelGemmaDownloadClick"
                                            ToolTip="Abort the active Gemma sidecar/model download"/>
                                    <Button x:Name="BtnStopGemmaSidecar" Content="⏹ Unload Sidecar (Free VRAM)" Style="{StaticResource OutlineButton}" Margin="0,0,10,6" Padding="14,6" Click="OnStopGemmaSidecarClick"
                                            ToolTip="Immediately terminate the local llama-server.exe sidecar process to return 100% of VRAM and RAM to Windows"/>
                                    <Button x:Name="BtnDeleteGemmaModel" Content="🗑 Delete Local Model" Style="{StaticResource OutlineButton}" Margin="0,0,10,6" Padding="14,6" Click="OnDeleteGemmaModelClick"
                                            ToolTip="Stop the local sidecar and delete gemma-4-E2B-it-Q4_K_M.gguf to reclaim disk space"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <!-- 3. Security & Privacy Card -->
                        <Border x:Name="SettingsCardPrivacy" Style="{StaticResource GlassPanel}" Margin="0,0,0,20">
                            <StackPanel>
                                <TextBlock Text="SECURITY &amp; PRIVACY" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,16"/>
                                <!-- Diagnostics sharing (consent-driven; see ConsentStore) -->
                                <Border Background="{DynamicResource BrandDarkPanelBrush}" CornerRadius="8" Padding="14,12" Margin="0,0,0,16" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="Diagnostics Sharing" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <TextBlock x:Name="TelemetryStatusText" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,10"/>
                                        <CheckBox x:Name="SettingShareStandard" Content="Share crash reports, feature usage, and scan counts (Standard)" Style="{StaticResource ToggleSwitchStyle}"
                                                  Checked="OnTelemetryToggled" Unchecked="OnTelemetryToggled"
                                                  ToolTip="Crash messages are scrubbed of paths, user and machine names, email, and IP addresses"/>
                                        <CheckBox x:Name="SettingShareExtended" Content="Also share the system baseline and driver index (Extended)" Style="{StaticResource ToggleSwitchStyle}"
                                                  Checked="OnTelemetryToggled" Unchecked="OnTelemetryToggled"
                                                  ToolTip="Services, BIOS/firmware, devices and drivers, installed updates"/>
                                        <WrapPanel Margin="0,8,0,0">
                                            <Button Content="View What Is Sent" Style="{StaticResource OutlineButton}" Margin="0,0,10,6" Padding="14,6" Click="OnViewTelemetryClick"/>
                                            <Button Content="Reset Install ID" Style="{StaticResource OutlineButton}" Margin="0,0,10,6" Padding="14,6" Click="OnRotateInstallIdClick"
                                                    ToolTip="Issue a new random install ID. Data already sent stays under the old ID until you delete it."/>
                                            <Button Content="Delete My Data" Style="{StaticResource OutlineButton}" Margin="0,0,10,6" Padding="14,6" Click="OnDeleteTelemetryDataClick"
                                                    ToolTip="Delete everything stored locally and ask the server to delete data held for this install ID"/>
                                            <Button Content="Change Edition or Region…" Style="{StaticResource OutlineButton}" Margin="0,0,10,6" Padding="14,6" Click="OnOpenConsentClick"/>
                                        </WrapPanel>
                                        <TextBlock Text="Your install ID is random (pseudonymous) and is never derived from your hardware." FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                                <CheckBox x:Name="SettingTelemetryBlocking" local:Gate.Requires="Core" Content="Block Windows diagnostic telemetry and data tracking" Style="{StaticResource ToggleSwitchStyle}" Checked="OnSettingToggled" Unchecked="OnSettingToggled"
                                          ToolTip="Disable Windows telemetry, diagnostics data transmission, and Cortana data harvesting"/>
                                <CheckBox x:Name="SettingAutoScrubPrivacy" local:Gate.Requires="BackgroundAutomation" Content="Enable automatic background privacy scrubbing (Pro)" Style="{StaticResource ToggleSwitchStyle}" Checked="OnSettingToggled" Unchecked="OnSettingToggled"
                                          ToolTip="Periodically clear activity history, diagnostic caches, and tracking traces in the background"/>
                                <CheckBox x:Name="SettingAllowUnsafeRegistry" Content="Allow unsafe registry fixes (recommends backup first)" Style="{StaticResource ToggleSwitchStyle}" Checked="OnSettingToggled" Unchecked="OnSettingToggled"
                                          ToolTip="Permit fixing high-risk registry keys (recommended only with active System Restore backup)"/>
                            </StackPanel>
                        </Border>

                        <!-- About & Legal Card -->
                        <Border x:Name="SettingsCardAbout" Style="{StaticResource GlassPanel}" Margin="0,0,0,20">
                            <StackPanel>
                                <TextBlock Text="ABOUT, HELP &amp; OFFLINE LEGAL DOCUMENTS" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,12"/>
                                <TextBlock Text="Delgado Creative Enterprises LLC d/b/a DelgadoLogic · support@delgadologic.tech" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,10" TextWrapping="Wrap"/>
                                <WrapPanel>
                                    <Button Content="About LogicFlow" Style="{StaticResource ActionButton}" Margin="0,0,10,6" Padding="14,6" Click="OnAboutClick"/>
                                    <Button Content="❓ Offline Help &amp; CLI (F1)" Style="{StaticResource OutlineButton}" Margin="0,0,10,6" Padding="14,6" Click="OnHelpButtonClick"/>
                                    <Button Content="EULA" Tag="eula" Style="{StaticResource OutlineButton}" Margin="0,0,10,6" Padding="14,6" Click="OnLegalLinkClick"/>
                                    <Button Content="Privacy" Tag="privacy" Style="{StaticResource OutlineButton}" Margin="0,0,10,6" Padding="14,6" Click="OnLegalLinkClick"/>
                                    <Button Content="Terms" Tag="terms" Style="{StaticResource OutlineButton}" Margin="0,0,10,6" Padding="14,6" Click="OnLegalLinkClick"/>
                                    <Button Content="Refunds" Tag="refund" Style="{StaticResource OutlineButton}" Margin="0,0,10,6" Padding="14,6" Click="OnLegalLinkClick"/>
                                    <Button Content="Third-Party Notices" Tag="third-party" Style="{StaticResource OutlineButton}" Margin="0,0,10,6" Padding="14,6" Click="OnLegalLinkClick"/>
                                    <Button Content="Security" Tag="security" Style="{StaticResource OutlineButton}" Margin="0,0,10,6" Padding="14,6" Click="OnLegalLinkClick"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <!-- 4. Diagnostic Storage & License Card -->
                        <Border x:Name="SettingsCardData" Style="{StaticResource GlassPanel}">
                            <StackPanel>
                                <TextBlock Text="DIAGNOSTIC STORAGE, BACKUP &amp; LICENSE" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,16"/>
                                <TextBlock Text="LogicFlow by DelgadoLogic" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8"/>

                                <!-- Active Edition Badge & Key Activation -->
                                <Border Background="{DynamicResource BrandDarkPanelBrush}" CornerRadius="8" Padding="14,12" Margin="0,0,0,16" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,10">
                                            <TextBlock Text="ACTIVE EDITION" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                            <Border x:Name="SettingsTierBadge" Background="{DynamicResource BrandDarkCardBrush}" CornerRadius="6" Padding="8,3" HorizontalAlignment="Right">
                                                <TextBlock x:Name="SettingsTierText" Text="⚡ COMMUNITY EDITION" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrandCyanBrush}"/>
                                            </Border>
                                        </DockPanel>
                                        <TextBlock Text="ENTER YOUR PRO LICENSE KEY" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="TxtLicenseKey" Height="32" Background="{DynamicResource BrandDarkCardBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" 
                                                     BorderThickness="1" Padding="10,0" FontSize="11" FontFamily="Consolas" VerticalAlignment="Center" VerticalContentAlignment="Center"
                                                     ToolTip="Paste your LogicFlow Pro license key"/>
                                            <Button x:Name="BtnActivateLicense" Grid.Column="1" Content="Activate" Style="{StaticResource ActionButton}" Height="32"
                                                    Margin="8,0,0,0" Padding="16,0" FontSize="12" Click="OnActivateLicenseClick"
                                                    ToolTip="Validate the license key and activate Pro on this device"/>
                                        </Grid>
                                        <TextBlock x:Name="LicenseActivationStatus" Text="Enter your Pro license key to unlock 3 devices, commercial use, and background automation." 
                                                   FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                    </StackPanel>
                                </Border>

                                <TextBlock x:Name="HwidLabel" Text="Device ID: loading…" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,12" FontFamily="Consolas"/>
                                <TextBlock Text="DATA &amp; LOG STORAGE PATHS" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                <TextBlock x:Name="DataPathLabel" Text="..." FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" FontFamily="Consolas" TextWrapping="Wrap" Margin="0,0,0,16"/>
                                
                                <WrapPanel Margin="0,8,0,0">
                                    <Button Content="📤 Export Settings JSON…" Style="{StaticResource OutlineButton}" Margin="0,0,12,8" Click="OnExportSettingsClick" Padding="16,8"
                                            ToolTip="Export your preferences and folder exclusions to a portable JSON file"/>
                                    <Button Content="📥 Import Settings JSON…" Style="{StaticResource OutlineButton}" Margin="0,0,12,8" Click="OnImportSettingsClick" Padding="16,8"
                                            ToolTip="Restore preferences and folder exclusions from a previously exported JSON file"/>
                                    <Button Content="Copy Device ID" Style="{StaticResource OutlineButton}" Margin="0,0,12,8" Click="OnCopyHwidClick" Padding="16,8"
                                            ToolTip="Copy unique machine hardware identifier (HWID) to Windows clipboard"/>
                                    <Button Content="📂 Open Data Folder" Style="{StaticResource OutlineButton}" Margin="0,0,12,8" Click="OnOpenDataFolderClick" Padding="16,8"
                                            ToolTip="Open LogicFlow local application data and config folder in Windows File Explorer"/>
                                    <Button Content="🧹 Clean Debug Logs" Style="{StaticResource OutlineButton}" Margin="0,0,12,8" Click="OnCleanLogsClick" Padding="16,8"
                                            ToolTip="Purge local diagnostic debug logs and crash dumps across %LOCALAPPDATA%, %APPDATA%, and %PROGRAMDATA%"/>
                                    <Button Content="⚠ Reset Settings to Default" Style="{StaticResource ActionButton}" Margin="0,0,12,8" Click="OnResetSettingsClick" Background="#FFD32F2F" Padding="16,8"
                                            ToolTip="Reset all application preferences, toggles, and configurations to factory defaults"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ──── HyperStore Storage Armor Page ──── -->
                <ScrollViewer x:Name="PageHyperStore" VerticalScrollBarVisibility="Auto" Padding="24" Visibility="Collapsed">
                    <ScrollViewer.Resources>
                        <!-- Base Category Filter Pill Style -->
                        <Style x:Key="CategoryFilterPillButton" TargetType="Button">
                            <Setter Property="Background" Value="{DynamicResource BrandDarkPanelBrush}"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}"/>
                            <Setter Property="BorderThickness" Value="1"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                            <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
                            <Setter Property="FontSize" Value="11"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Height" Value="28"/>
                            <Setter Property="Padding" Value="12,0"/>
                            <Setter Property="Margin" Value="0,0,6,0"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="SnapsToDevicePixels" Value="True"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="pillBorder" Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                              RecognizesAccessKey="False"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="pillBorder" Property="Background" Value="{DynamicResource BrushAccentGlow}"/>
                                                <Setter TargetName="pillBorder" Property="BorderBrush" Value="{DynamicResource BrandCyanBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>

                        <!-- Pill: All -->
                        <Style x:Key="FilterPillAllStyle" TargetType="Button" BasedOn="{StaticResource CategoryFilterPillButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsFilterAll}" Value="True">
                                    <Setter Property="Background" Value="#2500E5FF"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource BrandCyanBrush}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource BrandCyanBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>

                        <!-- Pill: Installers & Binaries -->
                        <Style x:Key="FilterPillInstallersStyle" TargetType="Button" BasedOn="{StaticResource CategoryFilterPillButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsFilterInstallers}" Value="True">
                                    <Setter Property="Background" Value="#2500E5FF"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource BrandCyanBrush}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource BrandCyanBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>

                        <!-- Pill: Media -->
                        <Style x:Key="FilterPillMediaStyle" TargetType="Button" BasedOn="{StaticResource CategoryFilterPillButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsFilterMedia}" Value="True">
                                    <Setter Property="Background" Value="#25A78BFA"/>
                                    <Setter Property="BorderBrush" Value="#A78BFA"/>
                                    <Setter Property="Foreground" Value="#A78BFA"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>

                        <!-- Pill: Code & Archives -->
                        <Style x:Key="FilterPillCodeArchivesStyle" TargetType="Button" BasedOn="{StaticResource CategoryFilterPillButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsFilterCodeArchives}" Value="True">
                                    <Setter Property="Background" Value="#25F59E0B"/>
                                    <Setter Property="BorderBrush" Value="#F59E0B"/>
                                    <Setter Property="Foreground" Value="#F59E0B"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>

                        <!-- Pill: Documents -->
                        <Style x:Key="FilterPillDocumentsStyle" TargetType="Button" BasedOn="{StaticResource CategoryFilterPillButton}">
                            <Setter Property="Margin" Value="0"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsFilterDocuments}" Value="True">
                                    <Setter Property="Background" Value="#2538BDF8"/>
                                    <Setter Property="BorderBrush" Value="#38BDF8"/>
                                    <Setter Property="Foreground" Value="#38BDF8"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ScrollViewer.Resources>
                    <StackPanel Opacity="1">
                        <StackPanel.RenderTransform>
                            <TranslateTransform x:Name="HyperStoreTranslate" X="0" Y="0"/>
                        </StackPanel.RenderTransform>

                        <!-- ──── HyperStore Storage Armor Hero Banner with Breathing Shield ──── -->
                        <Border Style="{StaticResource GlassPanel}" Margin="0,0,0,20" Background="{DynamicResource BrandDarkPanelBrush}" BorderBrush="{DynamicResource BrushAccentBorder}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- HyperStore Breathing Shield Emblem -->
                                <Border x:Name="HyperStoreShieldBorder" Grid.Column="0" Width="64" Height="64" CornerRadius="16" Background="#1600E5FF"
                                        BorderBrush="{DynamicResource BrandCyanBrush}" BorderThickness="1.5"
                                        Margin="0,0,20,0" RenderTransformOrigin="0.5,0.5">
                                    <Border.RenderTransform>
                                        <ScaleTransform ScaleX="1.0" ScaleY="1.0"/>
                                    </Border.RenderTransform>
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="14" ShadowDepth="0" Color="#00E5FF" Opacity="0.4"/>
                                    </Border.Effect>
                                    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <!-- Vector Shield Glyph -->
                                        <Path Data="M 0,0 L 22,0 C 22,14 11,26 0,30 C -11,26 -22,14 -22,0 Z"
                                              Stroke="{DynamicResource BrandCyanBrush}" StrokeThickness="2"
                                              Fill="#2000E5FF" Width="36" Height="36" Stretch="Uniform"/>
                                        <TextBlock Text="⚡" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource BrandCyanBrush}"/>
                                    </Grid>
                                    <Border.Triggers>
                                        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                            <BeginStoryboard x:Name="HyperStoreShieldBreathingStoryboard">
                                                <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                    <DoubleAnimation Storyboard.TargetName="HyperStoreShieldBorder"
                                                                     Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.BlurRadius)"
                                                                     From="12" To="32" Duration="0:0:1.8">
                                                        <DoubleAnimation.EasingFunction>
                                                            <SineEase EasingMode="EaseInOut"/>
                                                        </DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                    <DoubleAnimation Storyboard.TargetName="HyperStoreShieldBorder"
                                                                     Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.Opacity)"
                                                                     From="0.30" To="0.85" Duration="0:0:1.8">
                                                        <DoubleAnimation.EasingFunction>
                                                            <SineEase EasingMode="EaseInOut"/>
                                                        </DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                    <DoubleAnimation Storyboard.TargetName="HyperStoreShieldBorder"
                                                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                                     From="1.0" To="1.035" Duration="0:0:1.8">
                                                        <DoubleAnimation.EasingFunction>
                                                            <SineEase EasingMode="EaseInOut"/>
                                                        </DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                    <DoubleAnimation Storyboard.TargetName="HyperStoreShieldBorder"
                                                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                                     From="1.0" To="1.035" Duration="0:0:1.8">
                                                        <DoubleAnimation.EasingFunction>
                                                            <SineEase EasingMode="EaseInOut"/>
                                                        </DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </Border.Triggers>
                                </Border>

                                <!-- Status & Telemetry Header -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                    <WrapPanel Margin="0,0,0,4">
                                        <TextBlock Text="STORAGE ARMOR — HYPERSTORE (V-DENSE)" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,10,0"/>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,2,0,2">
                                            <Control Style="{StaticResource RadarPulseDot}" VerticalAlignment="Center"/>
                                            <TextBlock Text="SHIELD ACTIVE" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrandCyanBrush}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </WrapPanel>
                                    <TextBlock Text="FastCDC Dynamic Chunking • 256-bit BLAKE3 SIMD • Zstandard Hot/Cold Delta • ReFS Block Clone &amp; HardLinks" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                </StackPanel>

                                <!-- Status Badge -->
                                <Border Grid.Column="2" Background="{DynamicResource BrandGlassBrush}" BorderBrush="{Binding ProtectionStatusBadgeBrush}" BorderThickness="1" CornerRadius="8" Padding="14,8" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Ellipse Width="8" Height="8" Fill="{Binding ProtectionStatusBadgeBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding ActiveProtectionStatus}" FontSize="12" FontWeight="Bold" Foreground="{Binding ProtectionStatusBadgeBrush}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Top 4 Telemetry Gauges Row (Symmetric 4-Column UniformGrid, adapts to 2x2 on compact/scaled viewports) -->
                        <UniformGrid x:Name="HyperStoreGaugesGrid" Columns="4" Margin="0,0,-10,10">
                            <!-- Gauge 1: Total Space Reclaimed -->
                            <Border Style="{StaticResource MetricGlassCardStyle}" Margin="0,0,10,10">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <WrapPanel Grid.Row="0" VerticalAlignment="Center">
                                        <TextBlock Text="💾 SPACE RECLAIMED" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,2"/>
                                        <TextBlock Text="{Binding SpaceReclaimedPercentFormatted}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SuccessGreenBrush}" VerticalAlignment="Center" Margin="0,0,0,2"/>
                                    </WrapPanel>
                                    <DockPanel Grid.Row="1" Margin="0,8,0,0">
                                        <TextBlock Text="{Binding TotalSpaceReclaimedFormatted}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource SuccessGreenBrush}" VerticalAlignment="Bottom" Margin="0,0,6,0"/>
                                        <TextBlock DockPanel.Dock="Right" Text="Reclaimed" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,0,2" TextTrimming="CharacterEllipsis"/>
                                    </DockPanel>
                                    <TextBlock Grid.Row="2" Text="Physical Storage Net Gain" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,8,0,0" TextTrimming="CharacterEllipsis"/>
                                </Grid>
                            </Border>

                            <!-- Gauge 2: Global Compression Ratio -->
                            <Border Style="{StaticResource MetricGlassCardStyle}" Margin="0,0,10,10">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <WrapPanel Grid.Row="0" VerticalAlignment="Center">
                                        <TextBlock Text="⚡ COMPRESSION" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,2"/>
                                        <TextBlock Text="{Binding SpaceSavedPercentFormatted}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource BrandCyanBrush}" VerticalAlignment="Center" Margin="0,0,0,2"/>
                                    </WrapPanel>
                                    <DockPanel Grid.Row="1" Margin="0,8,0,0">
                                        <TextBlock Text="{Binding GlobalCompressionRatioFormatted}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource BrandCyanBrush}" VerticalAlignment="Bottom" Margin="0,0,6,0"/>
                                        <TextBlock DockPanel.Dock="Right" Text="Zstandard" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,0,2" TextTrimming="CharacterEllipsis"/>
                                    </DockPanel>
                                    <TextBlock Grid.Row="2" Text="Hot L3 / Cold L19 + Dict" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,8,0,0" TextTrimming="CharacterEllipsis"/>
                                </Grid>
                            </Border>

                            <!-- Gauge 3: Chunks Indexed -->
                            <Border Style="{StaticResource MetricGlassCardStyle}" Margin="0,0,10,10">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <WrapPanel Grid.Row="0" VerticalAlignment="Center">
                                        <TextBlock Text="🧩 CHUNKS INDEXED" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,2"/>
                                        <TextBlock Text="FastCDC" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrandPurpleBrush}" VerticalAlignment="Center" Margin="0,0,0,2"/>
                                    </WrapPanel>
                                    <DockPanel Grid.Row="1" Margin="0,8,0,0">
                                        <TextBlock Text="{Binding ChunksIndexedFormatted}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource BrandPurpleBrush}" VerticalAlignment="Bottom" Margin="0,0,6,0"/>
                                        <TextBlock DockPanel.Dock="Right" Text="Indexed" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,0,2" TextTrimming="CharacterEllipsis"/>
                                    </DockPanel>
                                    <TextBlock Grid.Row="2" Text="32 KB Normalized Bounds" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,8,0,0" TextTrimming="CharacterEllipsis"/>
                                </Grid>
                            </Border>

                            <!-- Gauge 4: Active Protection Status -->
                            <Border Style="{StaticResource MetricGlassCardStyle}" Margin="0,0,10,10">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <WrapPanel Grid.Row="0" VerticalAlignment="Center">
                                        <TextBlock Text="🛡️ PROTECTION" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,2"/>
                                        <Border Background="{DynamicResource BrandDarkCardBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="4" Padding="6,1" Margin="0,0,0,2">
                                            <TextBlock Text="CoW / Links" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        </Border>
                                    </WrapPanel>
                                    <DockPanel Grid.Row="1" Margin="0,8,0,0">
                                        <TextBlock Text="{Binding ActiveProtectionStatus}" FontSize="20" FontWeight="Bold" Foreground="{Binding ProtectionStatusBadgeBrush}" VerticalAlignment="Bottom" Margin="0,0,6,0"/>
                                        <TextBlock DockPanel.Dock="Right" Text="Status" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,0,2" TextTrimming="CharacterEllipsis"/>
                                    </DockPanel>
                                    <TextBlock Grid.Row="2" Text="{Binding ProtectionStatusDetail}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" Margin="0,8,0,0" ToolTip="{Binding ProtectionStatusDetail}"/>
                                </Grid>
                            </Border>
                        </UniformGrid>

                        <!-- Interactive Control Center -->
                        <Border Style="{StaticResource GlassPanel}" Margin="0,0,0,20">
                            <StackPanel>
                                <DockPanel LastChildFill="False" Margin="0,0,0,14">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" DockPanel.Dock="Left">
                                        <TextBlock Text="⚡" FontSize="14" Foreground="{DynamicResource BrandCyanBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="INTERACTIVE STORAGE ARMOR CONTROLS" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock DockPanel.Dock="Right" Text="Multi-threaded engine" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                </DockPanel>

                                <!-- Action Buttons -->
                                <WrapPanel Margin="0,0,0,16">
                                    <Button x:Name="BtnHyperStoreScan" Content="🔍 Scan Drive for Redundancies" Style="{StaticResource ActionButton}" Height="38" Padding="18,0" Margin="0,0,10,8" Click="OnScanDriveForRedundanciesClick" IsEnabled="{Binding IsNotBusy}" ToolTip="Scan files with FastCDC chunking and 256-bit BLAKE3 fingerprinting without modifying disk"/>
                                    <Button x:Name="BtnHyperStoreDedup" Content="⚡ Deduplicate Workspace" Style="{StaticResource ActionButton}" Height="38" Padding="18,0" Margin="0,0,10,8" local:Gate.Requires="Core" Click="OnDedupWorkspaceClick" IsEnabled="{Binding IsNotBusy}" ToolTip="Consolidate duplicate files via native ReFS Block Cloning or NTFS hard links with safety whitelisting"/>
                                    <Button x:Name="BtnHyperStorePack" Content="📦 Pack Directory to .lfc" Style="{StaticResource OutlineButton}" Height="38" Padding="18,0" Margin="0,0,10,8" local:Gate.Requires="Core" Click="OnPackDirectoryToLfcClick" IsEnabled="{Binding IsNotBusy}" ToolTip="Compress directory into .lfc container with FastCDC, MinHash &amp; dual-tier Zstandard"/>
                                    <Button x:Name="BtnHyperStoreUnpack" Content="📂 Unpack .lfc Archive" Style="{StaticResource OutlineButton}" Height="38" Padding="18,0" Margin="0,0,10,8" Click="OnUnpackLfcArchiveClick" IsEnabled="{Binding IsNotBusy}" ToolTip="Extract and verify a sovereign .lfc container archive via LfcReader"/>
                                    <Button x:Name="BtnHyperStoreDiskSpace" Content="📊 Analyze Disk Space" Style="{StaticResource OutlineButton}" Height="38" Padding="18,0" Margin="0,0,10,8" Click="OnHyperStoreDiskSpaceClick" IsEnabled="{Binding IsNotBusy}" ToolTip="Run DiskSpaceAnalyzer to identify largest files, folders, and file extensions"/>
                                </WrapPanel>

                                <!-- Trigger Mode & Sensor Settings Grid -->
                                <Border Background="{DynamicResource BrandDarkPanelBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="16,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Autonomous Trigger Modes -->
                                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                            <TextBlock Text="AUTONOMOUS TRIGGER MODE" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                                            <WrapPanel>
                                                <RadioButton Content="Continuous Low-Priority" IsChecked="{Binding IsContinuousLowPriority}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" Margin="0,0,16,4" Cursor="Hand"/>
                                                <RadioButton Content="Scheduled Window (02:00 - 06:00)" IsChecked="{Binding IsScheduledWindow}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" Margin="0,0,16,4" Cursor="Hand"/>
                                                <RadioButton Content="Manual-Only" IsChecked="{Binding IsManualOnly}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" Margin="0,0,0,4" Cursor="Hand"/>
                                            </WrapPanel>
                                        </StackPanel>

                                        <!-- Safety Sensor Toggles -->
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="HARDWARE &amp; GAME SENSORS" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                                            <WrapPanel>
                                                <CheckBox Content="Game Guard Auto-Pause (&lt;500ms SLA)" IsChecked="{Binding IsGameGuardEnabled}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11" Margin="0,0,14,4"/>
                                                <CheckBox Content="AC Wall Power Only" IsChecked="{Binding IsAcPowerOnly}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11" Margin="0,0,14,4"/>
                                                <CheckBox Content="ReFS Native Block Cloning" IsChecked="{Binding IsRefsCloningEnabled}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11" Margin="0,0,0,4"/>
                                            </WrapPanel>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Live Progress & Streaming Telemetry Bar -->
                        <Border Style="{StaticResource GlassPanel}" Margin="0,0,0,20" Visibility="{Binding ProgressVisibility}">
                            <StackPanel>
                                <DockPanel LastChildFill="False" Margin="0,0,0,8">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" DockPanel.Dock="Left">
                                        <Border Width="8" Height="8" CornerRadius="4" Background="{DynamicResource BrandCyanBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding ActiveOperation}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource BrandCyanBrush}" VerticalAlignment="Center"/>
                                        <TextBlock Text=" — " FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="500"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" DockPanel.Dock="Right">
                                        <TextBlock Text="{Binding ThroughputFormatted}" FontSize="11" FontFamily="{StaticResource FontMono}" Foreground="{DynamicResource BrandCyanBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                        <TextBlock Text="{Binding ProgressPercent, StringFormat={}{0:F0}%}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource BrandCyanBrush}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                                        <Button Content="✕ Abort" Style="{StaticResource DangerButtonStyle}" Height="28" Padding="12,0" Click="OnCancelHyperStoreOperationClick" Cursor="Hand" ToolTip="Cancel active operation"/>
                                    </StackPanel>
                                </DockPanel>

                                <ProgressBar Height="8" Minimum="0" Maximum="100" Value="{Binding ProgressPercent}" Style="{StaticResource GlassProgressBarStyle}" Margin="0,4,0,0">
                                    <ProgressBar.Effect>
                                        <DropShadowEffect BlurRadius="10" ShadowDepth="0" Color="{StaticResource BrandCyan}" Opacity="0.6"/>
                                    </ProgressBar.Effect>
                                </ProgressBar>

                                <DockPanel LastChildFill="False" Margin="0,8,0,0">
                                    <TextBlock DockPanel.Dock="Left" Text="{Binding CurrentFile}" FontSize="11" FontFamily="{StaticResource FontMono}" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" MaxWidth="600"/>
                                </DockPanel>
                            </StackPanel>
                        </Border>

                        <!-- ──── Interactive Disk Space Treemap (WizTree-Style Visual Block Map) ──── -->
                        <Border x:Name="DiskSpaceTreemapPanel" Style="{StaticResource GlassPanel}" Margin="0,0,0,20">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <WrapPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                        <TextBlock Text="🗺️ INTERACTIVE DISK SPACE TREEMAP" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="0,2,8,2"/>
                                        <Border Background="{DynamicResource BrandDarkCardBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="4" Padding="6,1" Margin="0,2,0,2" VerticalAlignment="Center">
                                            <TextBlock Text="SQUARIFIED BLOCK MAP" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrandCyanBrush}"/>
                                        </Border>
                                    </WrapPanel>
                                    <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                                        <Button x:Name="BtnTreemapRoot" Content="🏠 Root" Style="{StaticResource HeaderOutlineButton}" Height="28" Padding="10,0" Margin="0,2,6,2" Click="OnTreemapRootClick" ToolTip="Return to scanned root directory"/>
                                        <Button x:Name="BtnTreemapUp" Content="⬆ Up to Parent" Style="{StaticResource HeaderOutlineButton}" Height="28" Padding="10,0" Margin="0,2,6,2" Click="OnTreemapUpClick" ToolTip="Navigate up one directory level"/>
                                        <Button x:Name="BtnTreemapOpenExplorer" Content="📁 Open in Explorer" Style="{StaticResource HeaderOutlineButton}" Height="28" Padding="10,0" Margin="0,2,6,2" Click="OnTreemapOpenExplorerClick" ToolTip="Open current treemap folder in Windows Explorer"/>
                                        <Button Content="📊 Scan &amp; Render Treemap" Style="{StaticResource HeaderActionButton}" Height="28" Padding="12,0" Margin="0,2,0,2" Click="OnHyperStoreDiskSpaceClick" ToolTip="Analyze folder hierarchy and render proportional squarified treemap tiles"/>
                                    </WrapPanel>
                                </Grid>

                                <TextBlock x:Name="TreemapCurrentPathText" Text="Click '📊 Analyze Disk Space' or '📊 Scan &amp; Render Treemap' to visualize proportional storage blocks (click any folder tile to drill down)." FontSize="11.5" FontFamily="{StaticResource FontMono}" Foreground="{DynamicResource BrandCyanBrush}" TextTrimming="CharacterEllipsis" Margin="0,0,0,6"/>

                                <WrapPanel VerticalAlignment="Center" Margin="0,0,0,8">
                                    <StackPanel Orientation="Horizontal" Margin="0,2,14,2" VerticalAlignment="Center">
                                        <Border Width="10" Height="10" CornerRadius="2" Background="#00E5FF" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Apps/Bin" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,2,14,2" VerticalAlignment="Center">
                                        <Border Width="10" Height="10" CornerRadius="2" Background="#8B5CF6" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Games/Arc" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,2,14,2" VerticalAlignment="Center">
                                        <Border Width="10" Height="10" CornerRadius="2" Background="#EC4899" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Media" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,2,14,2" VerticalAlignment="Center">
                                        <Border Width="10" Height="10" CornerRadius="2" Background="#10B981" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Code/Dev" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,2,14,2" VerticalAlignment="Center">
                                        <Border Width="10" Height="10" CornerRadius="2" Background="#F59E0B" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Docs" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,2" VerticalAlignment="Center">
                                        <Border Width="10" Height="10" CornerRadius="2" Background="#3B82F6" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="System/Other" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </WrapPanel>

                                <Border Background="{DynamicResource BrushBgTerminal}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="4" Height="280" ClipToBounds="True">
                                    <Canvas x:Name="DiskTreemapCanvas" Width="820" Height="270" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ClipToBounds="True" SizeChanged="OnDiskTreemapCanvasSizeChanged"/>
                                </Border>

                                <ItemsControl x:Name="DiskTreemapList" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- ──── Detected Duplicate Clusters & Redundancies ──── -->
                        <Border Style="{StaticResource GlassPanel}" Margin="0,0,0,20">
                            <StackPanel>
                                <!-- Header & Batch Controls -->
                                <WrapPanel Margin="0,0,0,14" VerticalAlignment="Center">
                                    <!-- Title & Summary Text -->
                                    <StackPanel VerticalAlignment="Center" Margin="0,2,16,6">
                                        <WrapPanel VerticalAlignment="Center">
                                            <TextBlock Text="🔍" FontSize="14" Foreground="{DynamicResource BrandCyanBrush}" Margin="0,2,8,2" VerticalAlignment="Center"/>
                                            <TextBlock Text="DETECTED REDUNDANCIES &amp; DUPLICATE CLUSTERS" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="0,2,10,2"/>
                                            <Border Background="{DynamicResource BrandDarkCardBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="6" Padding="8,2" Margin="0,2,0,2" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding TotalFindingsCount, StringFormat='{}{0} CLUSTERS'}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrandCyanBrush}"/>
                                            </Border>
                                        </WrapPanel>
                                        <TextBlock Text="{Binding FindingsSummaryText}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>

                                    <!-- Batch Buttons -->
                                    <WrapPanel VerticalAlignment="Center">
                                        <Button Content="☑ All" Style="{StaticResource HeaderOutlineButton}" Margin="0,2,6,4" Click="OnFindingSelectAllClick" ToolTip="Select all duplicate clusters"/>
                                        <Button Content="🛡 Safe" Style="{StaticResource HeaderOutlineButton}" Margin="0,2,6,4" Click="OnFindingSelectSafeClick" ToolTip="Select only safe non-system duplicate clusters"/>
                                        <Button Content="☐ None" Style="{StaticResource HeaderOutlineButton}" Margin="0,2,10,4" Click="OnFindingDeselectAllClick" ToolTip="Deselect all clusters"/>
                                        <Button Content="{Binding SelectedWastedSizeFormatted, StringFormat='⚡ Deduplicate Selected ({0})'}"
                                                Style="{StaticResource HeaderActionButton}" local:Gate.Requires="Core" Margin="0,2,0,4" Click="OnDeduplicateSelectedFindingsClick"
                                                IsEnabled="{Binding IsNotBusy}" ToolTip="Consolidate selected duplicate clusters via ReFS block cloning or NTFS hard linking"/>
                                    </WrapPanel>
                                </WrapPanel>

                                <!-- Category Breakdown Filter Pills -->
                                <Border Background="{DynamicResource BrandDarkPanelBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="8,6" Margin="0,0,0,14">
                                    <WrapPanel>
                                        <!-- All -->
                                        <Button Style="{StaticResource FilterPillAllStyle}"
                                                Click="OnCategoryFilterClick" Tag="All" Cursor="Hand" ToolTip="Show all duplicate clusters">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="All" FontSize="11" FontWeight="SemiBold" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                                <Border Background="{DynamicResource BrandDarkCardBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="4" Padding="6,1" Margin="6,0,0,0">
                                                    <TextBlock Text="{Binding TotalFindingsCount}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrandCyanBrush}"/>
                                                </Border>
                                            </StackPanel>
                                        </Button>

                                        <!-- Installers & Binaries -->
                                        <Button Style="{StaticResource FilterPillInstallersStyle}"
                                                Click="OnCategoryFilterClick" Tag="Installers &amp; Binaries" Cursor="Hand" ToolTip="Filter to installer, binary, executable files (.exe, .msi, .dll, .iso)">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="Installers &amp; Binaries" FontSize="11" FontWeight="SemiBold" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                                <Border Background="{DynamicResource BrandDarkCardBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="4" Padding="6,1" Margin="6,0,0,0">
                                                    <TextBlock Text="{Binding InstallersCount}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrandCyanBrush}"/>
                                                </Border>
                                            </StackPanel>
                                        </Button>

                                        <!-- Media -->
                                        <Button Style="{StaticResource FilterPillMediaStyle}"
                                                Click="OnCategoryFilterClick" Tag="Media" Cursor="Hand" ToolTip="Filter to video, audio, and image files (.mp4, .png, .jpg, .flac)">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="Media" FontSize="11" FontWeight="SemiBold" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                                <Border Background="{DynamicResource BrandDarkCardBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="4" Padding="6,1" Margin="6,0,0,0">
                                                    <TextBlock Text="{Binding MediaCount}" FontSize="11" FontWeight="Bold" Foreground="#A78BFA"/>
                                                </Border>
                                            </StackPanel>
                                        </Button>

                                        <!-- Code & Archives -->
                                        <Button Style="{StaticResource FilterPillCodeArchivesStyle}"
                                                Click="OnCategoryFilterClick" Tag="Code &amp; Archives" Cursor="Hand" ToolTip="Filter to source code, archives, and packages (.zip, .7z, .cs, .js)">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="Code &amp; Archives" FontSize="11" FontWeight="SemiBold" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                                <Border Background="{DynamicResource BrandDarkCardBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="4" Padding="6,1" Margin="6,0,0,0">
                                                    <TextBlock Text="{Binding CodeArchivesCount}" FontSize="11" FontWeight="Bold" Foreground="#F59E0B"/>
                                                </Border>
                                            </StackPanel>
                                        </Button>

                                        <!-- Documents -->
                                        <Button Style="{StaticResource FilterPillDocumentsStyle}"
                                                Click="OnCategoryFilterClick" Tag="Documents" Cursor="Hand" ToolTip="Filter to document files (.pdf, .docx, .xlsx, .txt, .md)">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="Documents" FontSize="11" FontWeight="SemiBold" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                                <Border Background="{DynamicResource BrandDarkCardBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="4" Padding="6,1" Margin="6,0,0,0">
                                                    <TextBlock Text="{Binding DocumentsCount}" FontSize="11" FontWeight="Bold" Foreground="#38BDF8"/>
                                                </Border>
                                            </StackPanel>
                                        </Button>
                                    </WrapPanel>
                                </Border>

                                <!-- Empty State Card (When no scan performed yet or no duplicates found) -->
                                <Border Background="{DynamicResource BrandDarkPanelBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="10" Padding="32,24"
                                        Visibility="{Binding FindingsEmptyVisibility}" HorizontalAlignment="Stretch">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Border Width="52" Height="52" CornerRadius="14" Background="{DynamicResource BrushAccentGlow}" BorderBrush="{DynamicResource BrushAccentBorder}" BorderThickness="1.5" HorizontalAlignment="Center" Margin="0,0,0,10">
                                            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Path Data="M 0,0 L 18,0 C 18,11 9,21 0,24 C -9,21 -18,11 -18,0 Z"
                                                      Stroke="{DynamicResource BrandCyanBrush}" StrokeThickness="1.8"
                                                      Fill="#2000E5FF" Width="28" Height="28" Stretch="Uniform"/>
                                                <TextBlock Text="⚡" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource BrandCyanBrush}"/>
                                            </Grid>
                                        </Border>
                                        <TextBlock Text="No Redundancy Findings to Display" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Click '🔍 Scan Drive for Redundancies' above to perform FastCDC 32 KB chunking and BLAKE3 SIMD fingerprinting."
                                                   FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,4,0,0" TextAlignment="Center" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>

                                <!-- Findings Itemized ListView (When duplicates detected) -->
                                <Border Style="{StaticResource TerminalBoxStyle}" Padding="6" Visibility="{Binding FindingsVisibility}" MaxHeight="450">
                                    <ListView ItemsSource="{Binding FilteredDuplicateFindings}" Background="Transparent" BorderThickness="0"
                                              ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                              ScrollViewer.CanContentScroll="False" PreviewMouseWheel="OnNestedListPreviewMouseWheel">
                                        <ListView.ItemContainerStyle>
                                            <Style TargetType="ListViewItem">
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Setter Property="BorderThickness" Value="0"/>
                                                <Setter Property="Padding" Value="0,3"/>
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                            </Style>
                                        </ListView.ItemContainerStyle>
                                        <ListView.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{DynamicResource BrandDarkCardBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,2">
                                                    <StackPanel>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/> <!-- Checkbox -->
                                                                <ColumnDefinition Width="Auto"/> <!-- Type Badge -->
                                                                <ColumnDefinition Width="*"/>    <!-- File Name & Path -->
                                                                <ColumnDefinition Width="Auto"/> <!-- Wasted Size & Copies -->
                                                                <ColumnDefinition Width="Auto"/> <!-- Action Buttons -->
                                                            </Grid.ColumnDefinitions>

                                                            <!-- Selection Checkbox -->
                                                            <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                                      VerticalAlignment="Center" Margin="0,0,10,0"
                                                                      IsEnabled="{Binding IsNotDeduplicated}"/>

                                                            <!-- Category / Type Badge -->
                                                            <Border Grid.Column="1" Background="{DynamicResource BrandDarkPanelBrush}" BorderBrush="{Binding FileTypeBadgeBrush}" BorderThickness="1"
                                                                    CornerRadius="4" Padding="6,2" VerticalAlignment="Center" Margin="0,0,10,0">
                                                                <TextBlock Text="{Binding FileTypeBadge}" FontSize="11" FontWeight="Bold" Foreground="{Binding FileTypeBadgeBrush}"/>
                                                            </Border>

                                                            <!-- Primary File Name & Directory Path -->
                                                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,12,0">
                                                                <TextBlock Text="{Binding PrimaryFileName}" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                                                <TextBlock Text="{Binding PrimaryFilePath}" FontSize="11" FontFamily="{StaticResource FontMono}" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                                            </StackPanel>

                                                            <!-- Wasted Size & Copies Count -->
                                                            <StackPanel Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,14,0">
                                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                                    <TextBlock Text="{Binding WastedSizeFormatted}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource SuccessGreenBrush}"/>
                                                                    <TextBlock Text=" wasted" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Bottom" Margin="2,0,0,1"/>
                                                                </StackPanel>
                                                                <TextBlock Text="{Binding DuplicateCopiesCount, StringFormat='{}{0} total copies'}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Right" Margin="0,1,0,0"/>
                                                            </StackPanel>

                                                            <!-- Action Buttons & Status -->
                                                            <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                                                                <!-- Open File Explorer Location -->
                                                                <Button Content="📁 Location" Style="{StaticResource HeaderOutlineButton}" Height="28" Padding="10,0" Margin="0,0,6,0"
                                                                        Click="OnOpenFindingLocationClick" ToolTip="Open file location in Windows Explorer"/>

                                                                <!-- Exclude Directory Folder -->
                                                                <Button Content="🚫 Exclude" Style="{StaticResource HeaderOutlineButton}" Height="28" Padding="10,0" Margin="0,0,6,0"
                                                                        Click="OnExcludeFindingFolderClick" ToolTip="Exclude this folder from deduplication"/>

                                                                <!-- Deduplicate Single Cluster -->
                                                                <Button Content="⚡ Dedup" Style="{StaticResource HeaderActionButton}" Height="28" Padding="12,0"
                                                                        local:Gate.Requires="Core" Click="OnDeduplicateSingleFindingClick" Visibility="{Binding ActionButtonsVisibility}"
                                                                        ToolTip="Consolidate duplicate copies of this file"/>

                                                                <!-- Consolidated Badge -->
                                                                <Border Background="#1810B981" BorderBrush="{DynamicResource SuccessGreenBrush}" BorderThickness="1"
                                                                        CornerRadius="4" Padding="8,4" Visibility="{Binding DeduplicatedBadgeVisibility}">
                                                                    <TextBlock Text="✓ CONSOLIDATED" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SuccessGreenBrush}"/>
                                                                </Border>
                                                            </StackPanel>
                                                        </Grid>

                                                        <!-- Duplicate Copies Sub-List -->
                                                        <Border Background="{DynamicResource BrandDarkPanelBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="28,8,0,0">
                                                            <StackPanel>
                                                                <TextBlock Text="DUPLICATE COPIES:" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                                                <ItemsControl ItemsSource="{Binding Copies}">
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <Grid Margin="0,2">
                                                                                <Grid.ColumnDefinitions>
                                                                                    <ColumnDefinition Width="Auto"/>
                                                                                    <ColumnDefinition Width="*"/>
                                                                                    <ColumnDefinition Width="Auto"/>
                                                                                    <ColumnDefinition Width="Auto"/>
                                                                                </Grid.ColumnDefinitions>
                                                                                <Border Grid.Column="0" Background="{Binding CopyTypeBadgeBg}" CornerRadius="3" Padding="5,1" Margin="0,0,8,0" VerticalAlignment="Center">
                                                                                    <TextBlock Text="{Binding CopyTypeBadge}" FontSize="11" FontWeight="Bold" Foreground="{Binding CopyTypeBadgeBrush}"/>
                                                                                </Border>
                                                                                <TextBlock Grid.Column="1" Text="{Binding FilePath}" FontSize="11" FontFamily="{StaticResource FontMono}"
                                                                                           Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                                                <TextBlock Grid.Column="2" Text="{Binding FileSizeFormatted}" FontSize="11" FontFamily="{StaticResource FontMono}"
                                                                                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="8,0" VerticalAlignment="Center"/>
                                                                                <Button Grid.Column="3" Content="📁" Style="{StaticResource HeaderOutlineButton}" Height="22" Width="26" Padding="0"
                                                                                        Click="OnOpenFindingLocationClick" ToolTip="Open this copy in Explorer"/>
                                                                            </Grid>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                            </StackPanel>
                                                        </Border>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Game Vault: compress installed game libraries (Windows WOF) -->
                        <Border Style="{StaticResource GlassPanel}" Padding="20,16">
                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                        <TextBlock Text="Game Vault" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <TextBlock Text="Find installed games and compress them with built-in Windows compression to free disk space." FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <ComboBox x:Name="ComboLauncherFilter" Style="{StaticResource DarkComboBoxStyle}" Width="120" Height="28" SelectedIndex="0" Margin="0,0,8,0"
                                                  SelectionChanged="OnLauncherFilterChanged" ToolTip="Filter by game launcher">
                                            <ComboBoxItem Content="All Launchers"/>
                                            <ComboBoxItem Content="Steam"/>
                                            <ComboBoxItem Content="Epic"/>
                                            <ComboBoxItem Content="GOG"/>
                                            <ComboBoxItem Content="Custom"/>
                                        </ComboBox>
                                        <Button x:Name="BtnScanGameLibraries" Content="Scan Game Libraries" Style="{StaticResource HeaderOutlineButton}" Height="28" Padding="12,0" Click="OnScanGameLibraries"/>
                                    </StackPanel>
                                </Grid>

                                <Border x:Name="GameVaultSummaryBar" Background="{DynamicResource BrandDarkPanelBrush}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,10" Visibility="Collapsed">
                                    <UniformGrid Rows="1" Columns="5">
                                        <StackPanel><TextBlock x:Name="GameVaultTotalGamesMetric" Text="0" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource BrandCyanBrush}"/><TextBlock Text="Games found" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/></StackPanel>
                                        <StackPanel><TextBlock x:Name="GameVaultTotalDiskMetric" Text="0 B" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/><TextBlock Text="Disk used" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/></StackPanel>
                                        <StackPanel><TextBlock x:Name="GameVaultSavingsMetric" Text="0 B" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource SuccessGreenBrush}"/><TextBlock Text="Space saved" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/></StackPanel>
                                        <StackPanel><TextBlock x:Name="GameVaultRecoveredMetric" Text="0 B" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource SuccessGreenBrush}"/><TextBlock Text="Recoverable" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/></StackPanel>
                                        <StackPanel><TextBlock x:Name="GameVaultDirectStorageMetric" Text="0" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource WarningAmberBrush}"/><TextBlock Text="DirectStorage (skipped)" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/></StackPanel>
                                    </UniformGrid>
                                </Border>

                                <Border x:Name="DecayAlertBanner" Background="#18F59E0B" BorderBrush="{DynamicResource WarningAmberBrush}" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,10" Visibility="Collapsed">
                                    <DockPanel>
                                        <Button x:Name="BtnRecompactDecay" Content="Recompact Updates" DockPanel.Dock="Right" Style="{StaticResource HeaderOutlineButton}" Height="26" Padding="10,0" local:Gate.Requires="GameVaultAutoCompact" Click="OnRecompactUpdates"/>
                                        <TextBlock x:Name="DecayAlertText" Foreground="{DynamicResource WarningAmberBrush}" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    </DockPanel>
                                </Border>

                                <WrapPanel VerticalAlignment="Center" Margin="0,0,0,10">
                                    <TextBlock Text="Algorithm" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,2,8,2"/>
                                    <ComboBox x:Name="ComboGlobalAlgorithm" Style="{StaticResource DarkComboBoxStyle}" Width="210" Height="28" SelectedIndex="0" Margin="0,2,12,2">
                                        <ComboBoxItem Content="LZX (best ratio)" Tag="1"/>
                                        <ComboBoxItem Content="XPRESS 16K (balanced)" Tag="3"/>
                                        <ComboBoxItem Content="XPRESS 8K (faster)" Tag="2"/>
                                        <ComboBoxItem Content="XPRESS 4K (fastest)" Tag="0"/>
                                    </ComboBox>
                                    <CheckBox x:Name="ChkSkipDirectStorage" Content="Skip DirectStorage games" IsChecked="True" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,2,16,2"/>
                                    <Button x:Name="BtnCompactAllGames" Content="Compress All" Style="{StaticResource HeaderActionButton}" Height="28" Padding="14,0" Margin="0,2,8,2" local:Gate.Requires="GameVaultAutoCompact" Click="OnCompactAllGames"/>
                                    <Button x:Name="BtnDecompressAllGames" Content="Restore All" Style="{StaticResource HeaderOutlineButton}" Height="28" Padding="14,0" Margin="0,2,0,2" Click="OnDecompressAllGames"/>
                                </WrapPanel>

                                <Border x:Name="GameVaultProgressPanel" Background="{DynamicResource BrandDarkPanelBrush}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,10" Visibility="Collapsed">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,6">
                                            <Button Content="Cancel" DockPanel.Dock="Right" Style="{StaticResource HeaderOutlineButton}" Height="24" Padding="10,0" Click="OnCancelGameCompact"/>
                                            <TextBlock x:Name="ProgressOperationTitle" Text="Working…" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                        </DockPanel>
                                        <ProgressBar x:Name="GameCompactProgressBar" Minimum="0" Maximum="100" Height="6" Foreground="{DynamicResource BrandCyanBrush}" Background="{DynamicResource BrushBorder}" BorderThickness="0"/>
                                        <TextBlock x:Name="ProgressCurrentFile" FontSize="11" FontFamily="{StaticResource FontMono}" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" Margin="0,6,0,2"/>
                                        <WrapPanel>
                                            <TextBlock x:Name="ProgressFilesText" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,16,0"/>
                                            <TextBlock x:Name="ProgressThroughputText" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,16,0"/>
                                            <TextBlock x:Name="ProgressSavedText" FontSize="11" Foreground="{DynamicResource SuccessGreenBrush}" Margin="0,0,16,0"/>
                                            <TextBlock x:Name="ProgressTimeText" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>

                                <TextBlock x:Name="GameVaultStatusLabel" Text="Scan your game libraries to see what can be compressed." FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8" TextWrapping="Wrap"/>

                                <Border x:Name="GameVaultEmptyState" Background="{DynamicResource BrandDarkPanelBrush}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="20,24">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="No games scanned yet" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Select “Scan Game Libraries” to find Steam, Epic, GOG and custom installs." FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <ItemsControl x:Name="GameVaultList" Visibility="Collapsed"/>
                            </StackPanel>
                        </Border>

                        <!-- Real-Time Storage Armor Action Feed (FIFO 500-Item Cap) -->
                        <Border Style="{StaticResource GlassPanel}" Padding="20,16">
                            <StackPanel>
                                <DockPanel LastChildFill="False" Margin="0,0,0,12">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" DockPanel.Dock="Left">
                                        <TextBlock Text="🛡️" FontSize="14" Foreground="{DynamicResource BrandCyanBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="REAL-TIME STORAGE ARMOR ACTION FEED" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                        <Border Background="{DynamicResource BrandDarkPanelBrush}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="4" Padding="6,1" Margin="10,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="FIFO 500-ENTRY CAP" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrandCyanBrush}"/>
                                        </Border>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                                        <Button Content="🗑 Clear Log" Style="{StaticResource HeaderOutlineButton}" Height="28" Padding="12,0" Click="OnClearHyperStoreFeedClick" Cursor="Hand" ToolTip="Clear activity stream"/>
                                    </StackPanel>
                                </DockPanel>

                                <!-- Action Feed Terminal Box -->
                                <Border Style="{StaticResource TerminalBoxStyle}" Height="300" Padding="12">
                                    <ListView x:Name="HyperStoreFeedList" ItemsSource="{Binding ActionFeed}" Background="Transparent" BorderThickness="0"
                                              ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                              ScrollViewer.CanContentScroll="False" PreviewMouseWheel="OnNestedListPreviewMouseWheel">
                                        <ListView.ItemContainerStyle>
                                            <Style TargetType="ListViewItem">
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Setter Property="BorderThickness" Value="0"/>
                                                <Setter Property="Padding" Value="0,3"/>
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                                <Setter Property="Focusable" Value="False"/>
                                            </Style>
                                        </ListView.ItemContainerStyle>
                                        <ListView.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="75"/>
                                                        <ColumnDefinition Width="70"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Timestamp -->
                                                    <TextBlock Grid.Column="0" Text="{Binding FormattedTimestamp}" FontFamily="{StaticResource FontMono}"
                                                               FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>

                                                    <!-- Category Tag Chip -->
                                                    <Border Grid.Column="1" Background="{Binding CategoryBrush}" CornerRadius="4" Padding="6,1" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding CategoryTag}" FontSize="11" FontWeight="Bold" Foreground="#0A0E1A"/>
                                                    </Border>

                                                    <!-- Message and Path -->
                                                    <TextBlock Grid.Column="2" Text="{Binding Message}" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}"
                                                               TextTrimming="CharacterEllipsis" Margin="8,0" VerticalAlignment="Center"/>

                                                    <!-- Exact Bytes Saved Badge -->
                                                    <Border Grid.Column="3" Background="#1810B981" BorderBrush="{DynamicResource SuccessGreenBrush}" BorderThickness="1"
                                                            CornerRadius="4" Padding="8,2" Visibility="{Binding SavedBadgeVisibility}">
                                                        <TextBlock Text="{Binding FormattedBytesSaved}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SuccessGreenBrush}"/>
                                                    </Border>
                                                </Grid>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </Border>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>

                <!-- ═══ Driver Hardware Inspection Modal Overlay ═══ -->
                <Border x:Name="DriverInspectModal" Visibility="Collapsed" Background="#CC0A0E1A">
                    <Border Background="{DynamicResource BrandDarkCardBrush}" BorderBrush="{DynamicResource BrandCyanBrush}" BorderThickness="1.5" CornerRadius="16" MaxWidth="680" MaxHeight="620" Margin="24" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Header -->
                            <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,16">
                                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="DRIVER HARDWARE TELEMETRY" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                    <Border x:Name="DriverInspectStatusBadge" Background="{DynamicResource BrandDarkPanelBrush}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBlock x:Name="DriverInspectStatusBadgeText" Text="CURRENT" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SuccessGreenBrush}"/>
                                    </Border>
                                </StackPanel>
                                <Button DockPanel.Dock="Right" Content="✕" Click="OnCloseDriverInspectModal" Style="{StaticResource HeaderOutlineButton}" Width="28" Height="28" Padding="0" VerticalAlignment="Center" ToolTip="Close Inspector"/>
                            </DockPanel>

                            <!-- Device Title & Manufacturer Banner -->
                            <Border Grid.Row="1" Background="{DynamicResource BrandDarkPanelBrush}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock x:Name="DriverInspectDeviceName" Text="Device Name" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <TextBlock Text="Manufacturer: " FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <TextBlock x:Name="DriverInspectManufacturer" Text="Unknown" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource BrandCyanBrush}"/>
                                        <TextBlock Text=" | Class: " FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="8,0,0,0"/>
                                        <TextBlock x:Name="DriverInspectClass" Text="Device" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Telemetry Details Strip -->
                            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" MaxHeight="300" Margin="0,0,0,14">
                                <StackPanel>
                                    <!-- 4-Column Metric Grid -->
                                    <Border Background="{DynamicResource BrandDarkPanelBrush}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,10">
                                        <UniformGrid Columns="4">
                                            <StackPanel Margin="4,0">
                                                <TextBlock Text="INSTALLED VERSION" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                <TextBlock x:Name="DriverInspectInstalledVersion" Text="10.0.0.0" FontSize="12" FontFamily="Consolas, monospace" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <StackPanel Margin="4,0">
                                                <TextBlock Text="DRIVER DATE" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                <TextBlock x:Name="DriverInspectDriverDate" Text="2024-01-01" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <StackPanel Margin="4,0">
                                                <TextBlock Text="AVAILABLE TARGET" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                <TextBlock x:Name="DriverInspectTargetVersion" Text="Up to date" FontSize="12" FontFamily="Consolas, monospace" FontWeight="SemiBold" Foreground="{DynamicResource SuccessGreenBrush}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <StackPanel Margin="4,0">
                                                <TextBlock Text="DIGITAL SIGNER" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                <TextBlock x:Name="DriverInspectSigner" Text="Microsoft / OEM" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </UniformGrid>
                                    </Border>

                                    <!-- Hardware ID Box with Copy Button -->
                                    <Border Background="{DynamicResource BrandDarkPanelBrush}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,10">
                                        <StackPanel>
                                            <DockPanel LastChildFill="False" Margin="0,0,0,4">
                                                <TextBlock Text="HARDWARE IDENTIFIER (HWID / PNP ID)" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" DockPanel.Dock="Left" VerticalAlignment="Center"/>
                                                <Button Content="📋 Copy HWID" Click="OnDriverInspectCopyHwid" Style="{StaticResource HeaderOutlineButton}" Height="22" Padding="8,0" FontSize="11" DockPanel.Dock="Right"/>
                                            </DockPanel>
                                            <TextBox x:Name="DriverInspectHwidBox" IsReadOnly="True" Background="{DynamicResource BrushBgTerminal}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" Foreground="{DynamicResource BrandCyanBrush}" FontFamily="Consolas, monospace" FontSize="11" Padding="8,6" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>

                            <!-- Guidance / Diagnostics Banner -->
                            <Border Grid.Row="3" x:Name="DriverInspectGuidanceBorder" Background="#1810B981" BorderBrush="{DynamicResource SuccessGreenBrush}" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,16">
                                <DockPanel LastChildFill="True">
                                    <TextBlock x:Name="DriverInspectGuidanceText" Text="🛡 Verified Hardware: Driver is signed and operating within nominal parameters." FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SuccessGreenBrush}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                </DockPanel>
                            </Border>

                            <!-- Actions Strip -->
                            <StackPanel Grid.Row="4">
                                <DockPanel LastChildFill="False">
                                    <Button Content="✕ Close" Click="OnCloseDriverInspectModal" Style="{StaticResource OutlineButton}" DockPanel.Dock="Left" Height="32" Padding="16,0" ToolTip="Dismiss driver details modal"/>
                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                        <Button x:Name="BtnDriverInspectFreeze" Content="🛡 Freeze Driver" Click="OnDriverInspectToggleFreeze" Style="{StaticResource OutlineButton}" Height="32" Padding="14,0" Margin="0,0,8,0" ToolTip="Pin this driver version to prevent automatic Windows Update overwrites and exclude it from LogicFlow audit alerts"/>
                                        <Button x:Name="BtnDriverInspectReinstall" Content="⟳ Restart Hardware Stack" local:Gate.Requires="Core" Click="OnDriverInspectReinstall" Style="{StaticResource OutlineButton}" Height="32" Padding="14,0" Margin="0,0,8,0" ToolTip="Rescans the Plug and Play bus and reloads the driver stack to resolve device errors without rebooting"/>
                                        <Button x:Name="BtnDriverInspectUpdate" Content="⚡ Download &amp; Install Update" local:Gate.Requires="Core" Click="OnDriverInspectUpdate" Style="{StaticResource ActionButton}" Height="32" Padding="14,0" ToolTip="Downloads and installs verified driver update with an automated System Restore checkpoint"/>
                                    </StackPanel>
                                </DockPanel>
                                <TextBlock Text="ℹ️ Restart Hardware Stack rescans the Plug and Play bus and reloads the driver stack to resolve device errors without rebooting."
                                           FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,8,0,0" TextWrapping="Wrap" HorizontalAlignment="Right"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Border>

                <!-- ═══ Lazarus In-Memory File Preview Modal Overlay (Elevated Glassmorphic) ═══ -->
                <Border x:Name="LazarusPreviewModal" Visibility="Collapsed" Background="#D8080C16">
                    <Border Background="{DynamicResource BrandDarkCardBrush}" BorderBrush="{DynamicResource BrandCyanBrush}" BorderThickness="1.5" CornerRadius="16" MaxWidth="920" MaxHeight="660" Margin="24" Padding="22" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Header -->
                            <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,14">
                                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Background="{DynamicResource BrandDarkPanelBrush}" BorderBrush="{DynamicResource BrandCyanBrush}" BorderThickness="1" CornerRadius="6" Padding="6,3" Margin="0,0,8,0" VerticalAlignment="Center">
                                        <TextBlock Text="🛡" FontSize="11" Foreground="{DynamicResource BrandCyanBrush}"/>
                                    </Border>
                                    <TextBlock Text="CARVED FILE FORENSIC PREVIEW" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                    <Border x:Name="PreviewTypeBadge" Background="{DynamicResource BrandDarkPanelBrush}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBlock x:Name="PreviewTypeBadgeText" Text="PNG" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrandCyanBrush}"/>
                                    </Border>
                                    <TextBlock x:Name="PreviewFileName" Text="carved_0x00021B40.png" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="10,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="360"/>
                                </StackPanel>
                                <Button DockPanel.Dock="Right" Content="✕" Click="OnClosePreviewModal" Style="{StaticResource HeaderOutlineButton}" Width="30" Height="30" Padding="0" VerticalAlignment="Center" ToolTip="Close Preview" Cursor="Hand" FontSize="12"/>
                            </DockPanel>

                            <!-- Metadata Strip (5 Proportional Glassmorphic Columns — wide METHOD pill) -->
                            <Border Grid.Row="1" Background="{DynamicResource BrandDarkPanelBrush}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="10" Padding="8,8" Margin="0,0,0,14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="0.95*"/>
                                        <ColumnDefinition Width="0.82*"/>
                                        <ColumnDefinition Width="0.78*"/>
                                        <ColumnDefinition Width="1.60*"/>
                                        <ColumnDefinition Width="0.95*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="{DynamicResource BrandGlassBrush}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="3,0">
                                        <StackPanel>
                                            <TextBlock Text="SECTOR OFFSET" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            <TextBlock x:Name="PreviewOffsetMetric" Text="0x00000000" FontSize="12" FontFamily="Consolas, monospace" FontWeight="SemiBold" Foreground="{DynamicResource BrandCyanBrush}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="1" Background="{DynamicResource BrandGlassBrush}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="3,0">
                                        <StackPanel>
                                            <TextBlock Text="ESTIMATED SIZE" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            <TextBlock x:Name="PreviewSizeMetric" Text="0 KB" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="2" Background="{DynamicResource BrandGlassBrush}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="3,0">
                                        <StackPanel>
                                            <TextBlock Text="CATEGORY" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            <TextBlock x:Name="PreviewCategoryMetric" Text="Images" FontSize="12" FontWeight="SemiBold" Foreground="#9333EA" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="3" Background="{DynamicResource BrandGlassBrush}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="3,0">
                                        <StackPanel>
                                            <TextBlock Text="METHOD" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            <TextBlock x:Name="PreviewMethodMetric" Text="Raw Sector Carving" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource WarningAmberBrush}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="4" Background="{DynamicResource BrandGlassBrush}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="3,0">
                                        <StackPanel>
                                            <TextBlock Text="CONFIDENCE" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            <TextBlock x:Name="PreviewConfidenceMetric" Text="High (100%)" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SuccessGreenBrush}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- Content Preview Viewport -->
                            <Border Grid.Row="2" Background="{DynamicResource BrushBgTerminal}" CornerRadius="10" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" MinHeight="260" MaxHeight="350" Margin="0,0,0,14" ClipToBounds="True">
                                <Grid>
                                    <!-- Mode Switcher in top-right with Pill Tabs -->
                                    <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,8,0" Panel.ZIndex="10" Background="{DynamicResource BrandDarkPanelBrush}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="3">
                                        <StackPanel x:Name="PreviewModeSwitch" Orientation="Horizontal">
                                            <Button x:Name="BtnPreviewVisualMode" Content="👁 Visual" Click="OnPreviewVisualModeClick" Style="{StaticResource HeaderOutlineButton}" Height="24" Padding="10,0" Margin="0,0,3,0" FontSize="11" Cursor="Hand"/>
                                            <Button x:Name="BtnPreviewStructureMode" Content="📄 Structure" Click="OnPreviewStructureModeClick" Style="{StaticResource HeaderOutlineButton}" Height="24" Padding="10,0" Margin="0,0,3,0" FontSize="11" Cursor="Hand"/>
                                            <Button x:Name="BtnPreviewHexMode" Content="🔢 Hex Dump" Click="OnPreviewHexModeClick" Style="{StaticResource HeaderOutlineButton}" Height="24" Padding="10,0" FontSize="11" Cursor="Hand"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Visual Image Thumbnail View with Checkerboard Transparency Grid -->
                                    <Grid x:Name="PreviewImageContainer" Visibility="Collapsed" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="8,40,8,8">
                                        <Border CornerRadius="8" ClipToBounds="True" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1">
                                            <Border.Background>
                                                <DrawingBrush Viewport="0,0,16,16" ViewportUnits="Absolute" TileMode="Tile">
                                                    <DrawingBrush.Drawing>
                                                        <DrawingGroup>
                                                            <GeometryDrawing Brush="#283244">
                                                                <GeometryDrawing.Geometry>
                                                                    <RectangleGeometry Rect="0,0,16,16"/>
                                                                </GeometryDrawing.Geometry>
                                                            </GeometryDrawing>
                                                            <GeometryDrawing Brush="#151B26">
                                                                <GeometryDrawing.Geometry>
                                                                    <GeometryGroup>
                                                                        <RectangleGeometry Rect="0,0,8,8"/>
                                                                        <RectangleGeometry Rect="8,8,8,8"/>
                                                                    </GeometryGroup>
                                                                </GeometryDrawing.Geometry>
                                                            </GeometryDrawing>
                                                        </DrawingGroup>
                                                    </DrawingBrush.Drawing>
                                                </DrawingBrush>
                                            </Border.Background>
                                            <Grid>
                                                <Image x:Name="PreviewImage" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="NearestNeighbor" MinHeight="140" MinWidth="140" MaxHeight="250" MaxWidth="580"/>
                                                <!-- Overlay specs badge -->
                                                <Border Background="{DynamicResource BrandDarkPanelBrush}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="6" Padding="10,4" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,8">
                                                    <TextBlock x:Name="PreviewImageSpecs" Text="Dimensions: 64 × 64 px | Format: PNG (TrueColor)" FontSize="11" Foreground="{DynamicResource BrandCyanBrush}" FontWeight="SemiBold"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </Grid>

                                    <!-- Structured Forensic Specification Card View (Glassmorphic) -->
                                    <ScrollViewer x:Name="PreviewForensicScroll" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="12,40,12,12" PreviewMouseWheel="OnNestedListPreviewMouseWheel">
                                        <StackPanel>
                                            <!-- Forensic Card Sub-Header -->
                                            <Border Background="{DynamicResource BrandDarkPanelBrush}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,10">
                                                <DockPanel LastChildFill="True">
                                                    <Border DockPanel.Dock="Left" Background="{DynamicResource BrandGlassBrush}" CornerRadius="6" Padding="6,3" Margin="0,0,8,0" VerticalAlignment="Center">
                                                        <TextBlock Text="🔬" FontSize="14"/>
                                                    </Border>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <DockPanel LastChildFill="False">
                                                            <TextBlock Text="FORENSIC CLUSTER SPECIFICATION" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" DockPanel.Dock="Left"/>
                                                            <Border x:Name="ForensicStatusBadgeBorder" DockPanel.Dock="Right" Background="#1810B981" BorderBrush="{DynamicResource SuccessGreenBrush}" BorderThickness="1" CornerRadius="4" Padding="6,1">
                                                                <TextBlock x:Name="ForensicCardStatusBadge" Text="SIGNATURE VERIFIED" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SuccessGreenBrush}"/>
                                                            </Border>
                                                        </DockPanel>
                                                        <TextBlock x:Name="ForensicCardSubtitle" Text="Bitstream checked against the LogicFlow file-signature catalog" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                </DockPanel>
                                            </Border>

                                            <!-- 2-Column Badges & Metrics Grid -->
                                            <UniformGrid Columns="2" Margin="0,0,0,10">
                                                <Border Background="{DynamicResource BrandGlassBrush}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="10,6" Margin="0,0,5,6">
                                                    <StackPanel>
                                                        <TextBlock Text="RECOVERED FILE NAME" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                        <DockPanel Margin="0,3,0,0" LastChildFill="True">
                                                            <Border x:Name="ForensicExtPill" Background="{DynamicResource BrandDarkPanelBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="3" Padding="5,1" Margin="0,0,6,0" VerticalAlignment="Center" DockPanel.Dock="Left">
                                                                <TextBlock x:Name="ForensicExtText" Text="ICO" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrandCyanBrush}"/>
                                                            </Border>
                                                            <TextBlock x:Name="ForensicFileNameText" Text="carved_0x00000042.ico" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                        </DockPanel>
                                                    </StackPanel>
                                                </Border>

                                                <Border Background="{DynamicResource BrandGlassBrush}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="10,6" Margin="5,0,0,6">
                                                    <StackPanel>
                                                        <TextBlock Text="FORMAT SPECIFICATION" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                        <TextBlock x:Name="ForensicFormatText" Text="Windows Icon Resource (.ico)" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource BrandCyanBrush}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                </Border>

                                                <Border Background="{DynamicResource BrandGlassBrush}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="10,6" Margin="0,0,5,6">
                                                    <StackPanel>
                                                        <TextBlock Text="SECTOR OFFSET &amp; LOCATION" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                        <TextBlock x:Name="ForensicOffsetDetailText" Text="0x00000042 (Sector 0)" FontSize="11" FontFamily="Consolas, monospace" FontWeight="SemiBold" Foreground="{DynamicResource BrandCyanBrush}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                </Border>

                                                <Border Background="{DynamicResource BrandGlassBrush}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="10,6" Margin="5,0,0,6">
                                                    <StackPanel>
                                                        <TextBlock Text="RECOVERY METHOD" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                        <TextBlock x:Name="ForensicMethodText" Text="Raw Sector Carving" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource WarningAmberBrush}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                </Border>

                                                <Border Background="{DynamicResource BrandGlassBrush}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="10,6" Margin="0,0,5,0">
                                                    <StackPanel>
                                                        <TextBlock Text="STREAM PAYLOAD SIZE" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                        <TextBlock x:Name="ForensicSizeDetailText" Text="524,288 bytes (512.0 KB)" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,3,0,0"/>
                                                    </StackPanel>
                                                </Border>

                                                <Border Background="{DynamicResource BrandGlassBrush}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="10,6" Margin="5,0,0,0">
                                                    <StackPanel>
                                                        <TextBlock Text="INTEGRITY CONFIDENCE" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                        <TextBlock x:Name="ForensicConfidenceDetailText" Text="Good (Signature Match)" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SuccessGreenBrush}" Margin="0,3,0,0"/>
                                                    </StackPanel>
                                                </Border>
                                            </UniformGrid>

                                            <!-- Magic Header Bytes Preview Strip -->
                                            <Border Background="{DynamicResource BrandDarkPanelBrush}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="10,7">
                                                <StackPanel>
                                                    <DockPanel LastChildFill="False" Margin="0,0,0,3">
                                                        <TextBlock Text="CLUSTER HEADER SIGNATURE BYTES" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" DockPanel.Dock="Left"/>
                                                        <TextBlock x:Name="ForensicMagicAsciiText" Text="ASCII: ...." FontSize="11" FontFamily="Consolas, monospace" Foreground="{DynamicResource TextSecondaryBrush}" DockPanel.Dock="Right"/>
                                                    </DockPanel>
                                                    <TextBox x:Name="ForensicHeaderHexBox" IsReadOnly="True" Background="Transparent" BorderThickness="0" FontFamily="Consolas, monospace" FontSize="11" Foreground="{DynamicResource BrandCyanBrush}" Padding="0" Text="00 00 01 00 ..."/>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </ScrollViewer>

                                    <!-- Text / Code Payload View -->
                                    <ScrollViewer x:Name="PreviewTextScroll" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Padding="12" Margin="0,36,0,0" PreviewMouseWheel="OnNestedListPreviewMouseWheel">
                                        <TextBox x:Name="PreviewTextBox" IsReadOnly="True" Background="Transparent" Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="Consolas, monospace" FontSize="11" BorderThickness="0" TextWrapping="Wrap"/>
                                    </ScrollViewer>

                                    <!-- Archive / Database / Document Structure View -->
                                    <ScrollViewer x:Name="PreviewStructureScroll" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Padding="12" Margin="0,36,0,0" PreviewMouseWheel="OnNestedListPreviewMouseWheel">
                                        <TextBox x:Name="PreviewStructureBox" IsReadOnly="True" Background="Transparent" Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="Consolas, monospace" FontSize="11" BorderThickness="0" TextWrapping="NoWrap"/>
                                    </ScrollViewer>

                                    <!-- 3-Column Hex Dump View -->
                                    <ScrollViewer x:Name="PreviewHexScroll" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Padding="12" Margin="0,36,0,0" PreviewMouseWheel="OnNestedListPreviewMouseWheel">
                                        <TextBox x:Name="PreviewHexBox" IsReadOnly="True" Background="Transparent" Foreground="{DynamicResource BrandCyanBrush}" FontFamily="Consolas, monospace" FontSize="11" BorderThickness="0" TextWrapping="NoWrap"/>
                                    </ScrollViewer>

                                    <!-- Fallback / Unsupported View -->
                                    <StackPanel x:Name="PreviewFallbackContainer" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20">
                                        <TextBlock Text="📦 BINARY PAYLOAD READY FOR RECOVERY" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Direct sector header validated. Switch to 'Hex Dump' above to inspect binary stream." FontSize="11" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Integrity Verdict Banner -->
                            <Border x:Name="PreviewVerdictBorder" Grid.Row="3" Background="#1810B981" BorderBrush="{DynamicResource SuccessGreenBrush}" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,14">
                                <DockPanel LastChildFill="False">
                                    <TextBlock x:Name="PreviewVerdictText" Text="🛡 Signature Verified: Valid cluster header structure confirmed in-memory." FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SuccessGreenBrush}" VerticalAlignment="Center"/>
                                </DockPanel>
                            </Border>

                            <!-- Actions Strip -->
                            <DockPanel Grid.Row="4" LastChildFill="False">
                                <Button Content="✕ Close" Click="OnClosePreviewModal" Style="{StaticResource OutlineButton}" DockPanel.Dock="Left" Height="32" Padding="16,0" Cursor="Hand"/>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button x:Name="BtnCopyHexDump" Content="📋 Copy Hex Dump" Click="OnCopyHexDumpClick" Style="{StaticResource HeaderOutlineButton}" Height="32" Padding="12,0" Margin="0,0,8,0" ToolTip="Copy formatted hex dump to clipboard" Cursor="Hand"/>
                                    <Button x:Name="BtnRecoverSinglePreview" Content="📂 Recover This File..." local:Gate.Requires="Core" Click="OnRecoverSinglePreviewFile" Style="{StaticResource ActionButton}" Height="32" Padding="16,0" Cursor="Hand"/>
                                </StackPanel>
                            </DockPanel>
                        </Grid>
                    </Border>
                </Border>

                <!-- ═══ Global Loading Overlay ═══ -->
                <Border x:Name="LoadingOverlay" Background="#CC0A0E1A" Visibility="Collapsed">
                    <Border Background="{DynamicResource BrandDarkCardBrush}" CornerRadius="20" Padding="40,32" 
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="40" ShadowDepth="8" Opacity="0.5" Color="Black"/>
                        </Border.Effect>
                        <StackPanel HorizontalAlignment="Center">
                            <!-- Spinning arc indicator -->
                            <Border x:Name="SpinnerRing" Width="48" Height="48" CornerRadius="24"
                                    BorderThickness="3" BorderBrush="{DynamicResource BrushBorder}"
                                    RenderTransformOrigin="0.5,0.5" Margin="0,0,0,20">
                                <Border.RenderTransform>
                                    <RotateTransform x:Name="SpinnerRotation" Angle="0"/>
                                </Border.RenderTransform>
                                <!-- Inner arc (cyan accent) -->
                                <Border Width="42" Height="42" CornerRadius="21"
                                        BorderThickness="3,0,0,3" 
                                        BorderBrush="{DynamicResource BrandCyanBrush}"
                                        HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock x:Name="LoadingText" Text="Scanning..." FontSize="16" FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="LoadingSubText" Text="" FontSize="12" 
                                       Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                            <ProgressBar x:Name="LoadingProgress" IsIndeterminate="True" Width="220" Height="4" Margin="0,16,0,0"
                                         Foreground="{DynamicResource BrandCyanBrush}" Background="{DynamicResource BrushBorder}"/>
                        </StackPanel>
                    </Border>
                </Border>
            </Grid>
        </Grid>
    </Grid>

</Window>
