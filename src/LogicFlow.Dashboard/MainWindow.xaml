<Window x:Class="LogicFlow.Dashboard.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:local="clr-namespace:LogicFlow.Dashboard"
    Title="LogicFlow" 
    Height="800" Width="1280" MinWidth="1024" MinHeight="700"
    WindowStartupLocation="CenterScreen" WindowStyle="None"
    Icon="pack://application:,,,/LogicFlow;component/Assets/Brand/shield_256.png"
    Background="{DynamicResource BrandDarkBrush}" AllowsTransparency="False"
    PreviewKeyDown="OnWindowPreviewKeyDown"
    SizeChanged="OnWindowSizeChanged"
    FontFamily="{StaticResource AppFont}">
    
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="-1"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- ═══ Elevated Lazarus Table Row Style (Generous Padding & Cyan Glass Hover) ═══ -->
        <Style x:Key="LazarusTableRowStyle" TargetType="ListViewItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="6,8"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border x:Name="rowBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="6"
                                Margin="0,1"
                                SnapsToDevicePixels="True">
                            <GridViewRowPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="rowBorder" Property="Background" Value="{DynamicResource BrushAccentGlow}"/>
                                <Setter TargetName="rowBorder" Property="BorderBrush" Value="{DynamicResource BrushAccentBorder}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="rowBorder" Property="Background" Value="{DynamicResource BrushAccentGlow}"/>
                                <Setter TargetName="rowBorder" Property="BorderBrush" Value="{DynamicResource BrandCyanBrush}"/>
                                <Setter TargetName="rowBorder" Property="BorderThickness" Value="2,0,0,1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="{DynamicResource BrandDarkBrush}">
        <Grid.LayoutTransform>
            <ScaleTransform x:Name="RootScaleTransform" ScaleX="1.0" ScaleY="1.0"/>
        </Grid.LayoutTransform>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarColumn" Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ═══ Sidebar Navigation ═══ -->
        <Border Grid.Column="0" Background="{DynamicResource BrandDarkPanelBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,1,0">
            <DockPanel>
                <StackPanel x:Name="SidebarHeaderPanel" DockPanel.Dock="Top" Margin="20,18,20,16">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="pack://application:,,,/LogicFlow;component/Assets/Brand/shield_64.png" Width="40" Height="40" Margin="0,0,10,0"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="LogicFlow" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="DelgadoLogic" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </StackPanel>
                    </StackPanel>
                    <Border x:Name="SidebarHeaderDivider" Height="2" Margin="0,14,0,0" CornerRadius="1" Background="{DynamicResource GradientAccent}"/>
                </StackPanel>

                <Border x:Name="SidebarEditionCard" DockPanel.Dock="Bottom" Margin="16,6,16,12" Padding="12,10" CornerRadius="10" Background="{DynamicResource BrandDarkCardBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="EditionDot" Width="8" Height="8" Fill="{DynamicResource BrandCyanBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock x:Name="LicenseLabel" Text="Free Edition" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </StackPanel>
                        <TextBlock x:Name="TrialLabel" Text="" FontSize="11" TextWrapping="Wrap" Visibility="Collapsed"
                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="16,3,0,0"/>
                        <Button x:Name="BtnUpgradeTier" Content="Upgrade to Pro" Style="{StaticResource ActionButton}" Height="32" Padding="12,0" Margin="0,8,0,0"
                                FontSize="12" Click="OnUpgradeClick" ToolTip="Pro: 3 devices, commercial use, background automation, advanced recovery"/>
                        <TextBlock x:Name="SidebarVersionText" Text="" FontSize="11" Visibility="Collapsed"
                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,8,0,0" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="SidebarNavStack" Margin="12,0,12,6">
                        <TextBlock x:Name="SidebarToolsHeader" Text="TOOLS" FontSize="11" FontWeight="Bold" Margin="8,0,0,6"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <Button x:Name="NavDashboard" Style="{StaticResource NavButtonActive}" Height="40" Padding="14,0" Click="OnNavDashboard" ToolTip="System overview and quick actions">
                            <TextBlock Text="Dashboard" FontSize="13"/>
                        </Button>
                        <Button x:Name="NavSentinel" Style="{StaticResource NavButton}" Height="40" Padding="14,0" Click="OnNavSentinel" ToolTip="Vulnerability scanning, network security, privacy">
                            <StackPanel><TextBlock Text="Security" FontSize="13"/><TextBlock x:Name="NavSentinelSub" Text="Sentinel" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/></StackPanel>
                        </Button>
                        <Button x:Name="NavGuardian" Style="{StaticResource NavButton}" Height="40" Padding="14,0" Click="OnNavGuardian" ToolTip="Turbo modes, drivers, bloatware, startup items, disk health, tweaks">
                            <StackPanel><TextBlock Text="Performance" FontSize="13"/><TextBlock x:Name="NavGuardianSub" Text="Guardian" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/></StackPanel>
                        </Button>
                        <Button x:Name="NavHyperStore" Style="{StaticResource NavButton}" Height="40" Padding="14,0" Click="OnNavHyperStore" ToolTip="Duplicate detection and deduplication, Game Vault compression, .lfc containers">
                            <StackPanel><TextBlock Text="Storage" FontSize="13"/><TextBlock x:Name="NavHyperStoreSub" Text="HyperStore" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/></StackPanel>
                        </Button>
                        <Button x:Name="NavMonitor" Style="{StaticResource NavButton}" Height="40" Padding="14,0" Click="OnNavMonitor" ToolTip="Live CPU, RAM, disk and network metrics">
                            <TextBlock Text="Resource Monitor" FontSize="13"/>
                        </Button>
                        <Button x:Name="NavToolbox" Style="{StaticResource NavButton}" Height="40" Padding="14,0" Click="OnNavToolbox" ToolTip="One-click maintenance, junk cleaner, memory optimizer, WinGet updater, shredder">
                            <TextBlock Text="Toolbox" FontSize="13"/>
                        </Button>
                        <Button x:Name="NavLazarus" Style="{StaticResource NavButton}" Height="40" Padding="14,0" Click="OnNavLazarus" ToolTip="Recover deleted files from drives and phones">
                            <StackPanel><TextBlock Text="Data Recovery" FontSize="13"/><TextBlock x:Name="NavLazarusSub" Text="Lazarus" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/></StackPanel>
                        </Button>
                        <Button x:Name="NavRegistry" Style="{StaticResource NavButton}" Height="40" Padding="14,0" Click="OnNavRegistry" ToolTip="Registry integrity analysis and repair">
                            <StackPanel><TextBlock Text="Registry" FontSize="13"/><TextBlock x:Name="NavRegistrySub" Text="Registry Surgeon" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/></StackPanel>
                        </Button>

                        <TextBlock x:Name="SidebarSystemHeader" Text="SYSTEM" FontSize="11" FontWeight="Bold" Margin="8,14,0,6"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <Button x:Name="NavSettings" Style="{StaticResource NavButton}" Height="40" Padding="14,0" Click="OnNavSettings" ToolTip="Appearance, tray behavior, exclusions, AI privacy, edition, and backup">
                            <TextBlock Text="Settings" FontSize="13"/>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ═══ Main Content Area ═══ -->
        <Grid Grid.Column="1" Background="{DynamicResource BrandDarkBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Title Bar -->
            <Border Grid.Row="0" Background="{DynamicResource BrandDarkPanelBrush}" Padding="20,0,0,0" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,0,1">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top"
                                WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button x:Name="BtnRestartAdmin" Content="🛡 Restart as Admin" Style="{StaticResource HeaderOutlineButton}"
                                Height="28" Padding="10,0" Margin="0,6,8,0" VerticalAlignment="Center" Visibility="Collapsed"
                                Click="OnRestartAsAdminClick"
                                ToolTip="Relaunch LogicFlow elevated as Administrator to unlock raw disk carving, ASR rules, and driver maintenance"/>
                        <Button x:Name="BtnTitleHelp" Content="❓ Help (F1)" Style="{StaticResource HeaderOutlineButton}"
                                Height="28" Padding="10,0" Margin="0,6,8,0" VerticalAlignment="Center"
                                Click="OnHelpButtonClick"
                                ToolTip="Offline Quick-Start Guide, Keyboard Shortcuts &amp; /boost CLI Reference (F1)"/>
                        <Button Style="{StaticResource ChromeButton}" Click="OnMinimize" ToolTip="Minimize">
                            <Path Width="10" Height="1" Data="M 0,0.5 L 10,0.5" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1" SnapsToDevicePixels="True"/>
                        </Button>
                        <Button x:Name="MaximizeButton" Style="{StaticResource ChromeButton}" Click="OnMaximize" ToolTip="Maximize (hover for Snap Layouts)">
                            <Path x:Name="MaximizePath" Width="10" Height="10" Data="M 0.5,0.5 H 9.5 V 9.5 H 0.5 Z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1" SnapsToDevicePixels="True"/>
                        </Button>
                        <Button Style="{StaticResource ChromeCloseButton}" Click="OnClose" ToolTip="Close">
                            <Path Width="10" Height="10" Data="M 0.5,0.5 L 9.5,9.5 M 9.5,0.5 L 0.5,9.5" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.1" SnapsToDevicePixels="True"/>
                        </Button>
                    </StackPanel>
                    <DockPanel LastChildFill="True" VerticalAlignment="Center" Margin="0,0,10,0">
                        <Border x:Name="PageBadge" DockPanel.Dock="Right" Background="{DynamicResource BrandDarkCardBrush}" CornerRadius="6" Padding="8,3" Margin="10,0,0,0" VerticalAlignment="Center" Visibility="Collapsed">
                            <TextBlock x:Name="PageBadgeText" Text="" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource BrandCyanBrush}"/>
                        </Border>
                        <TextBlock x:Name="PageTitle" Text="System Dashboard" FontSize="16" FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                    </DockPanel>
                </DockPanel>
            </Border>

            <!-- ═══ Page Panels (swap visibility) ═══ -->
            <Grid Grid.Row="1">

                <!-- ──── Dashboard Page ──── -->
                <ScrollViewer x:Name="PageDashboard" VerticalScrollBarVisibility="Auto" Padding="24">
                    <StackPanel Opacity="1">
                        <StackPanel.RenderTransform>
                            <TranslateTransform x:Name="DashboardTranslate" X="0" Y="0"/>
                        </StackPanel.RenderTransform>

                        <!-- Status-First At-a-Glance Bar + 1-Click Desktop Shortcuts -->
                        <Border x:Name="StatusFirstOverviewBar" Style="{StaticResource GlassPanel}" Padding="16,12" Margin="0,0,0,16">
                            <Grid x:Name="OverviewBarGrid">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid x:Name="OverviewTextGrid" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="34" Height="34" CornerRadius="9" Background="{DynamicResource BrushAccentGlow}" BorderBrush="{DynamicResource BrandCyanBrush}" BorderThickness="1" Margin="0,0,12,0" VerticalAlignment="Center">
                                        <TextBlock x:Name="OverviewShieldIcon" Text="🛡" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource BrandCyanBrush}"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock x:Name="OverviewHeadlineText" Text="System Protection &amp; Optimization Ready" FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                                        <TextBlock x:Name="OverviewSublineText" Text="Boost Mode: Standby (/boost ready) · All telemetry &amp; scans local-first unless opted in" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Grid>
                                <WrapPanel x:Name="OverviewShortcutsWrap" Grid.Row="0" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="12,0,0,0">
                                    <Button x:Name="BtnCreateBoostShortcut" Content="🚀 Create /boost Shortcut" Style="{StaticResource HeaderOutlineButton}"
                                            Height="28" Padding="10,0" Margin="0,2,6,2" Click="OnCreateBoostShortcutClick"
                                            ToolTip="Create a 1-click Boost Mode shortcut (LogicFlow.exe /boost) on your Desktop — toggles silently in the tray without stealing focus"/>
                                    <Button x:Name="BtnCreateCleanShortcut" Content="🧹 Create 1-Click Clean Shortcut" Style="{StaticResource HeaderOutlineButton}"
                                            Height="28" Padding="10,0" Margin="0,2,0,2" Click="OnCreateCleanShortcutClick"
                                            ToolTip="Create a headless 1-Click Maintenance shortcut (LogicFlow.exe --auto-maintenance) on your Desktop"/>
                                </WrapPanel>
                            </Grid>
                        </Border>

                        <!-- Top Mini Stats Row (Symmetric 18px Padding, Bold 24px Counters, 6px Capsule Progress Bars with Glow) -->
                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <!-- 1. CPU Active Card -->
                            <Border Style="{StaticResource MetricGlassCardStyle}" Margin="0,0,6,0" Grid.Column="0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="⚡ " FontSize="12" Foreground="{DynamicResource BrandCyanBrush}"/>
                                            <TextBlock Text="CPU ACTIVE" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        </StackPanel>
                                        <TextBlock x:Name="MiniCpuSub" Grid.Column="1" Margin="6,0,0,0" Text="Processor" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                                    </Grid>
                                    <DockPanel Grid.Row="1" Margin="0,8,0,0">
                                        <TextBlock x:Name="MiniCpuText" Text="0%" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource BrandCyanBrush}" VerticalAlignment="Bottom"/>
                                        <TextBlock x:Name="MiniCpuDetail" DockPanel.Dock="Right" Text="Active" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,0,2"/>
                                    </DockPanel>
                                    <!-- Sleek 6px Capsule Progress Bar with Neon Cyan Glow -->
                                    <ProgressBar x:Name="MiniCpuBar" Grid.Row="2" Height="6" Margin="0,10,0,0"
                                                 Foreground="{DynamicResource BrandCyanBrush}" Background="{DynamicResource BorderSubtleBrush}"
                                                 Value="0" Minimum="0" Maximum="100">
                                        <ProgressBar.Effect>
                                            <DropShadowEffect BlurRadius="8" ShadowDepth="0" Color="{StaticResource BrandCyan}" Opacity="0.55"/>
                                        </ProgressBar.Effect>
                                    </ProgressBar>
                                </Grid>
                            </Border>

                            <!-- 2. RAM Active Card -->
                            <Border Style="{StaticResource MetricGlassCardStyle}" Margin="3,0,3,0" Grid.Column="1">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="🧠 " FontSize="12" Foreground="{StaticResource BrandPurpleBrush}"/>
                                            <TextBlock Text="RAM ACTIVE" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        </StackPanel>
                                        <TextBlock x:Name="MiniRamSub" Grid.Column="1" Margin="6,0,0,0" Text="Physical RAM" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                                    </Grid>
                                    <DockPanel Grid.Row="1" Margin="0,8,0,0">
                                        <TextBlock x:Name="MiniRamText" Text="0%" FontSize="24" FontWeight="Bold" Foreground="{StaticResource BrandPurpleBrush}" VerticalAlignment="Bottom"/>
                                        <TextBlock x:Name="MiniRamDetail" DockPanel.Dock="Right" Text="Memory" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,0,2"/>
                                    </DockPanel>
                                    <!-- Sleek 6px Capsule Progress Bar with Vibrant Violet Glow -->
                                    <ProgressBar x:Name="MiniRamBar" Grid.Row="2" Height="6" Margin="0,10,0,0"
                                                 Foreground="{StaticResource BrandPurpleBrush}" Background="{DynamicResource BorderSubtleBrush}"
                                                 Value="0" Minimum="0" Maximum="100">
                                        <ProgressBar.Effect>
                                            <DropShadowEffect BlurRadius="8" ShadowDepth="0" Color="{StaticResource BrandPurple}" Opacity="0.55"/>
                                        </ProgressBar.Effect>
                                    </ProgressBar>
                                </Grid>
                            </Border>

                            <!-- 3. Disk Usage Card -->
                            <Border Style="{StaticResource MetricGlassCardStyle}" Margin="6,0,0,0" Grid.Column="2">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="💾 " FontSize="12" Foreground="{DynamicResource SuccessGreenBrush}"/>
                                            <TextBlock Text="DISK USAGE" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        </StackPanel>
                                        <TextBlock x:Name="MiniDiskSub" Grid.Column="1" Margin="6,0,0,0" Text="System Drive" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                                    </Grid>
                                    <DockPanel Grid.Row="1" Margin="0,8,0,0">
                                        <TextBlock x:Name="MiniDiskText" Text="0%" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource SuccessGreenBrush}" VerticalAlignment="Bottom"/>
                                        <TextBlock x:Name="MiniDiskDetail" DockPanel.Dock="Right" Text="Storage" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,0,2"/>
                                    </DockPanel>
                                    <!-- Sleek 6px Capsule Progress Bar with Emerald Glow -->
                                    <ProgressBar x:Name="MiniDiskBar" Grid.Row="2" Height="6" Margin="0,10,0,0"
                                                 Foreground="{DynamicResource SuccessGreenBrush}" Background="{DynamicResource BorderSubtleBrush}"
                                                 Value="0" Minimum="0" Maximum="100">
                                        <ProgressBar.Effect>
                                            <DropShadowEffect BlurRadius="8" ShadowDepth="0" Color="{StaticResource SuccessGreen}" Opacity="0.55"/>
                                        </ProgressBar.Effect>
                                    </ProgressBar>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- 2-Column Overview Grid (stacks to 1 column when logical content width < 680px) -->
                        <Grid x:Name="DashboardOverviewGrid">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Column 1: Health Summary + Pulse AI Agent -->
                            <StackPanel x:Name="DashboardColLeft" Grid.Column="0" Grid.Row="0" Margin="0,0,16,0">
                                
                                <!-- System Health Summary Card -->
                                <Border Style="{StaticResource GlassPanel}" Margin="0,0,0,20">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <!-- Circular Dial -->
                                        <Grid Grid.Column="0" Width="96" Height="96" Margin="0,0,12,0">
                                            <ui:ProgressRing x:Name="HealthProgressRing" Progress="85" BorderThickness="6" Foreground="{DynamicResource BrandCyanBrush}" Width="90" Height="90"/>
                                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                <TextBlock x:Name="HealthScoreLabel" Text="85%" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                <TextBlock Text="Health Score" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Hardware Specs & Info -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="SYSTEM HEALTH SUMMARY" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Hardware:" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,8,4"/>
                                                <TextBlock x:Name="HealthHardwareLabel" Grid.Row="0" Grid.Column="1" Text="Windows PC / Hardware Active" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>

                                                <TextBlock Grid.Row="1" Grid.Column="0" Text="OS:" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,8,4"/>
                                                <TextBlock x:Name="HealthOsLabel" Grid.Row="1" Grid.Column="1" Text="Windows 11" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>

                                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Active Monitor:" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,8,4"/>
                                                <TextBlock x:Name="HealthMonitorLabel" Grid.Row="2" Grid.Column="1" Text="Guardian active, monitoring drivers" Foreground="{DynamicResource SuccessGreenBrush}" Margin="0,0,0,4" TextWrapping="Wrap" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>

                                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Status Detail:" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,8,0"/>
                                                <TextBlock x:Name="HealthScoreSub" Grid.Row="3" Grid.Column="1" Text="Grade: Excellent" Foreground="{DynamicResource BrandCyanBrush}" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                                            </Grid>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Pulse AI Agent Diagnostic Card -->
                                <Border x:Name="PulseAiDashboardCard" Style="{StaticResource GlassPanel}" Margin="0,0,0,20">
                                    <StackPanel>
                                        <WrapPanel VerticalAlignment="Center" Margin="0,0,0,12">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,2,12,4">
                                                <TextBlock Text="✨" FontSize="16" Foreground="{DynamicResource BrandCyanBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="PULSE LOCAL DIAGNOSTIC ASSISTANT" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <Border Background="{DynamicResource BrushAccentGlow}" BorderThickness="1" BorderBrush="{DynamicResource BrandCyanBrush}" CornerRadius="12" Padding="10,4" VerticalAlignment="Center" Margin="0,2,0,4">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Ellipse Width="6" Height="6" Fill="{DynamicResource BrandCyanBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                    <TextBlock x:Name="PulseAiPrivacyBadgeText" Text="Runs locally on this PC" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource BrandCyanBrush}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                        </WrapPanel>

                                        <!-- Terminal Output -->
                                        <Border Style="{StaticResource TerminalBoxStyle}" Height="200" Margin="0,0,0,12">
                                            <ListView x:Name="AiTerminalList" Background="Transparent" BorderThickness="0" 
                                                      ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                      ScrollViewer.CanContentScroll="False"
                                                      PreviewMouseWheel="OnNestedListPreviewMouseWheel">
                                                <ListView.ItemContainerStyle>
                                                    <Style TargetType="ListViewItem">
                                                        <Setter Property="Background" Value="Transparent"/>
                                                        <Setter Property="BorderThickness" Value="0"/>
                                                        <Setter Property="Padding" Value="0,2"/>
                                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                                        <Setter Property="Focusable" Value="False"/>
                                                    </Style>
                                                </ListView.ItemContainerStyle>
                                            </ListView>
                                        </Border>

                                        <!-- Input Row -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="PulseInput" Style="{StaticResource TerminalInputStyle}" 
                                                     KeyDown="OnPulseInputKeyDown" Grid.Column="0" Margin="0,0,8,0"
                                                     VerticalContentAlignment="Center" Padding="12,8"
                                                     ToolTip="Ask Pulse about CPU, RAM, GPU, disk speed, battery, security, or system optimization..."/>
                                            <Button x:Name="BtnPulseAsk" Content="Ask Agent" Style="{StaticResource ActionButton}" Click="OnPulseAskClick" Grid.Column="1" Padding="20,10" ToolTip="Submit query to Pulse local diagnostic assistant"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- Column 2: Quick Actions + High-Impact Processes -->
                            <StackPanel x:Name="DashboardColRight" Grid.Column="1" Grid.Row="0">
                                
                                <!-- Quick Actions Card -->
                                <Border Style="{StaticResource GlassPanel}" Margin="0,0,0,20">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,12">
                                            <TextBlock Text="QUICK ACTIONS" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                            <TextBlock Text="Instant Diagnostics &amp; Tuning" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        </DockPanel>
                                        
                                        <!-- Balanced 2-Column Responsive Grid (Uniform 44px Height, Centered Typography & Semantic Icons) -->
                                        <UniformGrid Columns="2">
                                            <!-- 1. 1-Click Optimize (Primary Hero Action) -->
                                            <Button x:Name="BtnQuickOneClick" Style="{StaticResource QuickActionButtonStyle}"
                                                    Height="44" Margin="4" local:Gate.Requires="Core" Click="OnOneClickOptimize"
                                                    Background="#1500C853" BorderBrush="#4000C853"
                                                    ToolTip="Run automated 1-Click system maintenance, junk clean, and RAM optimization">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock Text="🎯" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="1-Click Optimize" FontSize="11.5" FontWeight="Bold" Foreground="#22C55E" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>

                                            <!-- 2. Security Scan -->
                                            <Button x:Name="BtnQuickSecurity" Style="{StaticResource QuickActionButtonStyle}"
                                                    Height="44" Margin="4" Click="OnQuickSecurityScan"
                                                    Background="#1200E5FF" BorderBrush="#3300E5FF"
                                                    ToolTip="Deep vulnerability audit, open port inspection, and threat analysis">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock Text="🛡" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="Security Scan" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>

                                            <!-- 3. Performance Scan -->
                                            <Button x:Name="BtnQuickPerf" Style="{StaticResource QuickActionButtonStyle}"
                                                    Height="44" Margin="4" Click="OnQuickPerfScan"
                                                    Background="#12F59E0B" BorderBrush="#33F59E0B"
                                                    ToolTip="Scan hardware drivers, high-impact startup items, and bottlenecks">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock Text="⚡" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="Performance Scan" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>

                                            <!-- 4. Clean Junk Files -->
                                            <Button x:Name="BtnQuickJunk" Style="{StaticResource QuickActionButtonStyle}"
                                                    Height="44" Margin="4" local:Gate.Requires="Core" Click="OnQuickJunkClean"
                                                    Background="#128B5CF6" BorderBrush="#338B5CF6"
                                                    ToolTip="Parallel junk cleaner for temp files, crash dumps, and caches">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock Text="🧹" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="Clean Junk Files" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>

                                            <!-- 5. Optimize RAM -->
                                            <Button x:Name="BtnQuickMemory" Style="{StaticResource QuickActionButtonStyle}"
                                                    Height="44" Margin="4" local:Gate.Requires="Core" Click="OnQuickMemoryOptimize"
                                                    Background="#12A855F7" BorderBrush="#33A855F7"
                                                    ToolTip="Flush working sets and reclaim inactive memory across processes">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock Text="🧠" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="Optimize RAM" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>

                                            <!-- 6. Fix Registry -->
                                            <Button x:Name="BtnQuickRegistry" Style="{StaticResource QuickActionButtonStyle}"
                                                    Height="44" Margin="4" Click="OnQuickRegistryScan"
                                                    Background="#1238BDF8" BorderBrush="#3338BDF8"
                                                    ToolTip="Scan for orphaned COM, broken paths, and registry inconsistencies">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock Text="🔧" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="Fix Registry" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>

                                            <!-- 7. Turbo Mode -->
                                            <Button x:Name="BtnQuickTurbo" Style="{StaticResource QuickActionButtonStyle}"
                                                    Height="44" Margin="4" Click="OnToggleTurbo"
                                                    Background="#18FF6F00" BorderBrush="#40FF6F00"
                                                    ToolTip="Toggle Boost Mode: trims RAM working sets, boosts foreground app priority, switches power plan, and terminates non-essential background bloat (also available via LogicFlow.exe /boost)">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock x:Name="QuickTurboIcon" Text="🚀" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                    <TextBlock x:Name="QuickTurboText" Text="Turbo / Boost" FontSize="11.5" FontWeight="Bold" Foreground="#FF6F00" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                            </Button>

                                            <!-- 8. Run All Scans -->
                                            <Button x:Name="BtnQuickAllScans" Style="{StaticResource QuickActionButtonStyle}"
                                                    Height="44" Margin="4" Click="OnRunAllScans"
                                                    Background="#1500E5FF" BorderBrush="#407C4DFF"
                                                    ToolTip="Execute security, performance, and registry scans in sequence">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock Text="📊" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="Run All Scans" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                        </UniformGrid>

                                        <!-- Quick Action Live Result Banner -->
                                        <Border x:Name="QuickActionResultBar" Visibility="Collapsed" Margin="4,10,4,0" 
                                                Background="{DynamicResource BrandDarkPanelBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" 
                                                CornerRadius="10" Padding="12,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                
                                                <TextBlock x:Name="QuickActionResultIcon" Grid.Column="0" Text="✅" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                                
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock x:Name="QuickActionResultTitle" Text="Quick Action Complete" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                    <TextBlock x:Name="QuickActionResultDetail" Text="Summary of operation results." FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                                </StackPanel>
                                                
                                                <Button x:Name="BtnQuickActionDetail" Grid.Column="2" Content="View Details" Style="{StaticResource ActionButton}" 
                                                        Padding="10,4" Margin="8,0,4,0" FontSize="11" Height="26" VerticalAlignment="Center" Click="OnQuickActionDetailClick"
                                                        ToolTip="Navigate to the module details and full inspection results for this quick action"/>
                                                        
                                                <Button Grid.Column="3" Content="✕" Style="{StaticResource OutlineButton}" 
                                                        Width="24" Height="24" Padding="0" FontSize="11" Margin="4,0,0,0" VerticalAlignment="Center" Click="OnDismissQuickActionResult" ToolTip="Dismiss"/>
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <!-- High-Impact Running Processes Card -->
                                <Border Style="{StaticResource GlassPanel}" Margin="0,0,0,20">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,12" LastChildFill="True">
                                            <Button Content="🔄 Refresh" Style="{StaticResource HeaderOutlineButton}" Height="26" MinWidth="84" Padding="10,0" Margin="8,0,0,0" FontSize="11" Click="OnRefreshProcessesClick" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                    ToolTip="Refresh active running processes list, CPU utilization, and memory working sets"/>
                                            <WrapPanel VerticalAlignment="Center">
                                                <TextBlock Text="HIGH-IMPACT RUNNING PROCESSES" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,12,0" TextWrapping="Wrap"/>
                                                <TextBlock x:Name="ProcessesStatusText" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                            </WrapPanel>
                                        </DockPanel>

                                        <!-- Processes Table (ListView with GridView) -->
                                        <ListView x:Name="ProcessesListView" Background="Transparent" BorderThickness="0" MaxHeight="250"
                                                  Padding="0" Margin="0"
                                                  ItemContainerStyle="{StaticResource DashboardTableRowStyle}"
                                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                  Loaded="ProcessesListView_Loaded"
                                                  SizeChanged="ProcessesListView_SizeChanged"
                                                  PreviewMouseWheel="OnNestedListPreviewMouseWheel">
                                            <ListView.ContextMenu>
                                                <ContextMenu Style="{StaticResource DarkGlassContextMenu}">
                                                    <MenuItem Header="📁 Open File Location" Style="{StaticResource DarkGlassMenuItem}" Click="OnOpenProcessLocation"/>
                                                    <MenuItem Header="⏸ Freeze Process (Suspend)" Style="{StaticResource DarkGlassMenuItem}" Click="OnContextMenuSuspendProcess"/>
                                                    <MenuItem Header="▶ Resume Process" Style="{StaticResource DarkGlassMenuItem}" Click="OnContextMenuResumeProcess"/>
                                                    <Separator Background="{DynamicResource BorderSubtleBrush}"/>
                                                    <MenuItem Header="⚡ Set Priority: High" Style="{StaticResource DarkGlassMenuItem}" local:Gate.Requires="Core" Click="OnSetHighPriority"/>
                                                    <MenuItem Header="⚡ Set Priority: Normal" Style="{StaticResource DarkGlassMenuItem}" local:Gate.Requires="Core" Click="OnSetNormalPriority"/>
                                                    <MenuItem Header="⚡ Set Priority: Low" Style="{StaticResource DarkGlassMenuItem}" local:Gate.Requires="Core" Click="OnSetLowPriority"/>
                                                    <Separator Background="{DynamicResource BorderSubtleBrush}"/>
                                                    <MenuItem Header="🎯 CPU Affinity: All Cores" Style="{StaticResource DarkGlassMenuItem}" local:Gate.Requires="Core" Click="OnSetAffinityAll"/>
                                                    <MenuItem Header="🎯 CPU Affinity: Performance Cores" Style="{StaticResource DarkGlassMenuItem}" local:Gate.Requires="Core" Click="OnSetAffinityPCores"/>
                                                    <MenuItem Header="🎯 CPU Affinity: Single Core (Core 0)" Style="{StaticResource DarkGlassMenuItem}" local:Gate.Requires="Core" Click="OnSetAffinitySingle"/>
                                                    <Separator Background="{DynamicResource BorderSubtleBrush}"/>
                                                    <MenuItem Header="❌ Terminate Process" Style="{StaticResource DarkGlassMenuItem}" local:Gate.Requires="Core" Click="OnContextMenuTerminateProcess"/>
                                                </ContextMenu>
                                            </ListView.ContextMenu>
                                            <ListView.View>
                                                <GridView ColumnHeaderContainerStyle="{StaticResource DashboardTableHeaderStyle}">
                                                    <GridViewColumn Header="Process Name" Width="110">
                                                        <GridViewColumn.HeaderContainerStyle>
                                                            <Style TargetType="GridViewColumnHeader" BasedOn="{StaticResource DashboardTableHeaderStyle}">
                                                                <Setter Property="Padding" Value="6,8,4,8"/>
                                                            </Style>
                                                        </GridViewColumn.HeaderContainerStyle>
                                                        <GridViewColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" Margin="2,0,0,0"/>
                                                            </DataTemplate>
                                                        </GridViewColumn.CellTemplate>
                                                    </GridViewColumn>
                                                    <GridViewColumn Header="CPU %" Width="52">
                                                        <GridViewColumn.HeaderContainerStyle>
                                                            <Style TargetType="GridViewColumnHeader" BasedOn="{StaticResource DashboardTableHeaderStyle}">
                                                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                                                <Setter Property="Padding" Value="2,8"/>
                                                            </Style>
                                                        </GridViewColumn.HeaderContainerStyle>
                                                        <GridViewColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Text="{Binding CpuFormatted}" Foreground="{DynamicResource BrandCyanBrush}" HorizontalAlignment="Center" TextAlignment="Center"/>
                                                            </DataTemplate>
                                                        </GridViewColumn.CellTemplate>
                                                    </GridViewColumn>
                                                    <GridViewColumn Header="RAM" Width="62">
                                                        <GridViewColumn.HeaderContainerStyle>
                                                            <Style TargetType="GridViewColumnHeader" BasedOn="{StaticResource DashboardTableHeaderStyle}">
                                                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                                                <Setter Property="Padding" Value="2,8"/>
                                                            </Style>
                                                        </GridViewColumn.HeaderContainerStyle>
                                                        <GridViewColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Text="{Binding MemoryFormatted}" Foreground="{StaticResource BrandPurpleBrush}" HorizontalAlignment="Center" TextAlignment="Center"/>
                                                            </DataTemplate>
                                                        </GridViewColumn.CellTemplate>
                                                    </GridViewColumn>
                                                    <GridViewColumn Header="Actions" Width="106">
                                                        <GridViewColumn.HeaderContainerStyle>
                                                            <Style TargetType="GridViewColumnHeader" BasedOn="{StaticResource DashboardTableHeaderStyle}">
                                                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                                                <Setter Property="Padding" Value="2,8"/>
                                                            </Style>
                                                        </GridViewColumn.HeaderContainerStyle>
                                                        <GridViewColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                                    <Button Content="{Binding FreezeButtonText}" Click="OnToggleSuspendProcess" 
                                                                            Style="{StaticResource ProcessFreezeButton}" Margin="0,0,4,0"
                                                                            ToolTip="Freeze or Resume process execution"/>
                                                                    <Button Content="Kill" local:Gate.Requires="Core" Click="OnTerminateProcess" 
                                                                            Style="{StaticResource ProcessKillButton}"
                                                                            ToolTip="Terminate process immediately"/>
                                                                </StackPanel>
                                                            </DataTemplate>
                                                        </GridViewColumn.CellTemplate>
                                                    </GridViewColumn>
                                                </GridView>
                                            </ListView.View>
                                        </ListView>
                                        <!-- Empty State for Running Processes -->
                                        <Border x:Name="ProcessesEmptyState" Visibility="Collapsed" Background="{DynamicResource BrandDarkPanelBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="20,16" Margin="0,4,0,0">
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock Text="⚡" FontSize="20" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                                <TextBlock Text="No high-impact processes detected" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                                                <TextBlock Text="All system processes are operating within normal resource thresholds." FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>

                <!-- ──── Sentinel Page ──── -->
                <ScrollViewer x:Name="PageSentinel" VerticalScrollBarVisibility="Auto" Padding="24" Visibility="Collapsed">
                    <StackPanel x:Name="SentinelContent" Opacity="0">
                        <StackPanel.RenderTransform>
                            <TranslateTransform X="0" Y="0"/>
                        </StackPanel.RenderTransform>
                        <!-- ──── Sentinel Security Center Hero Banner with Breathing Shield ──── -->
                        <Border Style="{StaticResource GlassPanel}" Margin="0,0,0,20" Background="{DynamicResource BrandDarkPanelBrush}" BorderBrush="{DynamicResource BrushAccentBorder}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Sentinel Breathing Shield Emblem -->
                                <Border x:Name="ShieldEmblemBorder" Grid.Column="0" Width="64" Height="64" CornerRadius="16" Background="{DynamicResource BrushAccentGlow}"
                                        BorderBrush="{DynamicResource BrandCyanBrush}" BorderThickness="1.5"
                                        Margin="0,0,20,0" RenderTransformOrigin="0.5,0.5">
                                    <Border.RenderTransform>
                                        <ScaleTransform ScaleX="1.0" ScaleY="1.0"/>
                                    </Border.RenderTransform>
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="14" ShadowDepth="0" Color="#00E5FF" Opacity="0.4"/>
                                    </Border.Effect>
                                    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <!-- Vector Shield Glyph -->
                                        <Path Data="M 0,0 L 22,0 C 22,14 11,26 0,30 C -11,26 -22,14 -22,0 Z"
                                              Stroke="{DynamicResource BrandCyanBrush}" StrokeThickness="2"
                                              Fill="{DynamicResource BrushAccentGlow}" Width="36" Height="36" Stretch="Uniform"/>
                                        <TextBlock Text="🛡" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource BrandCyanBrush}"/>
                                    </Grid>
                                    <Border.Triggers>
                                        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                            <BeginStoryboard x:Name="ShieldBreathingStoryboard">
                                                <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                    <DoubleAnimation Storyboard.TargetName="ShieldEmblemBorder"
                                                                     Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.BlurRadius)"
                                                                     From="12" To="32" Duration="0:0:1.8">
                                                        <DoubleAnimation.EasingFunction>
                                                            <SineEase EasingMode="EaseInOut"/>
                                                        </DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                    <DoubleAnimation Storyboard.TargetName="ShieldEmblemBorder"
                                                                     Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.Opacity)"
                                                                     From="0.30" To="0.85" Duration="0:0:1.8">
                                                        <DoubleAnimation.EasingFunction>
                                                            <SineEase EasingMode="EaseInOut"/>
                                                        </DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                    <DoubleAnimation Storyboard.TargetName="ShieldEmblemBorder"
                                                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                                     From="1.0" To="1.035" Duration="0:0:1.8">
                                                        <DoubleAnimation.EasingFunction>
                                                            <SineEase EasingMode="EaseInOut"/>
                                                        </DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                    <DoubleAnimation Storyboard.TargetName="ShieldEmblemBorder"
                                                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                                     From="1.0" To="1.035" Duration="0:0:1.8">
                                                        <DoubleAnimation.EasingFunction>
                                                            <SineEase EasingMode="EaseInOut"/>
                                                        </DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </Border.Triggers>
                                </Border>

                                <!-- Sentinel Status & Telemetry Header -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                    <WrapPanel Margin="0,0,0,4">
                                        <TextBlock Text="SECURITY CENTER" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                        <!-- Live Telemetry Pulse Dot -->
                                        <Control Style="{StaticResource RadarPulseDot}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="ACTIVE" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrandCyanBrush}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                    </WrapPanel>
                                    <TextBlock Text="Defender attack-surface rules • Persistence checks • DNS watchdog" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                </StackPanel>

                                <!-- Quick Scan Trigger -->
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Orientation="Horizontal">
                                    <Button Content="🛡 Full Security Audit" Style="{StaticResource ActionButton}" Click="OnSentinelScan" Height="42" Padding="18,8" ToolTip="Perform an exhaustive security inspection across CVEs, exposed services, privacy traces, and network ports"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource GlassPanel}" Margin="0,0,0,20">
                            <StackPanel>
                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="VULNERABILITY SCANNER" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="🛡 Run Scan" Style="{StaticResource ActionButton}" Click="OnSentinelScan" Margin="0,0,8,0" ToolTip="Scan installed software and OS against known security vulnerabilities and CVE records"/>
                                        <Button x:Name="BtnFixVulns" Content="🔧 Fix All" Style="{StaticResource ActionButton}" local:Gate.Requires="Core" Click="OnFixVulnerabilities" 
                                                Visibility="Collapsed" Background="#E53935" Margin="0,0,8,0" ToolTip="Apply mitigation recommendations and trigger Windows Update for patched packages"/>
                                    </StackPanel>
                                </Grid>
                                <TextBlock x:Name="SentinelStatus" Text="Click 'Run Scan' to check for vulnerabilities..." FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                <!-- Summary bar -->
                                <Border x:Name="VulnSummaryBar" Background="{DynamicResource BrandDarkPanelBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,12,0,0" Visibility="Collapsed">
                                    <DockPanel LastChildFill="False">
                                        <Button x:Name="BtnToggleVulnDetails" DockPanel.Dock="Right" HorizontalAlignment="Right" Content="▼ Show Details" Click="OnToggleVulnDetails"
                                                Background="Transparent" Foreground="{DynamicResource BrandCyanBrush}" BorderThickness="0" FontSize="11" Cursor="Hand" Margin="8,0,0,0" ToolTip="Expand or collapse vulnerability findings list"/>
                                        <TextBlock x:Name="VulnSummaryText" Text="" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" DockPanel.Dock="Left" TextWrapping="Wrap"/>
                                    </DockPanel>
                                </Border>
                                <ItemsControl x:Name="VulnList" Margin="0,8,0,0" Visibility="Collapsed" PreviewMouseWheel="OnNestedListPreviewMouseWheel"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource GlassPanel}" Margin="0,0,0,20">
                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="EXPOSED SERVICES" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                    <Button x:Name="BtnDisableServices" Grid.Column="1" Content="🔒 Disable Risky" Style="{StaticResource ActionButton}" 
                                            local:Gate.Requires="Core" Click="OnDisableExposedServices" Visibility="Collapsed" Background="#FF6F00" VerticalAlignment="Center" ToolTip="Disable insecure legacy background services to minimize network attack surface"/>
                                </Grid>
                                <TextBlock x:Name="ExposedServicesStatus" Text="Run 'Full Security Audit' or 'Run Scan' above to inspect network-listening Windows services..." FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                <Border x:Name="ServiceSummaryBar" Background="{DynamicResource BrandDarkPanelBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,10,0,0" Visibility="Collapsed">
                                    <DockPanel LastChildFill="False">
                                        <Button x:Name="BtnToggleServiceDetails" DockPanel.Dock="Right" HorizontalAlignment="Right" Content="▼ Show Details" Click="OnToggleServiceDetails"
                                                Background="Transparent" Foreground="{DynamicResource BrandCyanBrush}" BorderThickness="0" FontSize="11" Cursor="Hand" Margin="8,0,0,0" ToolTip="Expand or collapse exposed services list"/>
                                        <TextBlock x:Name="ServiceSummaryText" Text="" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" DockPanel.Dock="Left" TextWrapping="Wrap"/>
                                    </DockPanel>
                                </Border>
                                <ItemsControl x:Name="ServiceList" Margin="0,8,0,0" Visibility="Collapsed"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource GlassPanel}">
                            <StackPanel>
                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="PRIVACY SCRUBBER" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="🧹 Quick Scrub" Style="{StaticResource ActionButton}" local:Gate.Requires="Core" Click="OnPrivacyScrub" Margin="0,0,8,0" ToolTip="Clean Windows activity history, recent run history, thumbnail cache, and clipboard"/>
                                        <Button Content="🧹 Deep Scrub" Style="{StaticResource ActionButton}" local:Gate.Requires="Core" Click="OnDeepPrivacyScrub" Background="#7C4DFF" ToolTip="Deep cleanse browser caches, crash memory dumps, WER telemetry queues, and font caches"/>
                                    </StackPanel>
                                </Grid>
                                <TextBlock x:Name="ScrubStatus" Text="Remove caches, temp files, and telemetry artifacts" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                <Border x:Name="ScrubSummaryBar" Background="{DynamicResource BrandDarkPanelBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,12,0,0" Visibility="Collapsed">
                                    <TextBlock x:Name="ScrubSummaryText" Text="" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SuccessGreenBrush}" TextWrapping="Wrap"/>
                                </Border>
                                <ItemsControl x:Name="ScrubList" Margin="0,8,0,0" Visibility="Collapsed"/>
                            </StackPanel>
                        </Border>

                        <!-- AI & Copilot Privacy Guard -->
                        <Border Style="{StaticResource GlassPanel}" Margin="0,20,0,0">
                            <StackPanel>
                                <TextBlock Text="AI &amp; COPILOT PRIVACY GUARD" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                                <TextBlock x:Name="AiGuardStatus" Text="Neutralize Windows 11 Recall snapshots, Copilot taskbar hooks, Edge AI telemetry, and NPU diagnostics..." FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                                <WrapPanel Margin="0,0,0,4">
                                    <Button Content="🔍 Scan Status" Style="{StaticResource ActionButton}" Click="OnAiGuardScan" Margin="0,0,8,8" ToolTip="Check telemetry and surveillance status of Windows Copilot, Recall snapshots, and Edge AI"/>
                                    <Button x:Name="BtnAiGuardNeutralizeAll" Content="🛡 Neutralize All" Style="{StaticResource ActionButton}" local:Gate.Requires="Core" Click="OnAiGuardNeutralizeAll" Background="#00C853" Margin="0,0,8,8" ToolTip="Disable Recall snapshot capture, Copilot taskbar hooks, Edge AI telemetry, and diagnostic tracking"/>
                                    <Button x:Name="BtnAiGuardRevertAll" Content="↩ Revert" Style="{StaticResource OutlineButton}" Click="OnAiGuardRevertAll" Margin="0,0,8,8" ToolTip="Restore Windows default settings for AI services and diagnostic logging"/>
                                </WrapPanel>
                                <Border x:Name="AiGuardSummaryBar" Background="{DynamicResource BrandDarkPanelBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,12,0,0" Visibility="Collapsed">
                                    <TextBlock x:Name="AiGuardSummaryText" Text="" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource BrandCyanBrush}" TextWrapping="Wrap"/>
                                </Border>
                                <ItemsControl x:Name="AiGuardList" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Network Security Scanner (10-Vector) -->
                        <Border Style="{StaticResource GlassPanel}" Margin="0,20,0,20">
                            <StackPanel>
                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="NETWORK SECURITY SCANNER" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="🌐 Full Network Scan" Style="{StaticResource ActionButton}" Click="OnNetworkScan" Margin="0,0,8,0" ToolTip="Audit listening network ports, active sockets, ARP tables, and adapter DNS servers"/>
                                        <Button x:Name="BtnRemediateNetwork" Content="🔧 Fix All" Style="{StaticResource ActionButton}" local:Gate.Requires="Core" Click="OnRemediateAll"
                                                Visibility="Collapsed" Background="#E53935" ToolTip="Apply recommended network security fixes and close non-essential listening ports"/>
                                    </StackPanel>
                                </Grid>
                                <TextBlock x:Name="NetworkScanStatus" Text="10-vector scan: ports, ARP, DNS, firewall, WiFi, RDP, UPnP, SMBv1, WinRM, shares" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                <Border x:Name="NetworkSummaryBar" Background="{DynamicResource BrandDarkPanelBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,12,0,0" Visibility="Collapsed">
                                    <TextBlock x:Name="NetworkSummaryText" Text="" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                                </Border>
                                <ItemsControl x:Name="NetworkFindingsList" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Startup Security Audit -->
                        <Border Style="{StaticResource GlassPanel}" Margin="0,0,0,20">
                            <StackPanel>
                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="STARTUP SECURITY AUDIT" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                    <Button Grid.Column="1" Content="🔍 Audit Startup" Style="{StaticResource ActionButton}" Click="OnStartupAudit" VerticalAlignment="Center" ToolTip="Scan startup registry entries and scheduled tasks for obfuscated commands, mshta, or certutil abuse"/>
                                </Grid>
                                <TextBlock x:Name="StartupAuditStatus" Text="Scan registry and startup folders for suspicious entries (encoded PowerShell, mshta, certutil)" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                <Border x:Name="StartupAuditSummaryBar" Background="{DynamicResource BrandDarkPanelBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,12,0,0" Visibility="Collapsed">
                                    <TextBlock x:Name="StartupAuditSummaryText" Text="" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                                </Border>
                                <ItemsControl x:Name="StartupAuditList" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Windows Defender Enterprise Hardener & ASR -->
                        <Border Style="{StaticResource GlassPanel}" Margin="0,0,0,20">
                            <StackPanel>
                                <TextBlock Text="WINDOWS DEFENDER ENTERPRISE HARDENER &amp; ASR" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                                <TextBlock x:Name="DefenderHardenStatus" Text="Enterprise Attack Surface Reduction (ASR), PUA aggressive blocking, cloud defense, and ransomware shields..." FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                                <WrapPanel Margin="0,0,0,4">
                                    <Button Content="🔍 Check Status" Style="{StaticResource ActionButton}" Click="OnDefenderHardenStatus" Margin="0,0,8,8" ToolTip="Query Windows Defender Attack Surface Reduction (ASR) rules and cloud protection status"/>
                                    <Button x:Name="BtnDefenderHardenAll" Content="🛡 Enable All ASR" Style="{StaticResource ActionButton}" local:Gate.Requires="Core" Click="OnDefenderHardenAll" Background="#00C853" Margin="0,0,8,8" ToolTip="Enforce all 16 enterprise Defender ASR rules, PUA blocking, and credential theft protections"/>
                                    <Button Content="⚡ Quick Scan" Style="{StaticResource ActionButton}" Click="OnDefenderQuickScan" Margin="0,0,8,8" ToolTip="Execute a rapid Windows Defender antivirus scan of memory and critical OS folders"/>
                                    <Button Content="🛡 Full Scan" Style="{StaticResource ActionButton}" Click="OnDefenderFullScan" Margin="0,0,8,8" ToolTip="Execute a comprehensive Windows Defender scan across all storage drives and archives"/>
                                    <Button Content="🔄 Offline Scan" Style="{StaticResource ActionButton}" local:Gate.Requires="Core" Click="OnDefenderOfflineScan" Margin="0,0,8,8" ToolTip="Reboot system into Windows Defender Offline environment to clean persistent rootkits"/>
                                    <Button Content="↩ Defaults" Style="{StaticResource OutlineButton}" Click="OnDefenderRevert" Margin="0,0,8,8" ToolTip="Reset Defender configuration and ASR policies to original Windows defaults"/>
                                </WrapPanel>
                                <Border x:Name="DefenderHardenSummaryBar" Background="{DynamicResource BrandDarkPanelBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,12,0,0" Visibility="Collapsed">
                                    <TextBlock x:Name="DefenderHardenSummaryText" Text="" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource BrandCyanBrush}" TextWrapping="Wrap"/>
                                </Border>
                                <ItemsControl x:Name="DefenderHardenList" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Stealth Persistence & Rootkit Threat Hunter -->
                        <Border Style="{StaticResource GlassPanel}" Margin="0,0,0,20">
                            <StackPanel>
                                <TextBlock Text="PERSISTENCE &amp; ROOTKIT THREAT HUNTER" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                                <TextBlock x:Name="PersistenceHuntStatus" Text="Audits WMI event subscriptions, IFEO debugger hijacks, AppInit_DLLs, Winlogon shell hooks, and unsigned temp binaries..." FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                                <WrapPanel Margin="0,0,0,4">
                                    <Button Content="🔍 Deep Threat Hunt" Style="{StaticResource ActionButton}" Click="OnPersistenceHunt" Margin="0,0,8,8" ToolTip="Scan for stealth persistence: WMI event consumers, IFEO debugger hijacks, and AppInit DLLs"/>
                                    <Button x:Name="BtnPersistenceSelectAll" Content="☑ All" Style="{StaticResource HeaderOutlineButton}" Click="OnPersistenceSelectAll" Visibility="Collapsed" Margin="0,0,6,8" Height="32" Padding="10,0" ToolTip="Select all detected persistence entries"/>
                                    <Button x:Name="BtnPersistenceDeselectAll" Content="☐ None" Style="{StaticResource HeaderOutlineButton}" Click="OnPersistenceDeselectAll" Visibility="Collapsed" Margin="0,0,8,8" Height="32" Padding="10,0" ToolTip="Clear persistence entry selection"/>
                                    <Button x:Name="BtnRemediatePersistence" Content="🔧 Remediate Selected" Style="{StaticResource ActionButton}" local:Gate.Requires="Core" Click="OnPersistenceRemediateAll"
                                            Visibility="Collapsed" Background="#E53935" Margin="0,0,8,8" ToolTip="Neutralize and remove checked persistence hooks and unauthorized autorun registrations"/>
                                </WrapPanel>
                                <Border x:Name="PersistenceHuntSummaryBar" Background="{DynamicResource BrandDarkPanelBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,12,0,0" Visibility="Collapsed">
                                    <TextBlock x:Name="PersistenceHuntSummaryText" Text="" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                                </Border>
                                <ItemsControl x:Name="PersistenceHuntList" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- DNS & Hosts File Hijack Watchdog -->
                        <Border Style="{StaticResource GlassPanel}">
                            <StackPanel>
                                <TextBlock Text="DNS &amp; HOSTS FILE HIJACK WATCHDOG" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                                <TextBlock x:Name="DnsHostsStatus" Text="Audits system hosts file for adware redirects / AV sinkholing and inspects adapter DNS servers..." FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                                <WrapPanel Margin="0,0,0,4">
                                    <Button Content="🔍 Check Hosts" Style="{StaticResource ActionButton}" Click="OnDnsHostsCheck" Margin="0,0,8,8" ToolTip="Inspect Windows hosts file for malicious redirects, adware entries, and verify DNS resolvers"/>
                                    <Button x:Name="BtnRestoreHosts" Content="🔧 Restore Clean Hosts" Style="{StaticResource ActionButton}" Click="OnRestoreCleanHosts" Background="#FF6F00" Margin="0,0,8,8" ToolTip="Revert hosts file to clean Microsoft default state, eliminating unauthorized URL redirects"/>
                                </WrapPanel>
                                <Border x:Name="DnsHostsSummaryBar" Background="{DynamicResource BrandDarkPanelBrush}" CornerRadius="8" Padding="12,8" Margin="0,12,0,0" Visibility="Collapsed">
                                    <TextBlock x:Name="DnsHostsSummaryText" Text="" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                                </Border>
                                <ItemsControl x:Name="DnsHostsList" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ──── Guardian Page ──── -->
                <ScrollViewer x:Name="PageGuardian" VerticalScrollBarVisibility="Auto" Padding="24" Visibility="Collapsed">
                    <StackPanel x:Name="GuardianContent" Opacity="0">
                        <StackPanel.RenderTransform>
                            <TranslateTransform X="0" Y="0"/>
                        </StackPanel.RenderTransform>

                        <!-- 🚀 TURBO MODE — Flagship Performance Tuning Control Center -->
                        <Border x:Name="TurboModeContainer" Style="{StaticResource GlassPanel}" Margin="0,0,0,20">
                            <!-- We will animate border color programmatically when mode activates -->
                            <StackPanel>
                                <TextBlock Text="🚀 TURBO / BOOST MODE" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                                <TextBlock x:Name="TurboModeStatus" Text="Terminate non-essential background bloat, boost foreground application priority, switch power plan, and trim RAM working sets (also launchable silently via LogicFlow.exe /boost)." FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                                <WrapPanel Margin="0,0,0,4">
                                    <Button x:Name="BtnTurboSmart" Content="🧠 SMART BOOST" Style="{StaticResource ActionButton}" local:Gate.Requires="Core" Click="OnTurboSmart" Margin="0,0,8,8" Padding="16,10" FontWeight="Bold" ToolTip="AI-guided Smart Boost: inspects active workloads and automatically selects the optimal Turbo profile"/>
                                    <Button x:Name="BtnTurboGaming" Content="🎮 GAMING" Style="{StaticResource OutlineButton}" local:Gate.Requires="Core" Click="OnTurboGaming" Margin="0,0,8,8" Foreground="{StaticResource TurboGamingOrangeBrush}"  BorderBrush="{StaticResource TurboGamingOrangeBrush}" ToolTip="Maximize gaming performance: terminate non-essential background bloat, boost foreground game priority, and switch to High Performance power plan"/>
                                    <Button x:Name="BtnTurboStreaming" Content="📡 STREAMING" Style="{StaticResource OutlineButton}" local:Gate.Requires="Core" Click="OnTurboStreaming" Margin="0,0,8,8" Foreground="{DynamicResource BrandCyanBrush}" BorderBrush="{DynamicResource BrandCyanBrush}" ToolTip="Streaming Mode: boosts game &amp; encoder priority while keeping OBS, Discord, and audio pipelines alive"/>
                                    <Button x:Name="BtnTurboRendering" Content="🎬 RENDERING" Style="{StaticResource OutlineButton}" local:Gate.Requires="Core" Click="OnTurboRendering" Margin="0,0,8,8" Foreground="{StaticResource TurboWorkPurpleBrush}" BorderBrush="{StaticResource TurboWorkPurpleBrush}" ToolTip="Rendering Mode: unlocks all-core CPU/GPU throughput for 3D rendering, CAD, and video encoding"/>
                                    <Button x:Name="BtnTurboBenchmarking" Content="⚡ BENCHMARK" Style="{StaticResource OutlineButton}" local:Gate.Requires="Core" Click="OnTurboBenchmarking" Margin="0,0,8,8" Foreground="{StaticResource TurboGamingOrangeBrush}" BorderBrush="{StaticResource TurboGamingOrangeBrush}" ToolTip="Benchmarking Mode: strips all non-essential background services and visual effects for peak synthetic scores"/>
                                    <Button x:Name="BtnTurboWork" Content="💼 WORK" Style="{StaticResource OutlineButton}" local:Gate.Requires="Core" Click="OnTurboWork" Margin="0,0,8,8" Foreground="{StaticResource TurboWorkPurpleBrush}" BorderBrush="{StaticResource TurboWorkPurpleBrush}" ToolTip="Tune system for productivity: prioritize CPU scheduling and working sets for active foreground apps"/>
                                    <Button x:Name="BtnTurboBattery" Content="🔋 BATTERY" Style="{StaticResource OutlineButton}" local:Gate.Requires="Core" Click="OnTurboBattery" Margin="0,0,8,8" Foreground="{StaticResource TurboBatteryGreenBrush}" BorderBrush="{StaticResource TurboBatteryGreenBrush}" ToolTip="Extend battery endurance: aggressive power throttling and suppression of background tasks"/>
                                    <Button x:Name="BtnTurboServer" Content="🖥 SERVER" Style="{StaticResource OutlineButton}" local:Gate.Requires="Core" Click="OnTurboServer" Margin="0,0,8,8" Foreground="{DynamicResource BrandCyanBrush}" BorderBrush="{DynamicResource BrandCyanBrush}" ToolTip="Optimize for server workloads: expand filesystem cache and prioritize background I/O throughput"/>
                                    <Button x:Name="BtnTurboOff" Content="⏹ REVERT TO NORMAL" Style="{StaticResource ActionButton}" Click="OnTurboDeactivate"
                                            Visibility="Collapsed" Background="{DynamicResource DangerRedBrush}" Foreground="White" FontWeight="Bold" Margin="0,0,8,8" ToolTip="Revert system optimizations, CPU affinities, and services back to normal operation"/>
                                </WrapPanel>
                                
                                <!-- Active Data Reporting Panel -->
                                <Border x:Name="TurboSummaryBar" Background="{DynamicResource BrandDarkCardBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="12,12" Margin="0,16,0,0" Visibility="Collapsed">
                                    <StackPanel>
                                        <TextBlock x:Name="TurboSummaryText" Text="SYSTEM OVERRIDDEN" FontSize="14" FontWeight="ExtraBold" Foreground="{StaticResource TurboGamingOrangeBrush}" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                        <ItemsControl x:Name="TurboActionList">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding}" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="Consolas" Margin="0,2"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Driver Health -->
                        <Border Style="{StaticResource GlassPanel}" Margin="0,0,0,20">
                            <StackPanel>
                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="DRIVER HEALTH" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button x:Name="BtnAuditDrivers" Content="⚡ Audit Drivers" Style="{StaticResource HeaderActionButton}" Click="OnDriverAudit" Margin="0,0,8,0" ToolTip="Evaluate hardware drivers for outdated versions, missing signatures, and PnP device errors"/>
                                        <Button x:Name="BtnDriverSelectAll" Content="☑ All" Style="{StaticResource HeaderOutlineButton}" Click="OnDriverSelectAll" Visibility="Collapsed" Margin="0,0,6,0" Height="30" Padding="8,0" ToolTip="Select all actionable drivers in the list"/>
                                        <Button x:Name="BtnDriverDeselectAll" Content="☐ None" Style="{StaticResource HeaderOutlineButton}" Click="OnDriverDeselectAll" Visibility="Collapsed" Margin="0,0,6,0" Height="30" Padding="8,0" ToolTip="Clear driver selection"/>
                                        <Button x:Name="BtnUpdateDrivers" Content="🔄 Update Selected (0)" Style="{StaticResource HeaderActionButton}" local:Gate.Requires="Core" Click="OnUpdateSelectedDrivers"
                                                Visibility="Collapsed" Background="#FF6F00" ToolTip="Download and install updates for selected device drivers with automated restore point creation"/>
                                    </StackPanel>
                                </Grid>
                                <TextBlock x:Name="DriverStatusLabel" Text="Click 'Audit Drivers' to evaluate hardware integrity..." FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                <!-- Driver Health Status Card / Summary Bar -->
                                <Border x:Name="DriverSummaryBar" Background="{DynamicResource BrandDarkPanelBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,12,0,0" Visibility="Collapsed">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,8" LastChildFill="False">
                                            <Button x:Name="BtnToggleDriverDetails" DockPanel.Dock="Right" HorizontalAlignment="Right" Content="▼ Show Details" Click="OnToggleDriverDetails"
                                                    Background="Transparent" Foreground="{DynamicResource BrandCyanBrush}" BorderThickness="0" FontSize="11" Cursor="Hand" Margin="8,0,0,0" ToolTip="Expand or collapse driver list"/>
                                            <TextBlock x:Name="DriverSummaryText" Text="Driver Status: Checking..." FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                        </DockPanel>
                                        <UniformGrid Columns="4" Margin="0,4,0,0">
                                            <Border Background="{DynamicResource BrandDarkCardBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="0,0,4,0">
                                                <StackPanel HorizontalAlignment="Center">
                                                    <TextBlock Text="DRIVER STATUS" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                                                    <TextBlock x:Name="DriverStatusMetric" Text="Optimal" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource SuccessGreenBrush}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Background="{DynamicResource BrandDarkCardBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="4,0,4,0">
                                                <StackPanel HorizontalAlignment="Center">
                                                    <TextBlock Text="OUTDATED" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                                                    <TextBlock x:Name="DriverOutdatedMetric" Text="0" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource WarningAmberBrush}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Background="{DynamicResource BrandDarkCardBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="4,0,4,0">
                                                <StackPanel HorizontalAlignment="Center">
                                                    <TextBlock Text="UNSIGNED" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                                                    <TextBlock x:Name="DriverUnsignedMetric" Text="0" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource WarningAmberBrush}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Background="{DynamicResource BrandDarkCardBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="4,0,0,0">
                                                <StackPanel HorizontalAlignment="Center">
                                                    <TextBlock Text="PROBLEM DEVICES" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                                                    <TextBlock x:Name="DriverProblemMetric" Text="0" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource DangerRedBrush}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </Border>
                                        </UniformGrid>
                                    </StackPanel>
                                </Border>
                                <ItemsControl x:Name="DriverList" Margin="0,8,0,0" Visibility="Collapsed" PreviewMouseWheel="OnNestedListPreviewMouseWheel"/>
                            </StackPanel>
                        </Border>

                        <!-- Bloatware Scanner -->
                        <Border Style="{StaticResource GlassPanel}" Margin="0,0,0,20">
                            <StackPanel>
                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="BLOATWARE SCANNER" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="🗑 Scan Bloatware" Style="{StaticResource HeaderActionButton}" Click="OnBloatwareScan" Margin="0,0,8,0" ToolTip="Detect pre-installed consumer bloatware and unnecessary provisioned packages"/>
                                        <Button x:Name="BtnBloatSelectAll" Content="☑ All" Style="{StaticResource HeaderOutlineButton}" Click="OnBloatSelectAll" Visibility="Collapsed" Margin="0,0,6,0" Height="30" Padding="8,0" ToolTip="Select all detected bloatware packages for removal"/>
                                        <Button x:Name="BtnBloatDeselectAll" Content="☐ None" Style="{StaticResource HeaderOutlineButton}" Click="OnBloatDeselectAll" Visibility="Collapsed" Margin="0,0,6,0" Height="30" Padding="8,0" ToolTip="Clear bloatware selection"/>
                                        <Button x:Name="BtnRemoveBloat" Content="🗑 Uninstall Selected" Style="{StaticResource HeaderActionButton}" local:Gate.Requires="Core" Click="OnRemoveAllBloatware"
                                                Visibility="Collapsed" Background="#E53935" ToolTip="Uninstall selected bloatware packages from the current user account"/>
                                    </StackPanel>
                                </Grid>
                                <TextBlock x:Name="BloatStatus" Text="Detect pre-installed bloatware packages..." FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                <Border x:Name="BloatSummaryBar" Background="{DynamicResource BrandDarkPanelBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,12,0,0" Visibility="Collapsed">
                                    <DockPanel LastChildFill="False">
                                        <Button x:Name="BtnToggleBloatDetails" DockPanel.Dock="Right" HorizontalAlignment="Right" Content="▼ Show Details" Click="OnToggleBloatDetails"
                                                Background="Transparent" Foreground="{DynamicResource BrandCyanBrush}" BorderThickness="0" FontSize="11" Cursor="Hand" Margin="8,0,0,0" ToolTip="Expand or collapse bloatware package list"/>
                                        <TextBlock x:Name="BloatSummaryText" Text="" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                    </DockPanel>
                                </Border>
                                <ItemsControl x:Name="BloatList" Margin="0,8,0,0" Visibility="Collapsed" PreviewMouseWheel="OnNestedListPreviewMouseWheel"/>
                            </StackPanel>
                        </Border>

                        <!-- Startup Optimizer -->
                        <Border Style="{StaticResource GlassPanel}" Margin="0,0,0,20">
                            <StackPanel>
                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="STARTUP OPTIMIZER" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="🚀 Analyze Startup" Style="{StaticResource HeaderActionButton}" Click="OnStartupScan" Margin="0,0,8,0" ToolTip="Analyze all startup applications and background services by boot impact score"/>
                                        <Button x:Name="BtnDisableStartup" Content="⚡ Disable High-Impact" Style="{StaticResource HeaderActionButton}" local:Gate.Requires="Core" Click="OnDisableHighImpactStartup"
                                                Visibility="Collapsed" Background="#FF6F00" ToolTip="Disable detected high-impact startup items to accelerate Windows boot speed"/>
                                    </StackPanel>
                                </Grid>
                                <TextBlock x:Name="StartupStatus" Text="Evaluate startup items by impact score..." FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                <Border x:Name="StartupSummaryBar" Background="{DynamicResource BrandDarkPanelBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,12,0,0" Visibility="Collapsed">
                                    <DockPanel LastChildFill="False">
                                        <Button x:Name="BtnToggleStartupDetails" DockPanel.Dock="Right" HorizontalAlignment="Right" Content="▼ Show Details" Click="OnToggleStartupDetails"
                                                Background="Transparent" Foreground="{DynamicResource BrandCyanBrush}" BorderThickness="0" FontSize="11" Cursor="Hand" Margin="8,0,0,0" ToolTip="Expand or collapse startup item details"/>
                                        <TextBlock x:Name="StartupSummaryText" Text="" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                    </DockPanel>
                                </Border>
                                <ItemsControl x:Name="StartupList" Margin="0,8,0,0" Visibility="Collapsed" PreviewMouseWheel="OnNestedListPreviewMouseWheel"/>
                            </StackPanel>
                        </Border>

                        <!-- Boot-Time Critical Path Flamegraph -->
                        <Border Style="{StaticResource GlassPanel}" Margin="0,0,0,20">
                            <StackPanel>
                                <WrapPanel Margin="0,0,0,10" VerticalAlignment="Center">
                                    <WrapPanel VerticalAlignment="Center" Margin="0,2,12,4">
                                        <TextBlock Text="🔥 BOOT-TIME CRITICAL PATH FLAMEGRAPH" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="0,2,8,2"/>
                                        <Border Background="{DynamicResource BrandDarkCardBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="4" Padding="6,1" Margin="0,2,0,2" VerticalAlignment="Center">
                                            <TextBlock Text="EVENT ID 100–110" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrandCyanBrush}"/>
                                        </Border>
                                    </WrapPanel>
                                    <Button x:Name="BtnScanBootFlamegraph" Content="🔥 Scan Boot Critical Path" Style="{StaticResource HeaderActionButton}" Click="OnScanBootFlamegraph" VerticalAlignment="Center" Margin="0,2,0,4"
                                            ToolTip="Analyze Windows Event ID 100–110 boot diagnostics and startup critical-path millisecond delays"/>
                                </WrapPanel>
                                <TextBlock x:Name="BootFlamegraphStatus" Text="Inspect kernel/driver initialization vs. post-boot desktop startup latency..." FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>

                                <Border x:Name="BootFlamegraphSummaryBar" Background="{DynamicResource BrandDarkCardBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,12,0,0" Visibility="Collapsed">
                                    <StackPanel>
                                        <DockPanel LastChildFill="False" Margin="0,0,0,8">
                                            <TextBlock x:Name="BootTotalTimeText" DockPanel.Dock="Left" Text="Total Boot: --" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource BrandCyanBrush}"/>
                                            <TextBlock x:Name="BootTelemetrySourceText" DockPanel.Dock="Right" Text="" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                        </DockPanel>
                                        <Grid Height="18" ClipToBounds="True">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition x:Name="BootMainPathCol" Width="55*"/>
                                                <ColumnDefinition x:Name="BootPostBootCol" Width="45*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Background="#0284C7" CornerRadius="4,0,0,4" Padding="6,1">
                                                <TextBlock x:Name="BootMainPathBarLabel" Text="Kernel &amp; Drivers" FontSize="11" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                            </Border>
                                            <Border Grid.Column="1" Background="#7C3AED" CornerRadius="0,4,4,0" Padding="6,1">
                                                <TextBlock x:Name="BootPostBootBarLabel" Text="Post-Boot Apps" FontSize="11" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                            </Border>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <ItemsControl x:Name="BootFlamegraphList" Margin="0,10,0,0" Visibility="Collapsed" PreviewMouseWheel="OnNestedListPreviewMouseWheel"/>
                            </StackPanel>
                        </Border>

                        <!-- SMART Disk Health -->
                        <Border Style="{StaticResource GlassPanel}" Margin="0,0,0,20">
                            <StackPanel>
                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="S.M.A.R.T. DISK HEALTH" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                    <Button Grid.Column="1" Content="💾 Scan Drives" Style="{StaticResource HeaderActionButton}" Click="OnSmartDiskScan" VerticalAlignment="Center" ToolTip="Read S.M.A.R.T. health telemetry, temperatures, and reallocated sector counts from all physical drives"/>
                                </Grid>
                                <TextBlock x:Name="SmartDiskStatus" Text="Read S.M.A.R.T. attributes from all drives..." FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                <Border x:Name="SmartDiskSummaryBar" Background="{DynamicResource BrandDarkPanelBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,12,0,0" Visibility="Collapsed">
                                    <TextBlock x:Name="SmartDiskSummaryText" Text="" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                                </Border>
                                <ItemsControl x:Name="SmartDiskList" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Windows Tweaks -->
                        <Border Style="{StaticResource GlassPanel}" Margin="0,0,0,20">
                            <StackPanel>
                                <TextBlock Text="WINDOWS OPTIMIZATIONS" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                                <TextBlock x:Name="TweakStatus" Text="30+ safe Windows optimizations for Privacy, Performance, Gaming, Network..." FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                                <WrapPanel VerticalAlignment="Center">
                                    <Button Content="🔍 Scan Tweaks" Style="{StaticResource HeaderActionButton}" Click="OnTweakScan" Margin="0,0,8,6" ToolTip="Scan Windows registry for applicable performance, privacy, and gaming optimizations"/>
                                    <Button x:Name="BtnApplySelectedTweaks" Content="⚡ Apply Selected" Style="{StaticResource HeaderActionButton}" local:Gate.Requires="Core" Click="OnApplySelectedTweaks"
                                            Visibility="Collapsed" Background="#00C853" Margin="0,0,8,6" ToolTip="Apply selected registry optimizations to fine-tune system responsiveness"/>
                                    <Button x:Name="BtnRevertSelectedTweaks" Content="⟲ Revert Selected" Style="{StaticResource HeaderOutlineButton}" Click="OnRevertSelectedTweaks"
                                            Visibility="Collapsed" Margin="0,0,8,6" ToolTip="Restore selected registry settings back to Windows defaults"/>
                                    <Button x:Name="BtnTweakSelectAllSafe" Content="🛡 Select All Safe" Style="{StaticResource HeaderOutlineButton}" Click="OnTweakSelectAllSafe"
                                            Visibility="Collapsed" Margin="0,0,8,6" ToolTip="Select only tweaks categorized as low-risk"/>
                                    <Button x:Name="BtnTweakDeselectAll" Content="☐ Deselect All" Style="{StaticResource HeaderOutlineButton}" Click="OnTweakDeselectAll"
                                            Visibility="Collapsed" Margin="0,0,0,6" ToolTip="Clear all selected tweak checkboxes"/>
                                </WrapPanel>

                                <!-- Filter & Search Controls -->
                                <WrapPanel x:Name="TweakToolbar" Margin="0,10,0,0" VerticalAlignment="Center" Visibility="Collapsed">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,8">
                                        <TextBlock Text="Category:" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <ComboBox x:Name="ComboTweakCategory" Style="{StaticResource DarkComboBoxStyle}" Width="150" Height="28" SelectedIndex="0" SelectionChanged="OnTweakCategoryChanged">
                                            <ComboBoxItem Content="All Categories"/>
                                            <ComboBoxItem Content="Privacy"/>
                                            <ComboBoxItem Content="Performance"/>
                                            <ComboBoxItem Content="Gaming"/>
                                            <ComboBoxItem Content="Network"/>
                                            <ComboBoxItem Content="Services"/>
                                            <ComboBoxItem Content="Visual"/>
                                            <ComboBoxItem Content="Maintenance"/>
                                        </ComboBox>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,8">
                                        <TextBlock Text="Safety:" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <ComboBox x:Name="ComboTweakSafety" Style="{StaticResource DarkComboBoxStyle}" Width="130" Height="28" SelectedIndex="0" SelectionChanged="OnTweakSafetyChanged">
                                            <ComboBoxItem Content="All Levels"/>
                                            <ComboBoxItem Content="Safe Only"/>
                                            <ComboBoxItem Content="Moderate"/>
                                            <ComboBoxItem Content="Advanced"/>
                                        </ComboBox>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,8">
                                        <TextBlock Text="Search:" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBox x:Name="TweakSearchBox" Width="160" Height="28" Background="{DynamicResource BrandDarkCardBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" Padding="6,4" VerticalContentAlignment="Center" TextChanged="OnTweakSearchChanged"/>
                                    </StackPanel>
                                </WrapPanel>

                                <Border x:Name="TweakSummaryBar" Background="{DynamicResource BrandDarkPanelBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,12,0,0" Visibility="Collapsed">
                                    <TextBlock x:Name="TweakSummaryText" Text="" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                                </Border>
                                <ItemsControl x:Name="TweakList" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ──── Lazarus Page ──── -->
                <ScrollViewer x:Name="PageLazarus" VerticalScrollBarVisibility="Auto" Padding="24" Visibility="Collapsed">
                    <StackPanel x:Name="LazarusContent" Opacity="0">
                        <StackPanel.RenderTransform>
                            <TranslateTransform X="0" Y="0"/>
                        </StackPanel.RenderTransform>
                        <Border Style="{StaticResource GlassPanel}" Margin="0,0,0,20">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,12" LastChildFill="True">
                                    <Button DockPanel.Dock="Right" Content="🔄 Refresh Drives" Style="{StaticResource ActionButton}" Height="30" Padding="14,0" Margin="12,0,0,0" Click="OnRefreshDrives" ToolTip="Rescan system storage buses for mounted physical disks and partitions" VerticalAlignment="Center"/>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Background="{DynamicResource BrushAccentGlow}" BorderBrush="{DynamicResource BrandCyanBrush}" BorderThickness="1" CornerRadius="6" Padding="6,3" Margin="0,0,8,0" VerticalAlignment="Center">
                                                <TextBlock Text="⚡" FontSize="11" Foreground="{DynamicResource BrandCyanBrush}"/>
                                            </Border>
                                            <TextBlock Text="STORAGE VOLUMES &amp; DRIVES" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <TextBlock Text="Select a mounted storage volume and recovery strategy to scan unallocated sectors and file records." FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </DockPanel>
                                <ItemsControl x:Name="DriveList" PreviewMouseWheel="OnNestedListPreviewMouseWheel"/>
                            </StackPanel>
                        </Border>

                        <!-- ═══ CARVED FILE SIGNATURES & RECOVERY VAULT (Dedicated Interactive Results Panel) ═══ -->
                        <Border x:Name="LazarusRecoveryPanel" Style="{StaticResource GlassPanel}" Margin="0,0,0,20" Visibility="Collapsed">
                            <StackPanel>
                                <!-- Panel Header & Telemetry Strip -->
                                <WrapPanel Margin="0,0,0,12" VerticalAlignment="Center">
                                    <StackPanel Orientation="Vertical" Margin="0,2,16,6">
                                        <WrapPanel VerticalAlignment="Center">
                                            <TextBlock Text="CARVED FILE SIGNATURES &amp; RECOVERY VAULT" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource BrandCyanBrush}" VerticalAlignment="Center" Margin="0,2,10,2"/>
                                            <Border x:Name="LazarusDriveBadgeBorder" Background="{DynamicResource BrandDarkCardBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,2,0,2" VerticalAlignment="Center">
                                                <TextBlock x:Name="LazarusDriveBadge" Text="DRIVE: C:\" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            </Border>
                                        </WrapPanel>
                                        <TextBlock x:Name="LazarusTelemetryText" Text="Discovered: 0 signatures | Recoverable Size: 0 MB | Elapsed: 0.0s" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,2,0,4">
                                        <Button x:Name="BtnRecoverSelected" Content="💾 Recover Selected to Folder..." Style="{StaticResource ActionButton}" local:Gate.Requires="Core" Click="OnRecoverSelected" Margin="0,0,8,0" Height="32" Padding="14,0" ToolTip="Export and reconstruct selected carved files to a secure directory"/>
                                        <Button Content="✕" Style="{StaticResource HeaderOutlineButton}" Click="OnDismissLazarusResults" ToolTip="Dismiss Results Panel" Width="32" Height="32" Padding="0"/>
                                    </StackPanel>
                                </WrapPanel>

                                <!-- Controls Strip: Select All / Deselect All, Filter Dropdown, Search Input, and Selection Counter -->
                                <Border Background="{DynamicResource BrandDarkPanelBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <WrapPanel Grid.Column="0" VerticalAlignment="Center">
                                            <Button x:Name="BtnLazarusSelectAll" Content="☑ Select All" Style="{StaticResource HeaderOutlineButton}" Height="28" Padding="10,0" Margin="0,0,6,2" Click="OnLazarusSelectAll" ToolTip="Select all carved files currently visible in the table"/>
                                            <Button x:Name="BtnLazarusDeselectAll" Content="☐ Deselect All" Style="{StaticResource HeaderOutlineButton}" Height="28" Padding="10,0" Margin="0,0,10,2" Click="OnLazarusDeselectAll" ToolTip="Deselect all files"/>
                                            <ComboBox x:Name="LazarusCategoryFilter" Style="{StaticResource DarkComboBoxStyle}" ItemContainerStyle="{StaticResource DarkComboBoxItemStyle}" SelectionChanged="OnLazarusFilterChanged" Height="28" Width="135" Margin="0,0,8,2" VerticalContentAlignment="Center"
                                                      ToolTip="Filter carved disk file signatures by category: Images, Documents, Archives, Audio/Video, or Databases">
                                                <ComboBoxItem Content="All Categories" IsSelected="True"/>
                                                <ComboBoxItem Content="🖼 Images"/>
                                                <ComboBoxItem Content="📄 Documents"/>
                                                <ComboBoxItem Content="📦 Archives"/>
                                                <ComboBoxItem Content="🎬 Audio/Video"/>
                                                <ComboBoxItem Content="🗄 Databases"/>
                                                <ComboBoxItem Content="📁 Other"/>
                                            </ComboBox>
                                            <Border Background="{DynamicResource BrandDarkCardBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="6" Height="28" Width="180" Margin="0,0,8,2">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="🔍" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="8,0,4,0"/>
                                                    <Grid Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock x:Name="LazarusSearchPlaceholder" Text="Filter files..." FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" IsHitTestVisible="False" Margin="2,0,0,0"/>
                                                        <TextBox x:Name="LazarusSearchBox" TextChanged="OnLazarusSearchChanged" Background="Transparent" Foreground="{DynamicResource TextPrimaryBrush}" BorderThickness="0" FontSize="11" VerticalContentAlignment="Center" ToolTip="Filter by type, extension, or offset" Padding="2,0"/>
                                                    </Grid>
                                                    <Button x:Name="BtnClearLazarusSearch" Grid.Column="2" Content="✕" Click="OnClearLazarusSearch" Style="{StaticResource HeaderOutlineButton}" Width="20" Height="20" Padding="0" Margin="0,0,4,0" ToolTip="Clear search" Visibility="Collapsed" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                </Grid>
                                            </Border>
                                        </WrapPanel>
                                        <Border Grid.Column="1" Background="{DynamicResource BrandDarkCardBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="6" Padding="10,4" VerticalAlignment="Center" Margin="8,0,0,2">
                                            <TextBlock x:Name="LazarusSelectedSummary" Text="Selected: 0 of 0 files (0 B)" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource BrandCyanBrush}" VerticalAlignment="Center"/>
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- Live Extraction Progress Strip -->
                                <Border x:Name="LazarusExtractionPanel" Visibility="Collapsed" Background="{DynamicResource BrandDarkCardBrush}" BorderBrush="{DynamicResource BrandCyanBrush}" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,12">
                                    <StackPanel>
                                        <DockPanel LastChildFill="False" Margin="0,0,0,6">
                                            <TextBlock x:Name="LazarusExtractionCounter" DockPanel.Dock="Right" Text="0 / 0 (0%)" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="8,0,0,0"/>
                                            <TextBlock x:Name="LazarusExtractionStatus" DockPanel.Dock="Left" Text="Extracting carved sector signatures to disk..." FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource BrandCyanBrush}" TextWrapping="Wrap"/>
                                        </DockPanel>
                                        <ProgressBar x:Name="LazarusExtractionProgressBar" Height="6" Style="{StaticResource GlassProgressBarStyle}"/>
                                    </StackPanel>
                                </Border>

                                <!-- Success Notification Banner with Open Folder Action -->
                                <Border x:Name="LazarusSuccessBanner" Visibility="Collapsed" Background="#1810B981" BorderBrush="{DynamicResource SuccessGreenBrush}" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,12">
                                    <DockPanel LastChildFill="False">
                                        <TextBlock x:Name="LazarusSuccessText" DockPanel.Dock="Left" Text="✅ Recovery Complete! Files successfully carved and restored." FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SuccessGreenBrush}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                        <Button x:Name="BtnOpenRecoveredFolder" DockPanel.Dock="Right" Content="📂 Open Destination Folder" Style="{StaticResource ActionButton}" Click="OnOpenRecoveredFolder" Height="28" Padding="12,0" Margin="12,0,0,0" ToolTip="Open Windows File Explorer to the recovered files directory"/>
                                    </DockPanel>
                                </Border>

                                <!-- Interactive Carved Signatures Table (ListView) -->
                                <ListView x:Name="CarvedFilesListView" Background="Transparent" BorderThickness="0" MaxHeight="450"
                                          Padding="0" Margin="0"
                                          ItemContainerStyle="{StaticResource LazarusTableRowStyle}"
                                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                                          VirtualizingStackPanel.IsVirtualizing="True"
                                          VirtualizingStackPanel.VirtualizationMode="Recycling"
                                          ScrollViewer.CanContentScroll="True"
                                          Loaded="CarvedFilesListView_Loaded"
                                          SizeChanged="CarvedFilesListView_SizeChanged"
                                          MouseDoubleClick="OnCarvedFilesMouseDoubleClick"
                                          PreviewMouseWheel="OnNestedListPreviewMouseWheel">
                                    <ListView.View>
                                        <GridView ColumnHeaderContainerStyle="{StaticResource DashboardTableHeaderStyle}">
                                            <!-- Checkbox Column -->
                                            <GridViewColumn Header="" Width="32">
                                                <GridViewColumn.HeaderContainerStyle>
                                                    <Style TargetType="GridViewColumnHeader" BasedOn="{StaticResource DashboardTableHeaderStyle}">
                                                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                                        <Setter Property="Padding" Value="2,8"/>
                                                    </Style>
                                                </GridViewColumn.HeaderContainerStyle>
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" Click="OnCarvedItemChecked" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>

                                            <!-- Recovered File & Recovery Method Column -->
                                            <GridViewColumn Header="Recovered File &amp; Method" Width="222">
                                                <GridViewColumn.HeaderContainerStyle>
                                                    <Style TargetType="GridViewColumnHeader" BasedOn="{StaticResource DashboardTableHeaderStyle}">
                                                        <Setter Property="Padding" Value="10,8"/>
                                                    </Style>
                                                </GridViewColumn.HeaderContainerStyle>
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Vertical" VerticalAlignment="Center" Margin="2,0">
                                                            <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                            <DockPanel LastChildFill="True" Margin="0,3,0,0">
                                                                <Border DockPanel.Dock="Left" Background="{DynamicResource BrandDarkCardBrush}" BorderBrush="{Binding RecoveryMethodBadgeBrush}" BorderThickness="1" CornerRadius="4" Padding="5,1" Margin="0,0,6,0" VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding RecoveryMethod}" FontSize="10.5" FontWeight="Bold" Foreground="{Binding RecoveryMethodBadgeBrush}"/>
                                                                </Border>
                                                                <TextBlock Text="{Binding OriginalPathOrOffset}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                            </DockPanel>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>

                                            <!-- File Type & Category Column -->
                                            <GridViewColumn Header="Format Type" Width="206">
                                                <GridViewColumn.HeaderContainerStyle>
                                                    <Style TargetType="GridViewColumnHeader" BasedOn="{StaticResource DashboardTableHeaderStyle}">
                                                        <Setter Property="Padding" Value="10,8"/>
                                                    </Style>
                                                </GridViewColumn.HeaderContainerStyle>
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <DockPanel LastChildFill="True" VerticalAlignment="Center" Margin="2,0">
                                                            <TextBlock DockPanel.Dock="Left" Text="{Binding Icon}" FontSize="15" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                            <StackPanel Orientation="Vertical">
                                                                <DockPanel LastChildFill="True">
                                                                    <Border DockPanel.Dock="Right" Background="{DynamicResource BrandDarkCardBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="3" Padding="4,1" Margin="6,0,0,0" VerticalAlignment="Center">
                                                                        <TextBlock Text="{Binding Extension}" FontSize="10.5" FontWeight="Bold" Foreground="{Binding TypeBadgeBrush}"/>
                                                                    </Border>
                                                                    <TextBlock Text="{Binding FileType}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                                </DockPanel>
                                                                <TextBlock Text="{Binding Category}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                                            </StackPanel>
                                                        </DockPanel>
                                                    </DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>

                                            <!-- Sector Offset Column -->
                                            <GridViewColumn Header="Sector Offset" Width="92">
                                                <GridViewColumn.HeaderContainerStyle>
                                                    <Style TargetType="GridViewColumnHeader" BasedOn="{StaticResource DashboardTableHeaderStyle}">
                                                        <Setter Property="Padding" Value="6,8"/>
                                                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                                    </Style>
                                                </GridViewColumn.HeaderContainerStyle>
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Border Background="{DynamicResource BrandDarkCardBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="4" Padding="6,2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding OffsetFormatted}" FontFamily="Consolas, monospace" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource BrandCyanBrush}"/>
                                                        </Border>
                                                    </DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>

                                            <!-- Estimated Size & Resolution Column -->
                                            <GridViewColumn Header="Size &amp; Specs" Width="84">
                                                <GridViewColumn.HeaderContainerStyle>
                                                    <Style TargetType="GridViewColumnHeader" BasedOn="{StaticResource DashboardTableHeaderStyle}">
                                                        <Setter Property="Padding" Value="6,8"/>
                                                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                                    </Style>
                                                </GridViewColumn.HeaderContainerStyle>
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding SizeFormatted}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                                                            <TextBlock Text="{Binding DimensionsFormatted}" FontSize="11" Foreground="{DynamicResource BrandCyanBrush}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>

                                            <!-- Integrity / Confidence Column -->
                                            <GridViewColumn Header="Integrity / Confidence" Width="136">
                                                <GridViewColumn.HeaderContainerStyle>
                                                    <Style TargetType="GridViewColumnHeader" BasedOn="{StaticResource DashboardTableHeaderStyle}">
                                                        <Setter Property="Padding" Value="6,8"/>
                                                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                                    </Style>
                                                </GridViewColumn.HeaderContainerStyle>
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Border Background="{DynamicResource BrandDarkCardBrush}" BorderBrush="{Binding ConfidenceBadgeBrush}" BorderThickness="1" CornerRadius="12" Padding="8,3" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding ConfidenceIcon}" FontSize="11" Foreground="{Binding ConfidenceBadgeBrush}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                                                <TextBlock Text="{Binding Confidence}" FontSize="11" FontWeight="Bold" Foreground="{Binding ConfidenceBadgeBrush}" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>

                                            <!-- Preview Column -->
                                            <GridViewColumn Header="Preview" Width="88">
                                                <GridViewColumn.HeaderContainerStyle>
                                                    <Style TargetType="GridViewColumnHeader" BasedOn="{StaticResource DashboardTableHeaderStyle}">
                                                        <Setter Property="Padding" Value="8,8"/>
                                                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                                    </Style>
                                                </GridViewColumn.HeaderContainerStyle>
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Button Content="👁 Preview" Click="OnPreviewCarvedItem" Tag="{Binding}" Style="{StaticResource HeaderOutlineButton}" Height="26" MinWidth="66" Padding="6,0" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" ToolTip="Preview in-memory signature" Cursor="Hand" Foreground="{DynamicResource BrandCyanBrush}" BorderBrush="{DynamicResource BrandCyanBrush}"/>
                                                    </DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>
                                        </GridView>
                                    </ListView.View>
                                </ListView>

                                <!-- Empty State for Scanned Drive with No Orphaned Signatures -->
                                <Border x:Name="LazarusEmptyState" Visibility="Collapsed" Background="{DynamicResource BrandDarkCardBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="28,20" Margin="0,8,0,0">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="🔍 NO UNALLOCATED SIGNATURES DETECTED" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Scanned raw sectors showed no orphaned file headers in the sampled range. Try another drive or partition." FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- ═══ SYSTEM RECOVERY CHECKPOINTS & RESTORE ═══ -->
                        <Border Style="{StaticResource GlassPanel}" Margin="0,0,0,20">
                            <StackPanel>
                                <WrapPanel Margin="0,0,0,12" VerticalAlignment="Center">
                                    <TextBlock Text="SYSTEM RECOVERY CHECKPOINTS &amp; RESTORE" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="0,4,16,6" TextWrapping="Wrap"/>
                                    <WrapPanel VerticalAlignment="Center">
                                        <Button Content="🔄 Refresh Checkpoints" Style="{StaticResource HeaderActionButton}" Click="OnRefreshCheckpoints" Margin="0,2,8,4"
                                                ToolTip="Enumerate existing Windows System Restore and Volume Shadow Copy (VSS) checkpoints"/>
                                        <Button Content="➕ Create Checkpoint" Style="{StaticResource HeaderActionButton}" local:Gate.Requires="Core" Click="OnCreateCheckpoint" Background="#00C853" Margin="0,2,0,4"
                                                ToolTip="Create an instant Windows System Restore checkpoint with Volume Shadow Copy snapshot before making system modifications"/>
                                    </WrapPanel>
                                </WrapPanel>
                                <TextBlock x:Name="CheckpointStatus" Text="Create, list, restore, export, and delete Windows system restore checkpoints..." FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                <Border x:Name="CheckpointSummaryBar" Background="{DynamicResource BrandDarkCardBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,12,0,0" Visibility="Collapsed">
                                    <TextBlock x:Name="CheckpointSummaryText" Text="" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource BrandCyanBrush}" TextWrapping="Wrap"/>
                                </Border>
                                <ItemsControl x:Name="CheckpointList" Margin="0,12,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- ═══ VSS SHADOW COPY FILE BROWSER & SINGLE-FILE RESTORE ═══ -->
                        <Border Style="{StaticResource GlassPanel}" Margin="0,0,0,20">
                            <StackPanel>
                                <WrapPanel Margin="0,0,0,10" VerticalAlignment="Center">
                                    <WrapPanel VerticalAlignment="Center" Margin="0,2,16,4">
                                        <TextBlock Text="🕰️ VSS SHADOW COPY FILE BROWSER &amp; SINGLE-FILE RESTORE" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="0,2,8,2" TextWrapping="Wrap"/>
                                        <Border Background="{DynamicResource BrandDarkCardBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="4" Padding="6,1" Margin="0,2,0,2" VerticalAlignment="Center">
                                            <TextBlock Text="NO REBOOT REQUIRED" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SuccessGreenBrush}"/>
                                        </Border>
                                    </WrapPanel>
                                    <WrapPanel VerticalAlignment="Center">
                                        <Button x:Name="BtnLoadVssSnapshots" Content="🔄 Load VSS Snapshots" Style="{StaticResource HeaderOutlineButton}" Click="OnLoadVssSnapshots" Margin="0,2,8,4"
                                                ToolTip="Enumerate Volume Shadow Copy snapshots (\\?\GLOBALROOT\Device\HarddiskVolumeShadowCopyN)"/>
                                        <Button x:Name="BtnVssBrowseFolder" Content="📂 Browse Snapshot" Style="{StaticResource HeaderActionButton}" Click="OnBrowseVssSnapshot" Margin="0,2,0,4"
                                                ToolTip="Browse files and directories inside the selected VSS snapshot and compare with live disk"/>
                                    </WrapPanel>
                                </WrapPanel>

                                <TextBlock x:Name="VssBrowserStatus" Text="Browse Volume Shadow Copy snapshots and restore individual deleted or modified files directly without rolling back the entire OS." FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,10"/>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*" MinWidth="130" MaxWidth="280"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="1.2*" MinWidth="110"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Snapshot:" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <ComboBox Grid.Column="1" x:Name="ComboVssSnapshots" Style="{StaticResource DarkComboBoxStyle}" Height="30" SelectionChanged="OnVssSnapshotSelectionChanged" Margin="0,0,12,0"/>
                                    <TextBlock Grid.Column="2" Text="Subpath:" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBox Grid.Column="3" x:Name="VssRelativePathBox" Text="Users" Height="30" Background="{DynamicResource BrandDarkCardBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" Padding="8,4" VerticalContentAlignment="Center" Margin="0,0,8,0"
                                             ToolTip="Relative path inside the shadow copy volume (e.g. Users\Public\Documents)"/>
                                    <Button Grid.Column="4" x:Name="BtnVssUpFolder" Content="⬆ Up" Style="{StaticResource HeaderOutlineButton}" Height="30" Padding="12,0" Click="OnVssUpDirectory" ToolTip="Navigate to parent folder in VSS snapshot"/>
                                </Grid>

                                <Border x:Name="VssSummaryBar" Background="{DynamicResource BrandDarkCardBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,4,0,8" Visibility="Collapsed">
                                    <TextBlock x:Name="VssSummaryText" Text="" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource BrandCyanBrush}" TextWrapping="Wrap"/>
                                </Border>

                                <ItemsControl x:Name="VssFileList" Margin="0,4,0,0" PreviewMouseWheel="OnNestedListPreviewMouseWheel"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource GlassPanel}">
                            <StackPanel>
                                <TextBlock Text="MTP DEVICES (Mobile)" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                                <TextBlock x:Name="MtpStatus" Text="Scanning for connected mobile devices..." FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                <ItemsControl x:Name="MtpList" Margin="0,12,0,0"/>
                                <Button Content="📱 Scan MTP Devices" Style="{StaticResource ActionButton}" Margin="0,16,0,0" Click="OnScanMtp" HorizontalAlignment="Left"
                                        ToolTip="Scan connected mobile phones, cameras, and portable devices via Media Transfer Protocol (MTP)"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ──── Registry Page ──── -->
                <ScrollViewer x:Name="PageRegistry" VerticalScrollBarVisibility="Auto" Padding="24" Visibility="Collapsed">
                    <StackPanel x:Name="RegistryContent" Opacity="0">
                        <StackPanel.RenderTransform>
                            <TranslateTransform X="0" Y="0"/>
                        </StackPanel.RenderTransform>
                        <Border Style="{StaticResource GlassPanel}" Margin="0,0,0,20">
                            <StackPanel>
                                <TextBlock Text="REGISTRY HEALTH SCAN" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                                <TextBlock x:Name="RegistryStatus" Text="Full registry integrity analysis..." FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                                <WrapPanel Margin="0,0,0,4">
                                    <Button Content="🔧 Scan Registry" Style="{StaticResource ActionButton}" Click="OnRegistryScan" Margin="0,0,8,8" ToolTip="Perform a deep scan of Windows registry hives for invalid references, orphaned keys, and broken paths"/>
                                    <Button x:Name="BtnFixRegistrySelected" Content="🔧 Fix Selected" Style="{StaticResource ActionButton}" local:Gate.Requires="Core" Click="OnFixRegistrySelected"
                                            Visibility="Collapsed" Background="#00E5FF" Foreground="#0B0F19" Margin="0,0,8,8" ToolTip="Repair or remove checked registry issues"/>
                                    <Button x:Name="BtnFixRegistrySafe" Content="✅ Fix Safe Issues" Style="{StaticResource ActionButton}" local:Gate.Requires="Core" Click="OnFixRegistrySafe"
                                            Visibility="Collapsed" Background="#43A047" Margin="0,0,8,8" ToolTip="Automatically repair only low-risk registry entries guaranteed not to affect stability"/>
                                    <Button x:Name="BtnFixRegistryAll" Content="🔧 Fix All" Style="{StaticResource ActionButton}" local:Gate.Requires="Core" Click="OnFixRegistryAll"
                                            Visibility="Collapsed" Background="#E53935" Margin="0,0,8,8" ToolTip="Repair all detected registry issues after generating an automatic registry backup"/>
                                </WrapPanel>
                                <!-- Summary counts bar -->
                                <Border x:Name="RegSummaryBar" Background="{DynamicResource BrandDarkCardBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,12,0,0" Visibility="Collapsed">
                                    <TextBlock x:Name="RegSummaryText" Text="" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Collapsible sub-sections with count badges -->
                        <Border Style="{StaticResource GlassPanel}" Margin="0,0,0,20">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,8" LastChildFill="False">
                                    <TextBlock x:Name="OrphanHeader" Text="ORPHANED SOFTWARE KEYS (0)" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource WarningAmberBrush}" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                                    <Button x:Name="BtnToggleOrphans" DockPanel.Dock="Right" HorizontalAlignment="Right" Content="▼ Show" Click="OnToggleOrphans"
                                            Background="Transparent" Foreground="{DynamicResource BrandCyanBrush}" BorderThickness="0" FontSize="11" Cursor="Hand"
                                            ToolTip="Toggle display of orphaned software installation keys under HKLM/HKCU"/>
                                </DockPanel>
                                <ItemsControl x:Name="OrphanList" Visibility="Collapsed"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource GlassPanel}" Margin="0,0,0,20">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,8" LastChildFill="False">
                                    <TextBlock x:Name="BrokenAssocHeader" Text="BROKEN FILE ASSOCIATIONS (0)" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource WarningAmberBrush}" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                                    <Button x:Name="BtnToggleBrokenAssoc" DockPanel.Dock="Right" HorizontalAlignment="Right" Content="▼ Show" Click="OnToggleBrokenAssoc"
                                            Background="Transparent" Foreground="{DynamicResource BrandCyanBrush}" BorderThickness="0" FontSize="11" Cursor="Hand"
                                            ToolTip="Toggle display of file extension associations pointing to missing or deleted executable handlers"/>
                                </DockPanel>
                                <ItemsControl x:Name="BrokenAssocList" Visibility="Collapsed"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource GlassPanel}" Margin="0,0,0,20">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,8" LastChildFill="False">
                                    <TextBlock x:Name="InvalidPathHeader" Text="INVALID PATHS (0)" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource DangerRedBrush}" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                                    <Button x:Name="BtnToggleInvalidPaths" DockPanel.Dock="Right" HorizontalAlignment="Right" Content="▼ Show" Click="OnToggleInvalidPaths"
                                            Background="Transparent" Foreground="{DynamicResource BrandCyanBrush}" BorderThickness="0" FontSize="11" Cursor="Hand"
                                            ToolTip="Toggle display of registry path entries referencing non-existent file or folder targets"/>
                                </DockPanel>
                                <ItemsControl x:Name="InvalidPathList" Visibility="Collapsed"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource GlassPanel}" Margin="0,0,0,20">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,8" LastChildFill="False">
                                    <TextBlock x:Name="ObsoleteRunHeader" Text="OBSOLETE STARTUP ENTRIES (0)" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource DangerRedBrush}" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                                    <Button x:Name="BtnToggleObsoleteRun" DockPanel.Dock="Right" HorizontalAlignment="Right" Content="▼ Show" Click="OnToggleObsoleteRun"
                                            Background="Transparent" Foreground="{DynamicResource BrandCyanBrush}" BorderThickness="0" FontSize="11" Cursor="Hand"
                                            ToolTip="Toggle display of startup Run keys referencing missing executables"/>
                                </DockPanel>
                                <ItemsControl x:Name="ObsoleteRunList" Visibility="Collapsed"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource GlassPanel}" Margin="0,0,0,20">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,8" LastChildFill="False">
                                    <TextBlock x:Name="ComActiveXHeader" Text="COM / ACTIVEX ORPHANS (0)" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource WarningAmberBrush}" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                                    <Button x:Name="BtnToggleComActiveX" DockPanel.Dock="Right" HorizontalAlignment="Right" Content="▼ Show" Click="OnToggleComActiveX"
                                            Background="Transparent" Foreground="{DynamicResource BrandCyanBrush}" BorderThickness="0" FontSize="11" Cursor="Hand"
                                            ToolTip="Toggle display of orphaned COM and ActiveX Class ID (CLSID) registrations with missing servers"/>
                                </DockPanel>
                                <ItemsControl x:Name="ComActiveXList" Visibility="Collapsed"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource GlassPanel}" Margin="0,0,0,20">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,8" LastChildFill="False">
                                    <TextBlock x:Name="SharedDllHeader" Text="MISSING SHARED DLLS (0)" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource WarningAmberBrush}" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                                    <Button x:Name="BtnToggleSharedDlls" DockPanel.Dock="Right" HorizontalAlignment="Right" Content="▼ Show" Click="OnToggleSharedDlls"
                                            Background="Transparent" Foreground="{DynamicResource BrandCyanBrush}" BorderThickness="0" FontSize="11" Cursor="Hand"
                                            ToolTip="Toggle display of shared DLL registry references to nonexistent binaries"/>
                                </DockPanel>
                                <ItemsControl x:Name="SharedDllList" Visibility="Collapsed"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource GlassPanel}" Margin="0,0,0,20">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,8" LastChildFill="False">
                                    <TextBlock x:Name="TypeLibHeader" Text="TYPE LIBRARY ORPHANS (0)" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource WarningAmberBrush}" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                                    <Button x:Name="BtnToggleTypeLib" DockPanel.Dock="Right" HorizontalAlignment="Right" Content="▼ Show" Click="OnToggleTypeLib"
                                            Background="Transparent" Foreground="{DynamicResource BrandCyanBrush}" BorderThickness="0" FontSize="11" Cursor="Hand"
                                            ToolTip="Toggle display of orphaned COM Type Library entries with invalid file paths"/>
                                </DockPanel>
                                <ItemsControl x:Name="TypeLibList" Visibility="Collapsed"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource GlassPanel}" Margin="0,0,0,20">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,8" LastChildFill="False">
                                    <TextBlock x:Name="MuiCacheHeader" Text="MUI CACHE ORPHANS (0)" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource WarningAmberBrush}" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                                    <Button x:Name="BtnToggleMuiCache" DockPanel.Dock="Right" HorizontalAlignment="Right" Content="▼ Show" Click="OnToggleMuiCache"
                                            Background="Transparent" Foreground="{DynamicResource BrandCyanBrush}" BorderThickness="0" FontSize="11" Cursor="Hand"
                                            ToolTip="Toggle display of stale MUI application cache records for deleted executables"/>
                                </DockPanel>
                                <ItemsControl x:Name="MuiCacheList" Visibility="Collapsed"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource GlassPanel}" Margin="0,0,0,20">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,8" LastChildFill="False">
                                    <TextBlock x:Name="HkcuOrphanHeader" Text="USER SOFTWARE ORPHANS (0)" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource WarningAmberBrush}" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                                    <Button x:Name="BtnToggleHkcuOrphans" DockPanel.Dock="Right" HorizontalAlignment="Right" Content="▼ Show" Click="OnToggleHkcuOrphans"
                                            Background="Transparent" Foreground="{DynamicResource BrandCyanBrush}" BorderThickness="0" FontSize="11" Cursor="Hand"
                                            ToolTip="Toggle display of user-specific registry software keys with no installed binary"/>
                                </DockPanel>
                                <ItemsControl x:Name="HkcuOrphanList" Visibility="Collapsed"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource GlassPanel}">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,8" LastChildFill="False">
                                    <TextBlock x:Name="InstallerOrphanHeader" Text="INSTALLER REFERENCES (0)" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource WarningAmberBrush}" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                                    <Button x:Name="BtnToggleInstallerOrphans" DockPanel.Dock="Right" HorizontalAlignment="Right" Content="▼ Show" Click="OnToggleInstallerOrphans"
                                            Background="Transparent" Foreground="{DynamicResource BrandCyanBrush}" BorderThickness="0" FontSize="11" Cursor="Hand"
                                            ToolTip="Toggle display of stale Windows Installer upgrade and product registration keys"/>
                                </DockPanel>
                                <ItemsControl x:Name="InstallerOrphanList" Visibility="Collapsed"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ──── Resource Monitor Page ──── -->
                <ScrollViewer x:Name="PageMonitor" VerticalScrollBarVisibility="Auto" Padding="24" Visibility="Collapsed">
                    <StackPanel x:Name="MonitorContent" Opacity="1">
                        <StackPanel.RenderTransform>
                            <TranslateTransform X="0" Y="0"/>
                        </StackPanel.RenderTransform>

                        <!-- Header / Controls -->
                        <Border Style="{StaticResource GlassPanel}" Margin="0,0,0,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="LIVE RESOURCE MONITOR" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock x:Name="MonitorStatus" Text="⏸ Stopped" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button x:Name="BtnStartMonitor" Content="▶ Start" Style="{StaticResource HeaderActionButton}" Click="OnStartMonitor" Margin="0,0,8,0" Background="#00C853"
                                            ToolTip="Start real-time telemetry sampling of CPU, RAM, disk I/O, network throughput, and top processes"/>
                                    <Button x:Name="BtnStopMonitor" Content="⏹ Stop" Style="{StaticResource HeaderActionButton}" Click="OnStopMonitor" Visibility="Collapsed" Background="#E53935"
                                            ToolTip="Halt real-time performance counter sampling"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- CPU + RAM Row -->
                        <UniformGrid Columns="2" Margin="0,0,0,16">

                            <!-- CPU -->
                            <Border Style="{StaticResource GlassPanel}" Margin="0,0,8,0">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,10">
                                        <TextBlock Text="CPU USAGE" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="CpuUsageText" Text="—" FontSize="28" FontWeight="ExtraBold"
                                                   Foreground="{DynamicResource BrandCyanBrush}" DockPanel.Dock="Right" HorizontalAlignment="Right"/>
                                    </DockPanel>
                                    <ProgressBar x:Name="CpuUsageBar" Minimum="0" Maximum="100" Value="0"
                                                 Height="10"
                                                 Foreground="{DynamicResource BrandCyanBrush}" Background="{DynamicResource BorderSubtleBrush}"
                                                 Margin="0,0,0,10"/>
                                    <TextBlock x:Name="CpuCoresText" Text="— cores" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <TextBlock x:Name="CpuNameText" Text="—" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- RAM -->
                            <Border Style="{StaticResource GlassPanel}" Margin="8,0,0,0">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,10">
                                        <TextBlock Text="RAM USAGE" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="RamPctText" Text="—" FontSize="28" FontWeight="ExtraBold"
                                                   Foreground="{StaticResource BrandPurpleBrush}" DockPanel.Dock="Right" HorizontalAlignment="Right"/>
                                    </DockPanel>
                                    <ProgressBar x:Name="RamUsageBar" Minimum="0" Maximum="100" Value="0"
                                                 Height="10"
                                                 Foreground="{StaticResource BrandPurpleBrush}" Background="{DynamicResource BorderSubtleBrush}"
                                                 Margin="0,0,0,10"/>
                                    <TextBlock x:Name="RamUsageText" Text="— / — GB" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
