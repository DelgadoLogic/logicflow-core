                                    <TextBlock x:Name="OneClickSummaryText" Text="" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SuccessGreenBrush}" TextWrapping="Wrap"/>
                                </Border>
                                <ItemsControl x:Name="OneClickList" Margin="0,8,0,0" PreviewMouseWheel="OnNestedListPreviewMouseWheel"/>
                            </StackPanel>
                        </Border>

                        <!-- Junk File Cleaner -->
                        <Border Style="{StaticResource GlassPanel}" Margin="0,0,0,20">
                            <StackPanel>
                                <WrapPanel Margin="0,0,0,12" VerticalAlignment="Center">
                                    <TextBlock Text="🧹 JUNK FILE CLEANER" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="0,4,16,6"/>
                                    <WrapPanel VerticalAlignment="Center">
                                        <Button Content="🔍 Scan" Style="{StaticResource HeaderActionButton}" Click="OnJunkScan" Margin="0,2,8,4" ToolTip="Scan for temporary directories, browser caches, error logs, and dump files"/>
