                                <WrapPanel Margin="0,0,0,12">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,20,8" VerticalAlignment="Center">
                                        <TextBlock Text="Theme:" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
