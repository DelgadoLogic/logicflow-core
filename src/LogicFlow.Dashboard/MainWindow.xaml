                                        <Button x:Name="BtnWinGetSelectAll" Content="☑ All" Style="{StaticResource HeaderOutlineButton}" Click="OnWinGetSelectAll"
                                                Visibility="Collapsed" Margin="0,2,6,4" Height="32" Padding="10,0" ToolTip="Select all applications with available updates"/>
                                        <Button x:Name="BtnWinGetDeselectAll" Content="☐ None" Style="{StaticResource HeaderOutlineButton}" Click="OnWinGetDeselectAll"
                                                Visibility="Collapsed" Margin="0,2,8,4" Height="32" Padding="10,0" ToolTip="Clear application selection"/>
                                        <Button x:Name="BtnWinGetUpgradeSelected" Content="⚡ Update Selected" Style="{StaticResource HeaderActionButton}" local:Gate.Requires="Core" Click="OnWinGetUpgradeSelected"
                                                Visibility="Collapsed" Background="#00C853" Margin="0,2,8,4" ToolTip="Download and install updates for all selected applications via WinGet"/>
                                        <Button x:Name="BtnWinGetUpgradeAll" Content="⚡ Update All Apps" Style="{StaticResource HeaderActionButton}" local:Gate.Requires="Core" Click="OnWinGetUpgradeAll" Visibility="Collapsed" Background="#2E7D32" Margin="0,2,0,4" ToolTip="Upgrade all outdated applications across the system"/>
                                    </WrapPanel>
