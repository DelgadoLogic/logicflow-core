                                    <Button Grid.Column="1" Content="▶ Run Full Maintenance" Style="{StaticResource ActionButton}" local:Gate.Requires="Core" Click="OnOneClickOptimize" Background="#00C853" FontWeight="Bold" VerticalAlignment="Center"
                                            ToolTip="Execute selected maintenance routines sequentially: clean junk, validate registry, streamline startup, and apply safe OS tweaks"/>
                                </Grid>
                                <TextBlock x:Name="OneClickStatus" Text="Clean junk ─ fix registry ─ optimize startup ─ apply tweaks — all in one click" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                <WrapPanel Margin="0,8,0,0">
                                    <CheckBox x:Name="ChkOneClickJunk" Content="🧹 Clean Junk Files" IsChecked="True" Margin="0,0,16,6"
