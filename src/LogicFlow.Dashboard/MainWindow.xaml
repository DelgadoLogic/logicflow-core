                                <CheckBox x:Name="SettingEnableAnimations" Content="Enable UI animations and breathing shield effects (auto-paused over Remote Desktop)" Style="{StaticResource ToggleSwitchStyle}" Checked="OnSettingToggled" Unchecked="OnSettingToggled"
                                          ToolTip="Disable continuous glow animations to eliminate idle GPU rendering and reduce motion"/>
                            </StackPanel>
                        </Border>

                        <!-- 1. System Behavior Card -->
                        <Border x:Name="SettingsCardGeneral" Style="{StaticResource GlassPanel}" Margin="0,0,0,20">
                            <StackPanel>
                                <TextBlock Text="SYSTEM BEHAVIOR &amp; SHORTCUTS" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,16"/>
                                <CheckBox x:Name="SettingStartWithWindows" Content="Start LogicFlow with Windows" Style="{StaticResource ToggleSwitchStyle}" Checked="OnSettingToggled" Unchecked="OnSettingToggled"
                                          ToolTip="Launch LogicFlow minimized in the system tray when Windows boots"/>
