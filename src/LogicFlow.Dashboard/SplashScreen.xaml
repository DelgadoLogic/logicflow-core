<Window x:Class="LogicFlow.Dashboard.SplashWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="LogicFlow" Width="520" Height="340"
    WindowStyle="None" ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
    AllowsTransparency="True" Background="Transparent" Topmost="True"
    ShowInTaskbar="True" Icon="pack://application:,,,/LogicFlow;component/Assets/Brand/shield_256.png">

    <Border CornerRadius="18" BorderThickness="1" BorderBrush="#1F2A3D" Margin="14">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#0A0E1A" Offset="0"/>
                <GradientStop Color="#101726" Offset="0.5"/>
                <GradientStop Color="#080C14" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="0" Color="#7C4DFF" Opacity="0.35"/>
        </Border.Effect>

        <Grid>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <Image Source="pack://application:,,,/LogicFlow;component/Assets/Brand/shield_256.png"
                       Width="96" Height="96" Margin="0,0,0,8" RenderOptions.BitmapScalingMode="HighQuality"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,2">
                    <TextBlock Text="LogicFlow" FontSize="28" FontWeight="Bold" Foreground="#F1F5F9" VerticalAlignment="Center"/>
                    <Border x:Name="TierBadge" Background="#141A29" BorderBrush="#1F2A3D" BorderThickness="1"
                            CornerRadius="6" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="TierBadgeText" Text="FREE" FontSize="11" FontWeight="Bold" Foreground="#94A3B8"/>
                    </Border>
                </StackPanel>
                <TextBlock Text="Windows cleanup, security, and storage tools" FontSize="12"
                           Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,2,0,18"/>

                <ProgressBar x:Name="InitProgress" Width="320" Height="4" Minimum="0" Maximum="100" Value="0"
                             Background="#141A29" BorderThickness="0" Foreground="#00E5FF" Margin="0,0,0,10"/>

                <TextBlock x:Name="StatusLabel" Text="Starting…" FontSize="11" Foreground="#7DD3FC" HorizontalAlignment="Center"/>
                <TextBlock x:Name="VersionLabel" FontSize="11" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,5,0,0"/>
            </StackPanel>

            <TextBlock Text="Delgado Creative Enterprises LLC d/b/a DelgadoLogic" FontSize="11" Foreground="#64748B"
                       HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,14"/>
        </Grid>
    </Border>
</Window>
