<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <RootNamespace>LogicFlow.Dashboard</RootNamespace>
    <AssemblyName>LogicFlow</AssemblyName>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\..\Assets\Icons\LogicFlow.ico</ApplicationIcon>
    <Description>LogicFlow - Windows cleanup, security, driver and storage tools</Description>
    <Company>Delgado Creative Enterprises LLC d/b/a DelgadoLogic</Company>
    <Product>LogicFlow</Product>
    <Version>1.0.0</Version>
    <FileVersion>1.0.0.0</FileVersion>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <Copyright>Copyright (c) 2026 Delgado Creative Enterprises LLC d/b/a DelgadoLogic. All rights reserved.</Copyright>
    <Trademark>LogicFlow is a product of Delgado Creative Enterprises LLC d/b/a DelgadoLogic</Trademark>
    <NeutralLanguage>en-US</NeutralLanguage>
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\OmniCore.Engine\OmniCore.Engine.csproj" />
    <ProjectReference Include="..\LogicFlow.Scraper\LogicFlow.Scraper.csproj" />
    <ProjectReference Include="..\LogicFlow.Sentinel\LogicFlow.Sentinel.csproj" />
    <ProjectReference Include="..\LogicFlow.Guardian\LogicFlow.Guardian.csproj" />
    <ProjectReference Include="..\LogicFlow.Lazarus\LogicFlow.Lazarus.csproj" />
    <ProjectReference Include="..\LogicFlow.Registry\LogicFlow.Registry.csproj" />
    <ProjectReference Include="..\OmniLicense\OmniLicense.csproj" />
    <ProjectReference Include="..\OmniLicense.Commerce\OmniLicense.Commerce.csproj" />
    <ProjectReference Include="..\LogicFlow.Native\LogicFlow.Native.csproj" />
    <ProjectReference Include="..\OmniPulse\OmniPulse.csproj" />
    <ProjectReference Include="..\LogicFlow.VoiceAgent\LogicFlow.VoiceAgent.csproj" />
    <!-- DelgadoLogic Shared Runtime — licensing, identity, telemetry, sovereign updates -->
    <ProjectReference Include="..\DelgadoLogic.Core\DelgadoLogic.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets\AppIcon.jpg" />
    <Resource Include="Assets\Banner_Header.jpg" />
    <Resource Include="Assets\Favicon.jpg" />
    <Resource Include="Assets\*.png" />
    <Resource Include="Assets\Icons\*.ico" />
    <Resource Include="Assets\Icons\*.png" />
    <Resource Include="Assets\Brand\*.png" />
    <!-- EULA shipped with this build; its SHA-256 is recorded with the user's acceptance -->
    <EmbeddedResource Include="..\..\Docs\EULA.txt" LogicalName="EULA.txt" />
    <None Update="Assets\Icons\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <Content Include="..\..\Docs\legal\*.md" Link="Docs\legal\%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets\Fonts\Outfit\Outfit[wght].ttf" />
    <Resource Include="Assets\Fonts\Inter\Inter_18pt-Regular.ttf" />
    <Resource Include="Assets\Fonts\Inter\Inter_18pt-Bold.ttf" />
    <Resource Include="Assets\Fonts\Inter\Inter_18pt-SemiBold.ttf" />
    <Resource Include="Assets\Fonts\Inter\Inter_18pt-Medium.ttf" />
    <Resource Include="Assets\Fonts\Inter\Inter_18pt-Light.ttf" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="WPF-UI" Version="4.3.0" />
  </ItemGroup>
</Project>
