<Project Sdk="Microsoft.NET.Sdk.Worker">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>OmniService</RootNamespace>
    <AssemblyName>LogicFlowAgent</AssemblyName>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Description>LogicFlow Background Agent — Windows service for automated health monitoring</Description>
    <ApplicationIcon>..\LogicFlow.Dashboard\Assets\Icons\LogicFlow.ico</ApplicationIcon>
    <Company>Delgado Creative Enterprises LLC d/b/a DelgadoLogic</Company>
    <Product>LogicFlow</Product>
    <Version>1.0.0</Version>
    <Copyright>Copyright (c) 2026 Delgado Creative Enterprises LLC d/b/a DelgadoLogic. All rights reserved.</Copyright>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.15" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.15" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\OmniCore.Engine\OmniCore.Engine.csproj" />
    <ProjectReference Include="..\OmniPulse\OmniPulse.csproj" />
    <ProjectReference Include="..\LogicFlow.Sentinel\LogicFlow.Sentinel.csproj" />
    <ProjectReference Include="..\LogicFlow.Guardian\LogicFlow.Guardian.csproj" />
    <ProjectReference Include="..\LogicFlow.Registry\LogicFlow.Registry.csproj" />
    <ProjectReference Include="..\LogicFlow.Native\LogicFlow.Native.csproj" />
  </ItemGroup>
</Project>
