<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>OmniPulse</RootNamespace>
    <Company>Delgado Creative Enterprises LLC d/b/a DelgadoLogic</Company>
    <Product>LogicFlow</Product>
    <Version>1.0.0</Version>
    <Copyright>Copyright (c) 2026 Delgado Creative Enterprises LLC d/b/a DelgadoLogic. All rights reserved.</Copyright>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="LogicFlow.Tests" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="11.*" />
    <PackageReference Include="System.Diagnostics.EventLog" Version="11.*" />
    <PackageReference Include="System.Management" Version="11.*" />
  </ItemGroup>
  <ItemGroup Condition="'$(LogicFlowIngestKey)' != ''">
    <!-- Public per-build ingest key used to sign telemetry bodies (HMAC-SHA256). Pass /p:LogicFlowIngestKey=... in release builds. -->
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>LogicFlowIngestKey</_Parameter1>
      <_Parameter2>$(LogicFlowIngestKey)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>
</Project>
